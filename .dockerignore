# Build context hygiene for production API/web images.
# Keeps cached bytecode, virtualenvs, coverage and build artifacts out of the
# image layer so removed legacy modules cannot survive as stale .pyc.
**/__pycache__/
**/*.py[cod]
**/*.pyi
apps/api/.venv/
apps/web/node_modules/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/coverage/
**/dist/
**/.next/
**/build/
**/*.egg-info/
.git/

# Credentials and persistent data are supplied at runtime, never in build layers.
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/node_modules/
**/.venv/
**/*.tsbuildinfo
.agents/
.claude/
.artifacts/
.worktree/
config/
data/
docs/
docs-site/
!docs-site/
docs-site/*
!docs-site/public/
docs-site/public/*
!docs-site/public/home/
docs-site/public/home/*
!docs-site/public/home/sam-tools/
docs-site/public/home/sam-tools/*
!docs-site/public/home/sam-tools/smart-point.webm
output/
outputs/
**/test-results/
**/playwright-report/
apps/*-backend/
apps/audit-summary/
apps/api/experiments/
