{
  "name": "ai-annotation-platform",
  "private": true,
  "scripts": {
    "prepare": "bash scripts/install-git-hooks.sh",
    "dev:worktree": "node scripts/dev-worktree.mjs",
    "dev:web": "pnpm --filter @anno/web dev",
    "build:web": "pnpm --filter @anno/web build",
    "dev:api": "cd apps/api && uv run alembic upgrade head && MIGRATION_DATABASE_URL= uv run uvicorn app.main:app --reload --port 8000 --timeout-graceful-shutdown 3",
    "lint": "pnpm lint:python && pnpm lint:web",
    "lint:python": "uvx --from ruff==0.15.22 ruff check .",
    "lint:python:fix": "uvx --from ruff==0.15.22 ruff check --fix .",
    "lint:web": "pnpm --filter @anno/web lint",
    "format": "pnpm format:python && pnpm format:prettier",
    "format:check": "pnpm format:python:check && pnpm format:prettier:check",
    "format:python": "uvx --from ruff==0.15.22 ruff format .",
    "format:python:check": "uvx --from ruff==0.15.22 ruff format --check .",
    "format:prettier": "prettier --write . --ignore-unknown",
    "format:prettier:check": "prettier --check . --ignore-unknown",
    "typecheck": "pnpm --filter @anno/web typecheck",
    "test": "pnpm --filter @anno/web test",
    "test:e2e": "pnpm --filter @anno/web test:e2e",
    "codegen": "pnpm --filter @anno/web codegen",
    "openapi:export": "cd apps/api && uv run python ../../scripts/export_openapi.py",
    "openapi:check": "cd apps/api && uv run python ../../scripts/export_openapi.py --check",
    "docs:dev": "pnpm --filter @anno/docs-site dev",
    "docs:build": "pnpm --filter @anno/docs-site build",
    "docs:preview": "pnpm --filter @anno/docs-site preview",
    "docs:hotkeys": "pnpm --filter @anno/docs-site hotkeys",
    "docs:settings": "pnpm --filter @anno/docs-site settings",
    "docs:gen": "pnpm --filter @anno/docs-site gen",
    "docs:gen-env-vars": "node docs-site/scripts/generate-env-vars.mjs",
    "docs:media:audit": "pnpm --filter @anno/docs-site media:audit",
    "docs:media:approve": "pnpm --filter @anno/docs-site media:approve",
    "docs:media:derive": "pnpm --filter @anno/web screenshots:docs-media",
    "docs:impact": "node scripts/check-doc-impact.mjs"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "shadcn": "^4.11.0"
  }
}
