{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": [
        "arn:aws:s3:::prod-annotations",
        "arn:aws:s3:::prod-datasets",
        "arn:aws:s3:::prod-bug-reports",
        "arn:aws:s3:::prod-media-cache",
        "arn:aws:s3:::prod-audit-archive",
        "arn:aws:s3:::prod-import",
        "arn:aws:s3:::prod-export",
        "arn:aws:s3:::prod-avatars",
        "arn:aws:s3:::prod-training",
        "arn:aws:s3:::prod-accepted-inputs"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketVersioning", "s3:ListBucketVersions"],
      "Resource": ["arn:aws:s3:::prod-accepted-inputs"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetLifecycleConfiguration", "s3:PutLifecycleConfiguration"],
      "Resource": [
        "arn:aws:s3:::prod-annotations",
        "arn:aws:s3:::prod-bug-reports",
        "arn:aws:s3:::prod-media-cache",
        "arn:aws:s3:::prod-import",
        "arn:aws:s3:::prod-export"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::prod-annotations/*",
        "arn:aws:s3:::prod-datasets/*",
        "arn:aws:s3:::prod-bug-reports/*",
        "arn:aws:s3:::prod-media-cache/*",
        "arn:aws:s3:::prod-audit-archive/*",
        "arn:aws:s3:::prod-import/*",
        "arn:aws:s3:::prod-export/*",
        "arn:aws:s3:::prod-avatars/*",
        "arn:aws:s3:::prod-training/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObjectVersion", "s3:DeleteObjectVersion"],
      "Resource": ["arn:aws:s3:::prod-accepted-inputs/*"],
      "Condition": {
        "StringLike": { "s3:versionid": "*?*" },
        "StringNotEquals": { "s3:versionid": "null" }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": ["arn:aws:s3:::prod-accepted-inputs/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::prod-accepted-inputs/*"],
      "Condition": {
        "StringLike": { "s3:versionid": "*?*" },
        "StringNotEquals": { "s3:versionid": "null" }
      }
    }
  ]
}
