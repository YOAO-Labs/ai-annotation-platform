FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
WORKDIR /src/apps/api
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg libvips-tools icc-profiles-free \
  && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.11.29
COPY apps/_shared/owner_data /src/apps/_shared/owner_data
COPY apps/_shared/identity_admission /src/apps/_shared/identity_admission
COPY packages/python-sdk /src/packages/python-sdk
COPY apps/_shared/workspace_contract /src/apps/_shared/workspace_contract
COPY apps/_shared/audit_contract /src/apps/_shared/audit_contract
COPY apps/audit /src/apps/audit
COPY apps/jobs /src/apps/jobs
COPY apps/_shared/mail_transport /src/apps/_shared/mail_transport
COPY apps/notifications /src/apps/notifications
COPY apps/identity /src/apps/identity
COPY apps/inference /src/apps/inference
COPY apps/workspace /src/apps/workspace
COPY apps/media-probe /src/apps/media-probe
COPY apps/assets-catalog /src/apps/assets-catalog
COPY apps/assets-media /src/apps/assets-media
COPY apps/assets-mask-content /src/apps/assets-mask-content
COPY apps/labeling-mask-gc /src/apps/labeling-mask-gc
COPY apps/labeling /src/apps/labeling
COPY apps/preannotation-results /src/apps/preannotation-results
COPY apps/assets-cleanup /src/apps/assets-cleanup
COPY apps/assets-source /src/apps/assets-source
COPY apps/_shared/filesystem_read /src/apps/_shared/filesystem_read
COPY apps/_shared/site_agent_contract /src/apps/_shared/site_agent_contract
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv venv /opt/venv \
  && uv export --frozen --no-dev --no-emit-project \
       --no-emit-package yoao-sdk --no-emit-package yoao-owner-data --no-emit-package yoao-identity-admission --no-emit-package yoao-labeling --no-emit-package yoao-identity --no-emit-package yoao-inference --no-emit-package yoao-workspace --no-emit-package yoao-mail-transport --no-emit-package yoao-notifications --no-emit-package yoao-jobs --no-emit-package yoao-workspace-contract --no-emit-package yoao-audit-contract --no-emit-package yoao-audit --no-emit-package yoao-media-probe --no-emit-package yoao-assets-cleanup --no-emit-package yoao-assets-source --no-emit-package yoao-assets-catalog --no-emit-package yoao-assets-media --no-emit-package yoao-assets-mask-content --no-emit-package yoao-labeling-mask-gc --no-emit-package yoao-preannotation-results \
       --no-emit-package yoao-filesystem-read --no-emit-package yoao-site-agent-contract --output-file /tmp/requirements.txt \
  && uv pip install --python /opt/venv/bin/python --require-hashes \
       -r /tmp/requirements.txt \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/packages/python-sdk \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/_shared/owner_data \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/_shared/identity_admission \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/_shared/workspace_contract \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/_shared/audit_contract \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/audit \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/jobs \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/_shared/mail_transport \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/notifications \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/identity \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/inference \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/workspace \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/media-probe \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/assets-catalog \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/assets-media \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/assets-mask-content \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/labeling-mask-gc \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/labeling \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/preannotation-results \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/assets-cleanup \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/assets-source \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/_shared/filesystem_read \
  && uv pip install --python /opt/venv/bin/python --no-deps /src/apps/_shared/site_agent_contract \
  && rm -rf /tmp/requirements.txt /src
WORKDIR /app
COPY apps/api/ .
COPY scripts/fixture_suite_coordinator.py scripts/worktree_env.py /opt/yoao-fixture-tools/
RUN test -f /app/app/vendor/TrackEval/trackeval_metrics/metrics.py \
  || (echo "ERROR: TrackEval submodule is missing; run git submodule update --init --recursive before building." >&2; exit 1)
RUN chmod +x /app/scripts/entrypoint.sh
EXPOSE 8000
ENTRYPOINT ["/app/scripts/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
