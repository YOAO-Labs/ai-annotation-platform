FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
WORKDIR /app
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg libvips-tools icc-profiles-free \
  && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.11.29
COPY apps/_shared/task_contract /_shared/task_contract
COPY apps/_shared/protocol_v2 /_shared/protocol_v2
COPY apps/_shared/training_contract /_shared/training_contract
COPY apps/_shared/filesystem_read /_shared/filesystem_read
COPY apps/_shared/site_agent_contract /_shared/site_agent_contract
COPY apps/api/pyproject.toml apps/api/uv.lock ./
# Keep dependencies outside /app: development workers bind-mount the source there.
RUN uv venv /opt/venv \
  && uv export --frozen --no-dev --no-emit-project \
       --no-emit-package aap-task-contract --no-emit-package aap-protocol-v2 --no-emit-package aap-training-contract \
       --no-emit-package aap-filesystem-read --no-emit-package aap-site-agent-contract --output-file /tmp/requirements.txt \
  && uv pip install --python /opt/venv/bin/python --require-hashes \
       -r /tmp/requirements.txt \
  && uv pip install --python /opt/venv/bin/python --no-deps /_shared/task_contract \
  && uv pip install --python /opt/venv/bin/python --no-deps /_shared/protocol_v2 \
  && uv pip install --python /opt/venv/bin/python --no-deps /_shared/training_contract \
  && uv pip install --python /opt/venv/bin/python --no-deps /_shared/filesystem_read \
  && uv pip install --python /opt/venv/bin/python --no-deps /_shared/site_agent_contract \
  && rm /tmp/requirements.txt
COPY apps/api/ .
RUN chmod +x /app/scripts/entrypoint.sh
EXPOSE 8000
ENTRYPOINT ["/app/scripts/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
