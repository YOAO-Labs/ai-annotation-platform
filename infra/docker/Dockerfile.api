FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
WORKDIR /app
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg libvips-tools icc-profiles-free \
  && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.11.29
COPY apps/_shared/owner_data /_shared/owner_data
COPY apps/_shared/identity_admission /_shared/identity_admission
COPY apps/_shared/inference_contract /_shared/inference_contract
COPY apps/_shared/task_contract /_shared/task_contract
COPY apps/_shared/protocol_v2 /_shared/protocol_v2
COPY apps/_shared/training_contract /_shared/training_contract
COPY apps/_shared/workspace_contract /_shared/workspace_contract
COPY apps/_shared/audit_contract /_shared/audit_contract
COPY apps/audit /audit
COPY apps/jobs /jobs
COPY apps/_shared/mail_transport /_shared/mail_transport
COPY apps/notifications /notifications
COPY apps/identity /identity
COPY apps/inference /inference
COPY apps/workspace /workspace
COPY apps/media-probe /media-probe
COPY apps/assets-catalog /assets-catalog
COPY apps/assets-media /assets-media
COPY apps/assets-mask-content /assets-mask-content
COPY apps/labeling-mask-gc /labeling-mask-gc
COPY apps/labeling /labeling
COPY apps/preannotation-results /preannotation-results
COPY apps/assets-cleanup /assets-cleanup
COPY apps/assets-source /assets-source
COPY apps/api/pyproject.toml apps/api/uv.lock ./
# Keep dependencies outside /app: development workers bind-mount the source there.
RUN uv venv /opt/venv \
  && uv export --frozen --no-dev --no-emit-project \
       --no-emit-package aap-inference-contract --no-emit-package aap-owner-data --no-emit-package aap-identity-admission --no-emit-package aap-labeling --no-emit-package aap-identity --no-emit-package aap-inference --no-emit-package aap-workspace --no-emit-package aap-mail-transport --no-emit-package aap-notifications --no-emit-package aap-jobs --no-emit-package aap-task-contract --no-emit-package aap-protocol-v2 --no-emit-package aap-training-contract --no-emit-package aap-workspace-contract --no-emit-package aap-audit-contract --no-emit-package aap-audit --no-emit-package aap-media-probe --no-emit-package aap-assets-cleanup --no-emit-package aap-assets-source --no-emit-package aap-assets-catalog --no-emit-package aap-assets-media --no-emit-package aap-assets-mask-content --no-emit-package aap-labeling-mask-gc --no-emit-package aap-preannotation-results --output-file /tmp/requirements.txt \
  && uv pip install --python /opt/venv/bin/python --require-hashes \
       -r /tmp/requirements.txt \
  && uv pip install --python /opt/venv/bin/python --no-deps /_shared/inference_contract \
  && uv pip install --python /opt/venv/bin/python --no-deps /_shared/owner_data \
  && uv pip install --python /opt/venv/bin/python --no-deps /_shared/identity_admission \
  && uv pip install --python /opt/venv/bin/python --no-deps /_shared/task_contract \
  && uv pip install --python /opt/venv/bin/python --no-deps /_shared/protocol_v2 \
  && uv pip install --python /opt/venv/bin/python --no-deps /_shared/training_contract \
  && uv pip install --python /opt/venv/bin/python --no-deps /_shared/workspace_contract \
  && uv pip install --python /opt/venv/bin/python --no-deps /_shared/audit_contract \
  && uv pip install --python /opt/venv/bin/python --no-deps /audit \
  && uv pip install --python /opt/venv/bin/python --no-deps /jobs \
  && uv pip install --python /opt/venv/bin/python --no-deps /_shared/mail_transport \
  && uv pip install --python /opt/venv/bin/python --no-deps /notifications \
  && uv pip install --python /opt/venv/bin/python --no-deps /identity \
  && uv pip install --python /opt/venv/bin/python --no-deps /inference \
  && uv pip install --python /opt/venv/bin/python --no-deps /workspace \
  && uv pip install --python /opt/venv/bin/python --no-deps /media-probe \
  && uv pip install --python /opt/venv/bin/python --no-deps /assets-catalog \
  && uv pip install --python /opt/venv/bin/python --no-deps /assets-media \
  && uv pip install --python /opt/venv/bin/python --no-deps /assets-mask-content \
  && uv pip install --python /opt/venv/bin/python --no-deps /labeling-mask-gc \
  && uv pip install --python /opt/venv/bin/python --no-deps /labeling \
  && uv pip install --python /opt/venv/bin/python --no-deps /preannotation-results \
  && uv pip install --python /opt/venv/bin/python --no-deps /assets-cleanup \
  && uv pip install --python /opt/venv/bin/python --no-deps /assets-source \
  && rm /tmp/requirements.txt
COPY apps/api/ .
COPY docs-site/public/home/sam-tools/smart-point.webm /app/fixture-media/smart-point.webm
RUN chmod +x /app/scripts/entrypoint.sh
EXPOSE 8000
ENTRYPOINT ["/app/scripts/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
