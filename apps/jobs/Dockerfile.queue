FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS builder
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
RUN python -m pip install --no-cache-dir uv==0.11.29
WORKDIR /build
COPY apps/jobs/pyproject.toml apps/jobs/uv.lock ./
COPY apps/jobs/src ./src
RUN uv sync --locked --no-dev --extra queue-runtime --no-editable

FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
ENV VIRTUAL_ENV=/opt/venv PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN groupadd --system --gid 10005 jobs \
    && useradd --system --uid 10005 --gid jobs --home-dir /nonexistent jobs
COPY --from=builder --chown=10005:10005 /opt/venv /opt/venv
WORKDIR /runtime
USER 10005:10005
CMD ["aap-jobs-queue"]
