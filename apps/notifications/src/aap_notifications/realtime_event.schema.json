{
  "$defs": {
    "NotificationEvent": {
      "additionalProperties": false,
      "description": "Persisted notification event sent through the existing user channel.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "pattern": "^([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})(\\.[0-9]+)?(Z|([+-])([01][0-9]|2[0-3]):([0-5][0-9]))$",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "maxLength": 36,
          "minLength": 36,
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Id",
          "type": "string"
        },
        "payload": {
          "title": "Payload"
        },
        "target_id": {
          "format": "uuid",
          "maxLength": 36,
          "minLength": 36,
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Target Id",
          "type": "string"
        },
        "target_type": {
          "maxLength": 30,
          "title": "Target Type",
          "type": "string"
        },
        "type": {
          "maxLength": 60,
          "title": "Type",
          "type": "string"
        }
      },
      "required": ["id", "type", "target_type", "target_id", "payload", "created_at"],
      "title": "NotificationEvent",
      "type": "object"
    },
    "NotificationSyncEvent": {
      "additionalProperties": true,
      "description": "Open sync hint; clients may ignore unknown reasons and extensions.",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "type": {
          "const": "notifications.sync",
          "title": "Type",
          "type": "string"
        }
      },
      "required": ["type"],
      "title": "NotificationSyncEvent",
      "type": "object"
    }
  },
  "$id": "aap-notification-realtime/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/NotificationEvent"
    },
    {
      "$ref": "#/$defs/NotificationSyncEvent"
    }
  ],
  "title": "AAP Notifications realtime event protocol"
}
