  "x-postgresql-functions": {
    "aap_labeling_v1.scene_track_domain_command(jsonb)": {
      "argument_types": ["jsonb"],
      "returns": "jsonb",
      "owner": "labeling",
      "security_definer": true,
      "caller_transaction_required": true,
      "fixed_targets": [
        "public.scene_tracks",
        "public.scene_track_intervals",
        "public.annotations"
      ],
      "actions": ["ensure", "reclassify", "touch"],
      "interval_sources": ["derived", "imported", "legacy_envelope", "manual"],
      "table_access": {
        "public.scene_tracks": {
          "select": [
            "id",
            "project_id",
            "scene_id",
            "track_id",
            "class_name",
            "presence_mode",
            "attributes",
            "attributes_meta",
            "revision",
            "created_by",
            "retired_at",
            "created_at",
            "updated_at"
          ],
          "insert": ["id", "project_id", "scene_id", "track_id", "class_name", "created_by"],
          "update": ["class_name", "revision", "updated_at"]
        },
        "public.scene_track_intervals": {
          "select": [
            "id",
            "scene_track_id",
            "start_frame",
            "end_frame",
            "source",
            "version",
            "created_by"
          ],
          "insert": ["id", "scene_track_id", "start_frame", "end_frame", "source", "created_by"],
          "update": ["start_frame", "end_frame", "version", "updated_at"],
          "delete": true
        },
        "public.annotations": {
          "select": [
            "id",
            "scene_track_id",
            "track_id",
            "class_name",
            "is_active",
            "was_cancelled",
            "sensor_role",
            "version",
            "updated_at"
          ],
          "update": ["class_name", "version", "updated_at"]
        }
      }
    }
