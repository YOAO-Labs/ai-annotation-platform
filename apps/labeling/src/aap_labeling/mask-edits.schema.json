          "title": "Expected Status",
          "type": "string"
        },
        "expected_review_round_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Review Round Id"
        },
        "schema": {
          "const": "aap-labeling-mask-edits/v1",
          "title": "Schema",
          "type": "string"
        },
        "operation": {
          "const": "apply_mask_mutations",
          "title": "Operation",
          "type": "string"
        },
        "mutation_kind": {
          "enum": [
            "slice_mask",
            "split_components",
            "copy_component",
            "copy_keyframe",
            "join_masks",
            "overlap",
            "delete_small_islands",
            "fill_small_holes",
            "resolve_same_class_overlap",
            "mask_repair_rollback"
          ],
          "title": "Mutation Kind",
          "type": "string"
        },
        "expected_versions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Expected Versions",
          "type": "object"
        },
        "changes": {
          "items": {
            "discriminator": {
              "mapping": {
                "create": "#/$defs/CreateMaskAnnotation",
                "deactivate": "#/$defs/DeactivateMaskAnnotation",
                "update": "#/$defs/UpdateMaskAnnotation"
              },
              "propertyName": "action"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/UpdateMaskAnnotation"
              },
              {
                "$ref": "#/$defs/CreateMaskAnnotation"
              },
              {
                "$ref": "#/$defs/DeactivateMaskAnnotation"
              }
            ]
          },
          "title": "Changes",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "project_id",
        "actor_id",
        "expected_batch_id",
        "expected_status",
        "expected_review_round_id",
        "schema",
        "operation",
        "mutation_kind",
        "expected_versions",
        "changes"
      ],
      "title": "ApplyMaskMutations",
      "type": "object"
    },
