{
  "openapi": "3.1.0",
  "info": {
    "title": "Audit monthly summary",
    "version": "1.0.0",
    "description": "Stateless reducer for pre-aggregated UTC audit rows. Python owns storage reads and public API behavior."
  },
  "servers": [{ "url": "http://127.0.0.1:8091" }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service is ready.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          },
          "405": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "responses": {
          "200": {
            "description": "This canonical OpenAPI document.",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          },
          "405": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/audit/monthly-summary": {
      "post": {
        "operationId": "summarizeAuditMonth",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MonthlySummaryRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Monthly summary.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MonthlySummary" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "405": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "A request or service error.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "protocol"],
        "properties": {
          "service": { "const": "audit-summary" },
          "protocol": { "const": 1 }
        }
      },
      "MonthlySummaryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["month", "materialized_through", "rows"],
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "materialized_through": {
            "anyOf": [
              { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              { "type": "null" }
            ]
          },
          "rows": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MonthlySummaryRow" }
          }
        }
      },
      "MonthlySummaryRow": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day", "action", "target_type", "actor_role", "status_family", "event_count"],
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "action": { "type": "string" },
          "target_type": { "type": "string" },
          "actor_role": { "type": "string" },
          "status_family": { "type": "integer", "enum": [0, 2, 3, 4, 5] },
          "event_count": {
            "type": "string",
            "minLength": 1,
            "maxLength": 38,
            "pattern": "^(0|[1-9][0-9]{0,37})$"
          }
        }
      },
      "MonthlySummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "month",
          "timezone",
          "materialized_through",
          "totals",
          "daily",
          "top_actions",
          "target_types",
          "actor_roles"
        ],
        "properties": {
          "month": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
          "timezone": { "const": "UTC" },
          "materialized_through": {
            "anyOf": [
              { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              { "type": "null" }
            ]
          },
          "totals": { "$ref": "#/components/schemas/MonthlySummaryTotals" },
          "daily": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MonthlySummaryDailyPoint" }
          },
          "top_actions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MonthlySummaryBucket" }
          },
          "target_types": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MonthlySummaryBucket" }
          },
          "actor_roles": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MonthlySummaryBucket" }
          }
        }
      },
      "MonthlySummaryTotals": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_count", "error_count", "action_kind_count"],
        "properties": {
          "event_count": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
          "error_count": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
          "action_kind_count": { "type": "integer", "minimum": 0 }
        }
      },
      "MonthlySummaryDailyPoint": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day", "event_count", "error_count"],
        "properties": {
          "day": { "type": "string", "format": "date" },
          "event_count": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
          "error_count": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
        }
      },
      "MonthlySummaryBucket": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "event_count"],
        "properties": {
          "key": { "type": "string" },
          "event_count": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "retryable": { "type": "boolean" }
        }
      }
    }
  }
}
