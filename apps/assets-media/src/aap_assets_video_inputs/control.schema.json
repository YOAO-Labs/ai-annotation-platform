          "type": "integer"
        },
        "is_keyframe": {
          "title": "Is Keyframe",
          "type": "boolean"
        },
        "ordinal": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "pts_ms": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
