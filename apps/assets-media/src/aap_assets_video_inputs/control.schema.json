    "CapturedVideoTask": {
      "additionalProperties": false,
      "description": "Raw capture can retain a missing link as a fixed member failure.",
      "properties": {
        "batch_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Batch Id"
        },
        "dataset_item_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dataset Item Id"
        },
        "file_path": {
          "maxLength": 1024,
          "title": "File Path",
          "type": "string"
        },
        "file_type": {
          "const": "video",
          "title": "File Type",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "task_source_generation": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Task Source Generation",
          "type": "integer"
        },
        "task_source_snapshot": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Task Source Snapshot",
          "type": "string"
        },
        "task_version": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Task Version",
          "type": "integer"
        }
      },
      "required": [
        "task_id",
        "project_id",
        "batch_id",
        "task_version",
        "task_source_generation",
        "dataset_item_id",
        "task_source_snapshot",
        "file_path",
        "file_type"
      ],
      "title": "CapturedVideoTask",
      "type": "object"
    },
    "FrameBlob": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "etag": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Etag",
          "type": "string"
        },
        "key": {
          "maxLength": 2048,
          "pattern": "^accepted-video-inputs/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/g[1-9][0-9]*/a[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/frames/(0|[1-9][0-9]*)/w[1-9][0-9]*-(jpeg|webp)$",
          "title": "Key",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": ["key", "version_id", "etag", "byte_size", "sha256"],
      "title": "FrameBlob",
      "type": "object"
    },
    "FramePageRequest": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "format": "uuid",
