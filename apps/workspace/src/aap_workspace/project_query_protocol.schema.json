    "ProjectQueryStep": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "list_rows"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "facts": {
                "$ref": "#/$defs/ProjectQueryRowsFacts"
              },
              "parameters": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "count_rows"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "facts": {
                "$ref": "#/$defs/ProjectQueryCountFacts"
              },
              "parameters": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "visible_rows"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "facts": {
                "$ref": "#/$defs/ProjectQueryRowsFacts"
              },
              "parameters": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "get_row"
              }
