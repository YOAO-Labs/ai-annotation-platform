            "\u521b\u5efa\u65e5\u671f\u987b\u4e3a ISO \u65e5\u671f\u6216\u65f6\u95f4",
            "\u521b\u5efa\u5f00\u59cb\u65e5\u671f\u4e0d\u80fd\u665a\u4e8e\u7ed3\u675f\u65e5\u671f",
