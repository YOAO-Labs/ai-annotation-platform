            "\u8eab\u4efd\u8d44\u6599\u670d\u52a1\u6682\u4e0d\u53ef\u7528"
          ],
          "title": "Detail",
          "type": "string"
        },
        "headers": {
          "anyOf": [
            {
              "additionalProperties": {
                "const": "Bearer",
                "type": "string"
              },
              "propertyNames": {
