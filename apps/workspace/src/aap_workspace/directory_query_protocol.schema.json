              "$ref": "#/$defs/DirectoryQueryProjectId"
            },
            {
              "$ref": "#/$defs/DirectoryQueryUserId"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parameters"
        },
        "request": {
          "$ref": "#/$defs/DirectoryQueryRequest"
        },
        "schema": {
          "const": "aap-workspace-directory-query/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "request", "action", "parameters", "facts"],
      "title": "DirectoryQueryStep",
      "type": "object"
