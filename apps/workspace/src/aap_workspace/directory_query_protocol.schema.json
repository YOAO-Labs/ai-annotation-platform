          "enum": [
            "\u8d26\u53f7\u5df2\u505c\u7528\u6216\u4e0d\u5b58\u5728",
            "\u8d26\u53f7\u89d2\u8272\u65e0\u6548\uff0c\u8bbf\u95ee\u88ab\u62d2\u7edd",
            "\u9879\u76ee\u4e0d\u5b58\u5728",
