    "DirectoryQueryStep": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "get_row"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "facts": {
                "$ref": "#/$defs/DirectoryQueryRowFacts"
              },
              "parameters": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "actor_status"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "facts": {
                "$ref": "#/$defs/ProjectQueryActorFacts"
              },
              "parameters": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "member_access"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "facts": {
                "$ref": "#/$defs/ProjectQueryMemberFacts"
              },
              "parameters": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "member_rows"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "facts": {
                "$ref": "#/$defs/DirectoryQueryMemberRowsFacts"
              },
              "parameters": {
                "$ref": "#/$defs/DirectoryQueryProjectId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "mention_owner"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "facts": {
                "$ref": "#/$defs/DirectoryQueryMentionOwnerFacts"
              },
              "parameters": {
                "$ref": "#/$defs/DirectoryQueryUserId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "mention_superadmins"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "facts": {
                "$ref": "#/$defs/DirectoryQueryMentionSuperadminsFacts"
              },
              "parameters": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "mention_members"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "facts": {
                "$ref": "#/$defs/DirectoryQueryMemberRowsFacts"
              },
              "parameters": {
                "$ref": "#/$defs/DirectoryQueryProjectId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "request": {
                "properties": {
                  "operation": {
                    "const": "list_members"
                  }
                },
                "required": ["operation"]
              }
            },
            "required": ["request"]
          },
          "then": {
            "properties": {
              "action": {
                "enum": ["actor_status", "get_row", "member_access", "member_rows"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "request": {
                "properties": {
                  "operation": {
                    "const": "mention_candidates"
                  }
                },
                "required": ["operation"]
              }
            },
            "required": ["request"]
          },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "actor_status",
                  "get_row",
                  "member_access",
                  "mention_members",
                  "mention_owner",
                  "mention_superadmins"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "action": {
          "enum": [
            "get_row",
            "actor_status",
            "member_access",
            "member_rows",
            "mention_owner",
            "mention_superadmins",
            "mention_members"
          ],
          "title": "Action",
          "type": "string"
        },
        "facts": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectoryQueryRowFacts"
            },
            {
              "$ref": "#/$defs/ProjectQueryActorFacts"
            },
            {
              "$ref": "#/$defs/ProjectQueryMemberFacts"
