      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": ["create_template", "update_template", "duplicate_template"],
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        }
      },
      "required": ["operation_id", "operation"],
      "title": "TemplateConfigurationReceipt",
      "type": "object"
    },
    "TemplateQueryActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": ["id", "role"],
      "title": "TemplateQueryActor",
      "type": "object"
    },
    "TemplateQueryCreatorNameFacts": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        }
      },
      "required": ["name"],
      "title": "TemplateQueryCreatorNameFacts",
      "type": "object"
    },
    "TemplateQueryCreatorNameStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "creator_name",
          "title": "Action",
          "type": "string"
