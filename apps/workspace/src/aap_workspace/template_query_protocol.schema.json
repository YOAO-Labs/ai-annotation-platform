      "required": ["rows_json"],
      "title": "TemplateQueryListRowsFacts",
      "type": "object"
    },
    "TemplateQueryListRowsStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "list_rows",
          "title": "Action",
          "type": "string"
        },
        "facts": {
          "$ref": "#/$defs/TemplateQueryListRowsFacts"
        },
        "request": {
          "$ref": "#/$defs/TemplateQueryRequest"
        },
        "schema": {
          "const": "aap-workspace-template-query/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "request", "action", "facts"],
