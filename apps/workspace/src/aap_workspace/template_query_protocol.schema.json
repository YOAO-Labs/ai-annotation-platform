  "x-template-row-columns": [
    "id",
    "display_id",
    "name",
    "description",
    "type_label",
    "type_key",
    "data_type",
    "tool_bindings",
    "label_config",
    "ai_enabled",
    "sampling",
    "maximum_annotations",
    "show_overlap_first",
    "iou_dedup_threshold",
    "box_threshold",
    "text_threshold",
    "rendering_config",
    "annotation_guide",
    "scope",
    "organization_id",
    "created_by",
    "source_project_id",
    "usage_count",
    "created_at",
    "updated_at"
  ]
