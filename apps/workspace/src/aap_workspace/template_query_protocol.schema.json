        "request": {
          "$ref": "#/$defs/TemplateQueryRequest"
        },
        "schema": {
          "const": "aap-workspace-template-query/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "request", "data_json"],
      "title": "TemplateQuerySuccess",
      "type": "object"
    }
