  "$id": "aap-workspace-template-query/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/TemplateQueryRequest"
    },
    {
      "$ref": "#/$defs/TemplateQueryPolicy"
    },
    {
