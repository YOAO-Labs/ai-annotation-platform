          "$ref": "#/$defs/TemplateQueryCreatorNameFacts"
        },
        "request": {
          "$ref": "#/$defs/TemplateQueryRequest"
        },
        "schema": {
          "const": "aap-workspace-template-query/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "request", "action", "facts"],
      "title": "TemplateQueryCreatorNameStep",
      "type": "object"
    },
    "TemplateQueryError": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "const": "\u6a21\u677f\u4e0d\u5b58\u5728",
          "title": "Detail",
          "type": "string"
        },
        "headers": {
          "title": "Headers",
          "type": "null"
        },
        "status_code": {
          "const": 404,
          "title": "Status Code",
          "type": "integer"
        }
      },
      "required": ["status_code", "detail", "headers"],
      "title": "TemplateQueryError",
      "type": "object"
    },
    "TemplateQueryFailure": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/TemplateQueryError"
        },
        "ok": {
          "const": false,
          "title": "Ok",
          "type": "boolean"
        },
        "request": {
          "$ref": "#/$defs/TemplateQueryRequest"
        },
        "schema": {
          "const": "aap-workspace-template-query/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "request", "error"],
      "title": "TemplateQueryFailure",
      "type": "object"
