        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema": {
          "const": "aap-workspace-template-query/v1",
          "title": "Schema",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
