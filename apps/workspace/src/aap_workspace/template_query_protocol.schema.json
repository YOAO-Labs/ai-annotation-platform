    },
    {
      "$ref": "#/$defs/TemplateQueryFailure"
    },
    {
      "$ref": "#/$defs/TemplateQueryOrganizationIdsStep"
    },
    {
      "$ref": "#/$defs/TemplateQueryListRowsStep"
    },
    {
      "$ref": "#/$defs/TemplateQueryGetRowStep"
    },
    {
      "$ref": "#/$defs/TemplateQueryProjectionRowStep"
    },
    {
      "$ref": "#/$defs/TemplateQueryCreatorNameStep"
    }
