          "title": "Organization Ids",
          "type": "array"
        }
      },
      "required": ["organization_ids"],
      "title": "TemplateQueryOrganizationIdsFacts",
      "type": "object"
    },
    "TemplateQueryOrganizationIdsStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "organization_ids",
          "title": "Action",
          "type": "string"
        },
        "facts": {
          "$ref": "#/$defs/TemplateQueryOrganizationIdsFacts"
        },
        "request": {
          "$ref": "#/$defs/TemplateQueryRequest"
        },
        "schema": {
          "const": "aap-workspace-template-query/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "request", "action", "facts"],
      "title": "TemplateQueryOrganizationIdsStep",
      "type": "object"
    },
    "TemplateQueryPolicy": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "aap-workspace-template-query/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema"],
      "title": "TemplateQueryPolicy",
      "type": "object"
    },
    "TemplateQueryProjectionRowStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "projection_row",
          "title": "Action",
          "type": "string"
