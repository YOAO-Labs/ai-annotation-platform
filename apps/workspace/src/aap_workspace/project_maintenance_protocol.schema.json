            "name": "p_tool_bindings",
            "postgres_type": "jsonb"
          }
        ],
        "name": "create_import_project",
        "result_model": "ImportProjectCreated",
        "result_postgres_type": "jsonb",
        "result_schema_ref": "#/$defs/ImportProjectCreated",
        "signature": "aap_workspace_v1.create_import_project(uuid, text, text, uuid, jsonb)",
        "transaction_semantics": "Insert one Project with the caller-supplied UUID and return its reference; this is not an upsert. The caller owns authorization, the surrounding workflow transaction, and commit. Uniqueness, foreign-key, and length errors remain database errors."
      },
      {
        "arguments": [
          {
            "json_schema": {
              "format": "uuid",
              "type": "string"
            },
