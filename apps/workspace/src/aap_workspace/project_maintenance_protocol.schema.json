        "result_schema_ref": "#/$defs/PointQualityConfigWrite",
        "signature": "aap_workspace_v1.write_point_cloud_quality_config(uuid, jsonb)",
        "transaction_semantics": "Update the Project configuration in the caller's existing transaction. The caller owns authorization, Project FOR UPDATE, evaluation, Audit, and commit. An equal JSONB value leaves updated_at unchanged; a missing Project raises no_data_found. No compare-and-swap or lock mode is added by this capability."
      }
    ],
    "postgres_schema": "aap_workspace_v1",
    "protocol": "aap-workspace-project-maintenance/v1",
