{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aap-inference-backend-endpoint/v1",
  "title": "Purpose-bound backend endpoint handoff",
  "description": "The endpoint subject seals the exact registry endpoint snapshot. Read purposes have no route authority and open only while the origin transaction is in progress; stateful purposes carry a live scope/control authority. The subject contains no endpoint credential in plaintext.",
  "oneOf": [
    { "$ref": "#/$defs/BackendEndpointSubject" },
    { "$ref": "#/$defs/BackendEndpointNativePolicy" }
  ],
  "$defs": {
    "BackendEndpointAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scope_id", "control_id", "attempt_id"],
      "properties": {
        "kind": { "enum": ["scope", "control"] },
        "scope_id": { "oneOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }] },
        "control_id": { "oneOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }] },
        "attempt_id": { "type": "string", "format": "uuid" }
      }
    },
    "BackendEndpointBinding": {
      "allOf": [
        { "$ref": "#/$defs/BackendEndpointAuthority" },
        {
          "type": "object",
          "required": ["capability"],
          "properties": {
            "capability": { "type": "string", "pattern": "^[0-9a-f]{64}$", "writeOnly": true }
          }
        }
      ]
    },
    "BackendEndpointSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "request_id", "registry_id", "purpose", "authority", "subject"],
      "properties": {
        "schema": { "const": "aap-inference-backend-endpoint/v1" },
        "request_id": { "type": "string", "format": "uuid" },
        "registry_id": { "type": "string", "format": "uuid" },
        "purpose": {
          "enum": [
            "health_observation",
            "setup",
            "catalog_fallback",
            "stats",
            "backend_read",
            "lifecycle",
            "execution",
            "gpu_control"
          ]
        },
        "authority": {
          "oneOf": [{ "$ref": "#/$defs/BackendEndpointAuthority" }, { "type": "null" }]
        },
        "subject": {
          "type": "string",
          "minLength": 7,
          "maxLength": 25165824,
          "pattern": "^v1\\.(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "description": "Native-encrypted exact endpoint snapshot; never an endpoint URL or credential."
        }
      },
      "x-max-bytes": 25165824
    },
    "BackendEndpointNativePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "subject_protocol",
        "origin_transaction",
        "open_transaction",
        "protection",
        "functions",
        "ready"
      ],
      "properties": {
        "schema": { "const": "aap-inference-backend-endpoint-native/v1" },
        "subject_protocol": { "const": "aap-inference-backend-endpoint-subject/v1" },
        "origin_transaction": { "const": "caller_owned" },
        "open_transaction": { "const": "read_in_progress_mutation_live" },
        "protection": { "const": "pgcrypto-pgp-aes256-mdc" },
        "functions": {
          "type": "array",
          "const": [
            "aap_inference_backend_endpoint_v1.backend_endpoint_policy()",
            "aap_inference_backend_endpoint_v1.controlled_model_credential_policy(uuid)",
            "aap_inference_backend_endpoint_v1.capture_backend_endpoint_subject(uuid,uuid,text,text)",
            "aap_inference_backend_endpoint_v1.open_health_observation_endpoint(text,uuid,uuid,text)",
            "aap_inference_backend_endpoint_v1.open_setup_endpoint(text,uuid,uuid,text)",
            "aap_inference_backend_endpoint_v1.open_catalog_fallback_endpoint(text,uuid,uuid,text)",
            "aap_inference_backend_endpoint_v1.open_stats_endpoint(text,uuid,uuid,text)",
            "aap_inference_backend_endpoint_v1.open_backend_read_endpoint(text,uuid,uuid,text)",
            "aap_inference_backend_endpoint_v1.open_lifecycle_endpoint(text,uuid,uuid,text)",
            "aap_inference_backend_endpoint_v1.open_execution_endpoint(text,uuid,uuid,text)",
            "aap_inference_backend_endpoint_v1.open_gpu_control_endpoint(text,uuid,uuid,text)",
            "aap_inference_backend_endpoint_v1.health_backend_row(uuid,boolean)",
            "aap_inference_backend_endpoint_v1.stats_endpoint_rows()",
            "aap_inference_backend_endpoint_v1.catalog_endpoint_rows()",
            "aap_inference_backend_endpoint_v1.observation_registration_labels(text[])"
          ]
        },
        "ready": { "type": "boolean" }
      }
    }
  }
}
