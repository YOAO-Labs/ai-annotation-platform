    "RoutingStatusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "request_id", "command_sha256", "operation"],
      "properties": {
        "schema": {
          "const": "aap-inference-routing-status/v1"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "command_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operation": {
          "enum": [
            "acquire",
            "video_acquire",
            "begin",
            "settle",
            "heartbeat",
            "close",
            "scope_status",
            "reconcile",
            "prepare_control",
            "finish_control",
            "begin_control",
            "settle_control"
          ]
        }
      }
    },
    "RoutingRuntimeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "request_id", "registry_ids"],
      "properties": {
        "schema": {
          "const": "aap-inference-routing-runtime/v1"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "registry_ids": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "RoutingRuntimeRegistryView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_id",
        "open_scopes",
        "active_attempts",
        "uncertain_attempts",
        "continuity",
        "authority_epoch",
        "backend_incarnation",
        "control_id"
      ],
      "properties": {
        "registry_id": {
          "type": "string",
          "format": "uuid"
        },
        "open_scopes": {
          "type": "integer",
          "minimum": 0
        },
        "active_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "uncertain_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "continuity": {
          "enum": ["unverified", "ready"]
        },
        "authority_epoch": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "backend_incarnation": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "control_id": {
          "type": ["string", "null"],
          "format": "uuid"
        }
      }
    },
    "RoutingRuntimeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "request_id", "observed_at", "registries"],
      "properties": {
        "schema": {
          "const": "aap-inference-routing-runtime-result/v1"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "registries": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/RoutingRuntimeRegistryView"
          }
        }
      }
    },
    "RoutingVideoExecutionProof": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "worker_id": {
          "format": "uuid",
          "title": "Worker Id",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "lease_token": {
          "format": "uuid",
          "title": "Lease Token",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": ["job_id", "run_id", "worker_id", "generation", "lease_token"],
      "title": "RoutingVideoExecutionProof",
      "type": "object"
    },
    "VideoAcquireBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool_id",
        "registry_id",
        "project_id",
        "mode",
        "required_instance_id",
        "owner",
        "operation",
        "execution"
      ],
      "properties": {
        "pool_id": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "registry_id": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "mode": {
          "enum": ["off", "observe", "enforce", "direct"]
        },
        "required_instance_id": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "operation": {
          "const": "tracker"
        },
        "execution": {
          "$ref": "#/$defs/RoutingVideoExecutionProof"
        }
      },
      "description": "owner must equal tracker:<execution.job_id>; project_id must match the frozen Labeling input scope."
    }
  },
  "x-request-max-bytes": 1048576,
  "x-reply-max-bytes": 1048576,
  "x-native-policy": {
    "schema": "aap-inference-routing-native/v1",
    "data_protocol": "aap-inference-routing-data/v1",
    "transaction": "caller_owned",
    "functions": [
      "aap_inference_routing_v1.routing_policy()",
      "aap_inference_routing_v1.routing_step(text,text)"
    ],
    "actions": [
      "command_status",
      "record_command",
      "admission_snapshot",
      "reserve_scope",
      "scope_status",
      "begin_attempt",
      "settle_attempt",
      "heartbeat_scope",
      "close_scope",
      "quiescence",
      "prepare_control",
      "finish_control",
      "prepare_epoch",
      "finish_epoch",
      "capture_transport_subject",
      "open_transport_subject",
      "begin_control_attempt",
      "settle_control_attempt",
      "runtime_snapshot"
    ]
  }
