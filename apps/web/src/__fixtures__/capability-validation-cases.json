{
  "_doc": "前后端共用的预标注能力判据。后端逐项比较违例码序列与 expect_codes，前端显示首个违例的警示。多个判据同时触发时，batchable 判据先于 class。",
  "codes": {
    "not_batchable": "resource_profile.batchable 显式 false (交互/有状态) → 不能批量预标",
    "no_class_attribute": "写属性的下游, 模型自报 output_attribute_types 非空但不含 class → 属性恒空"
  },
  "cases": [
    {
      "name": "source model not batchable (源阶段 batchable=false)",
      "model_caps": { "resource_profile": { "batchable": false } },
      "writes_attributes": false,
      "expect_codes": ["not_batchable"]
    },
    {
      "name": "downstream not batchable, no attr types (下游 batchable=false)",
      "model_caps": { "resource_profile": { "batchable": false } },
      "writes_attributes": true,
      "expect_codes": ["not_batchable"]
    },
    {
      "name": "both fire: not batchable + no class (batchable 优先)",
      "model_caps": {
        "resource_profile": { "batchable": false },
        "output_attribute_types": ["text"]
      },
      "writes_attributes": true,
      "expect_codes": ["not_batchable", "no_class_attribute"]
    },
    {
      "name": "downstream writes attrs but model lacks class (无 class 属性)",
      "model_caps": {
        "resource_profile": { "batchable": true },
        "output_attribute_types": ["text"]
      },
      "writes_attributes": true,
      "expect_codes": ["no_class_attribute"]
    },
    {
      "name": "downstream produces class (含 class → 放行)",
      "model_caps": {
        "resource_profile": { "batchable": true },
        "output_attribute_types": ["class"]
      },
      "writes_attributes": true,
      "expect_codes": []
    },
    {
      "name": "old backend: no resource_profile, no attr types (零退化放行)",
      "model_caps": {},
      "writes_attributes": true,
      "expect_codes": []
    },
    {
      "name": "batchable true source (放行)",
      "model_caps": { "resource_profile": { "batchable": true } },
      "writes_attributes": false,
      "expect_codes": []
    },
    {
      "name": "lacks class but does NOT write attrs (writes_attributes 门控 → 不触发)",
      "model_caps": { "output_attribute_types": ["text"] },
      "writes_attributes": false,
      "expect_codes": []
    },
    {
      "name": "resource_profile present but batchable absent (缺省不触发)",
      "model_caps": {
        "resource_profile": { "gpu": true },
        "output_attribute_types": ["text"]
      },
      "writes_attributes": true,
      "expect_codes": ["no_class_attribute"]
    },
    {
      "name": "ocr recognize downstream: text not class (识别下游 task=ocr → 放行)",
      "model_caps": {
        "resource_profile": { "batchable": true },
        "output_attribute_types": ["text", "orientation", "language"],
        "task": "ocr"
      },
      "writes_attributes": true,
      "expect_codes": []
    },
    {
      "name": "ocr recognize but not batchable (识别下游 task=ocr 仍受 batchable 拦)",
      "model_caps": {
        "resource_profile": { "batchable": false },
        "output_attribute_types": ["text"],
        "task": "ocr"
      },
      "writes_attributes": true,
      "expect_codes": ["not_batchable"]
    }
  ]
}
