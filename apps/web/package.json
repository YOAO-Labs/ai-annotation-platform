{
  "name": "@anno/web",
  "private": true,
  "version": "0.26.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/codegen-if-changed.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/check-tw-tokens.mjs",
    "lint:css-tokens": "node scripts/check-tw-tokens.mjs",
    "lint:tw-tokens": "node scripts/check-tw-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "codegen": "openapi-ts && node scripts/gen-capability-vocab.mjs",
    "codegen:watch": "openapi-ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test --config=playwright.extended.config.ts --grep @visual",
    "test:e2e:stress": "playwright test --config=playwright.stress.config.ts",
    "test:e2e:mask-readonly": "PLAYWRIGHT_RASTER_MASK_MATRIX=readonly playwright test e2e/tests/raster-mask-native.spec.ts --project=chromium",
    "test:e2e:mask-native": "PLAYWRIGHT_RASTER_MASK_MATRIX=native playwright test e2e/tests/raster-mask-native.spec.ts e2e/tests/mask-advanced-operations.spec.ts --project=chromium",
    "test:e2e:mask-ai-native": "PLAYWRIGHT_RASTER_MASK_MATRIX=native playwright test e2e/tests/native-mask-ai.spec.ts e2e/tests/video-tracker-local-review.spec.ts --project=chromium",
    "screenshots": "playwright test --config=playwright.screenshots.config.ts --project=desktop-light",
    "screenshots:dark": "playwright test --config=playwright.screenshots.config.ts --project=desktop-dark",
    "screenshots:matrix": "playwright test --config=playwright.screenshots.config.ts --project=desktop-light --project=desktop-dark --project=mobile",
    "screenshots:flows": "playwright test --config=playwright.screenshots.config.ts --project=flows",
    "screenshots:marketing": "node scripts/run-marketing-capture.mjs",
    "screenshots:record": "node scripts/run-recording-capture.mjs",
    "screenshots:record:test": "node --test e2e/screenshots/recording-plan.test.mjs e2e/screenshots/_helpers/portable-recorder.test.ts e2e/screenshots/_helpers/annotation-cleanup.test.ts e2e/screenshots/_helpers/recording-cleanup.test.ts e2e/screenshots/flows/_smart-scribble-evidence.test.ts e2e/screenshots/flows/_sam-recording-candidates.test.ts e2e/screenshots/flows/_video-keyframe-evidence.test.ts",
    "screenshots:marketing:test": "node --test e2e/screenshots/_helpers/marketing-recorder.test.ts",
    "screenshots:docs-media": "node scripts/derive-doc-media.mjs",
    "screenshots:docs-media:test": "node --test scripts/media-derivation.test.mjs",
    "screenshots:regression": "playwright test --config=playwright.screenshots.config.ts --project=regression",
    "screenshots:regression:update": "playwright test --config=playwright.screenshots.config.ts --project=regression --update-snapshots",
    "screenshots:lint": "node scripts/screenshots-lint.mjs --strict",
    "size": "node scripts/check-bundle-size.mjs",
    "video:bench": "node scripts/video-bench/run-video-bench.mjs",
    "pointcloud:renderer-bench": "node scripts/benchmark-pointcloud-renderer.mjs",
    "image:bench": "node scripts/image-bench/run-image-bench.mjs",
    "image:seeds": "node scripts/image-bench/fetch-real-large-images.mjs",
    "mask:bench": "node scripts/benchmark-image-raster-mask.mjs",
    "mask:operations-bench": "node scripts/benchmark-mask-operations.mjs",
    "mask:large-canvas-bench": "node scripts/benchmark-mask-large-canvas.mjs",
    "mask:packed-cpu-bench": "node scripts/benchmark-mask-packed-cpu.mjs",
    "mask:webgpu-operation-bench": "node scripts/benchmark-mask-webgpu-operation.mjs",
    "mask:webgpu-separable-bench": "node scripts/benchmark-mask-webgpu-separable.mjs",
    "gen:avatars": "node scripts/gen-pixel-avatars.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@mdxeditor/editor": "4.2.4",
    "@sentry/react": "^8.45.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/rbush": "^4.0.0",
    "@xyflow/react": "^12.11.1",
    "blurhash": "^2.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dockview-react": "8.2.0",
    "html2canvas-pro": "^2.0.2",
    "idb-keyval": "^6.2.2",
    "konva": "^10.2.5",
    "lexical": "0.48.0",
    "lucide-react": "^1.14.0",
    "polygon-clipping": "^0.15.7",
    "radix-ui": "^1.6.0",
    "rbush": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.14",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.4",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "use-image": "^1.1.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@eslint/js": "^9.16.0",
    "@hey-api/openapi-ts": "^0.55.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@webgpu/types": "^0.1.71",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
