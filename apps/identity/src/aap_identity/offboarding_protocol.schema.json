{
  "$defs": {
    "CommitOffboardingPayload": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["handoff", "emergency_suspend"],
          "title": "Mode",
          "type": "string"
        },
        "preview_version": {
          "title": "Preview Version",
          "type": "string"
        },
        "projects": {
          "items": {
            "$ref": "#/$defs/OffboardingProjectRequest"
          },
          "title": "Projects",
          "type": "array"
        },
        "reason": {
          "maxLength": 500,
          "title": "Reason",
          "type": "string"
        },
        "target_user_id": {
          "format": "uuid",
          "title": "Target User Id",
          "type": "string"
        }
      },
      "required": ["target_user_id", "preview_version", "reason", "mode", "projects"],
      "title": "CommitOffboardingPayload",
      "type": "object"
    },
    "CommitOffboardingReply": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/OffboardingCommitData"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "operation": {
          "const": "commit_offboarding",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "schema": {
          "const": "aap-identity-offboarding/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "operation_id", "principal", "operation", "data"],
      "title": "CommitOffboardingReply",
      "type": "object"
    },
    "CommitOffboardingRequest": {
      "additionalProperties": false,
      "properties": {
        "audit_context": {
          "$ref": "#/$defs/SessionAuditContext"
        },
        "operation": {
          "const": "commit_offboarding",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/CommitOffboardingPayload"
        },
        "schema": {
          "const": "aap-identity-offboarding/v1",
          "title": "Schema",
          "type": "string"
        },
        "token": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Token",
          "type": "string"
        }
      },
      "required": ["schema", "operation_id", "token", "audit_context", "operation", "payload"],
      "title": "CommitOffboardingRequest",
      "type": "object"
    },
