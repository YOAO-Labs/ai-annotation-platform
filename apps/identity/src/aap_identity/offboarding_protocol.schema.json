      },
      "required": ["result"],
      "title": "OffboardingCommitData",
      "type": "object"
    },
    "OffboardingFailureDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "enum": [
                "invalid_request",
                "credential_invalid",
                "credential_revoked",
                "generation_outdated",
                "token_expired",
                "user_inactive",
                "invalid_account_role",
                "credential_busy"
              ],
              "type": "string"
            },
            {
              "enum": [
                "manager_required",
                "target_not_found",
                "self_offboard",
                "last_super_admin",
                "target_role_forbidden",
                "inactive_unmanaged",
                "scope_forbidden",
                "offboarding_preview_stale",
                "historical_target",
                "state_forbidden",
                "duplicate_project",
                "receiver_required",
                "receiver_ineligible",
                "offboarding_blocked",
                "account_busy",
                "offboarding_busy",
                "operation_conflict",
                "unavailable"
              ],
              "type": "string"
            }
          ],
          "title": "Code"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/PreviewStaleDetail"
            },
            {
              "$ref": "#/$defs/ReceiverRequiredDetail"
            },
            {
              "$ref": "#/$defs/ReceiverIneligibleDetail"
            },
            {
              "$ref": "#/$defs/OffboardingBlockedDetail"
            },
            {
              "$ref": "#/$defs/OffboardingTaskBusyDetail"
            },
            {
              "$ref": "#/$defs/OffboardingResourceBusyDetail"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        },
        "status_code": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 400,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status Code"
        }
      },
      "required": ["code", "status_code", "detail"],
      "title": "OffboardingFailureDetail",
      "type": "object"
    },
    "OffboardingFailureReply": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/OffboardingFailureDetail"
        },
        "ok": {
          "const": false,
          "title": "Ok",
          "type": "boolean"
        },
        "schema": {
          "const": "aap-identity-offboarding/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "error"],
      "title": "OffboardingFailureReply",
      "type": "object"
    },
    "OffboardingPreviewData": {
      "additionalProperties": false,
