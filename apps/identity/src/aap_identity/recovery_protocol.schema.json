{
  "$defs": {
    "AccountRecord": {
      "additionalProperties": false,
      "properties": {
        "avatar_ref": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Avatar Ref"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deactivation_requested_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deactivation Requested At"
        },
        "deactivation_scheduled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deactivation Scheduled At"
        },
        "disabled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disabled At"
        },
        "disabled_by": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disabled By"
        },
        "disabled_kind": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disabled Kind"
        },
        "disabled_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disabled Reason"
        },
        "email": {
          "maxLength": 255,
          "title": "Email",
          "type": "string"
        },
        "email_verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Email Verified At"
        },
        "group_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Group Id"
        },
        "group_name": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Group Name"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "is_active": {
          "title": "Is Active",
          "type": "boolean"
        },
        "last_login_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Login At"
        },
        "last_seen_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Seen At"
        },
        "name": {
          "maxLength": 100,
          "title": "Name",
          "type": "string"
        },
        "password_admin_reset_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Password Admin Reset At"
        },
        "preferences": {
          "additionalProperties": true,
          "title": "Preferences",
          "type": "object"
        },
        "role": {
          "enum": ["super_admin", "project_admin", "employee", "viewer"],
          "title": "Role",
          "type": "string"
        },
        "status": {
          "maxLength": 20,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "email",
        "name",
        "role",
        "group_name",
        "group_id",
        "status",
        "is_active",
        "disabled_kind",
        "disabled_at",
        "disabled_by",
        "disabled_reason",
        "email_verified_at",
        "last_login_at",
        "last_seen_at",
        "password_admin_reset_at",
        "deactivation_requested_at",
        "deactivation_scheduled_at",
        "preferences",
        "avatar_ref",
        "created_at"
      ],
      "title": "AccountRecord",
      "type": "object"
    },
    "ConsumeEmailVerificationPayload": {
      "additionalProperties": false,
      "properties": {
        "token": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Token",
          "type": "string"
        }
      },
      "required": ["token"],
      "title": "ConsumeEmailVerificationPayload",
      "type": "object"
    },
    "ConsumeEmailVerificationRequest": {
      "additionalProperties": false,
      "properties": {
        "audit_context": {
          "$ref": "#/$defs/SessionAuditContext"
        },
        "operation": {
          "const": "consume_email_verification",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ConsumeEmailVerificationPayload"
        },
        "schema": {
          "const": "aap-identity-recovery/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "operation_id", "audit_context", "operation", "payload"],
      "title": "ConsumeEmailVerificationRequest",
      "type": "object"
    },
    "ConsumePasswordResetPayload": {
      "additionalProperties": false,
      "properties": {
        "new_password": {
          "maxLength": 128,
          "minLength": 8,
          "title": "New Password",
          "type": "string"
        },
        "token": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Token",
          "type": "string"
        }
      },
      "required": ["token", "new_password"],
      "title": "ConsumePasswordResetPayload",
      "type": "object"
    },
    "ConsumePasswordResetRequest": {
      "additionalProperties": false,
      "properties": {
        "audit_context": {
          "$ref": "#/$defs/SessionAuditContext"
        },
        "operation": {
          "const": "consume_password_reset",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ConsumePasswordResetPayload"
        },
        "schema": {
          "const": "aap-identity-recovery/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "operation_id", "audit_context", "operation", "payload"],
      "title": "ConsumePasswordResetRequest",
      "type": "object"
    },
    "RecoveryFailureDetailModel": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "registration_disabled",
            "email_exists",
            "captcha_required",
            "policy_rejected",
            "operation_conflict",
            "invalid_request",
            "unavailable"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/RecoveryValidationIssue"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        },
        "status_code": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 400,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status Code"
        }
      },
      "required": ["code", "status_code", "detail"],
      "title": "RecoveryFailureDetailModel",
      "type": "object"
    },
    "RecoveryFailureReply": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/RecoveryFailureDetailModel"
        },
        "ok": {
          "const": false,
          "title": "Ok",
          "type": "boolean"
        },
        "schema": {
          "const": "aap-identity-recovery/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "error"],
      "title": "RecoveryFailureReply",
      "type": "object"
    },
    "RecoveryResultData": {
      "additionalProperties": false,
      "properties": {
        "access_token": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Access Token"
        },
        "account": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccountRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "claims": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionClaims"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completed"
        },
        "email_verification_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Email Verification Required"
        }
      },
      "required": ["account", "claims", "access_token", "email_verification_required", "completed"],
      "title": "RecoveryResultData",
      "type": "object"
    },
    "RecoverySuccess": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/RecoveryResultData"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "operation": {
          "enum": [
            "register_open",
            "request_password_reset",
            "resend_email_verification",
            "consume_password_reset",
            "consume_email_verification"
          ],
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "aap-identity-recovery/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "operation", "operation_id", "data"],
      "title": "RecoverySuccess",
      "type": "object"
    },
    "RecoveryValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "loc": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Loc",
          "type": "array"
        },
        "msg": {
          "title": "Msg",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": ["type", "loc", "msg"],
      "title": "RecoveryValidationIssue",
      "type": "object"
    },
    "RegisterOpenPayload": {
      "additionalProperties": false,
      "properties": {
        "captcha_verified": {
          "title": "Captcha Verified",
          "type": "boolean"
        },
        "email": {
          "maxLength": 255,
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "password": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Password",
          "type": "string"
        }
      },
      "required": ["email", "name", "password", "captcha_verified"],
      "title": "RegisterOpenPayload",
      "type": "object"
    },
    "RegisterOpenRequest": {
      "additionalProperties": false,
      "properties": {
        "audit_context": {
          "$ref": "#/$defs/SessionAuditContext"
        },
        "operation": {
          "const": "register_open",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/RegisterOpenPayload"
        },
        "schema": {
          "const": "aap-identity-recovery/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "operation_id", "audit_context", "operation", "payload"],
      "title": "RegisterOpenRequest",
      "type": "object"
    },
    "RequestPasswordResetPayload": {
      "additionalProperties": false,
      "properties": {
        "captcha_verified": {
          "title": "Captcha Verified",
          "type": "boolean"
        },
        "email": {
          "maxLength": 255,
          "minLength": 3,
          "title": "Email",
          "type": "string"
        }
      },
      "required": ["email", "captcha_verified"],
      "title": "RequestPasswordResetPayload",
      "type": "object"
    },
    "RequestPasswordResetRequest": {
      "additionalProperties": false,
      "properties": {
        "audit_context": {
          "$ref": "#/$defs/SessionAuditContext"
        },
        "operation": {
          "const": "request_password_reset",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/RequestPasswordResetPayload"
        },
        "schema": {
          "const": "aap-identity-recovery/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "operation_id", "audit_context", "operation", "payload"],
      "title": "RequestPasswordResetRequest",
      "type": "object"
    },
    "ResendEmailVerificationPayload": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "maxLength": 255,
          "minLength": 3,
          "title": "Email",
          "type": "string"
        }
      },
      "required": ["email"],
      "title": "ResendEmailVerificationPayload",
      "type": "object"
    },
    "ResendEmailVerificationRequest": {
      "additionalProperties": false,
      "properties": {
        "audit_context": {
          "$ref": "#/$defs/SessionAuditContext"
        },
        "operation": {
          "const": "resend_email_verification",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ResendEmailVerificationPayload"
        },
        "schema": {
          "const": "aap-identity-recovery/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "operation_id", "audit_context", "operation", "payload"],
      "title": "ResendEmailVerificationRequest",
      "type": "object"
    },
    "SessionAuditContext": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ip"
        },
        "method": {
          "anyOf": [
            {
              "maxLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Method"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 36,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Request Id"
        }
      },
      "required": ["method", "path", "ip", "request_id"],
      "title": "SessionAuditContext",
      "type": "object"
    },
    "SessionClaims": {
      "additionalProperties": false,
      "properties": {
        "exp": {
          "exclusiveMinimum": 0,
          "title": "Exp",
          "type": "integer"
        },
        "gen": {
          "exclusiveMaximum": 9223372036854775808,
          "minimum": 0,
          "title": "Gen",
          "type": "integer"
        },
        "iss": {
          "const": "aap-identity/v1",
          "title": "Iss",
          "type": "string"
        },
        "jti": {
          "format": "uuid",
          "title": "Jti",
          "type": "string"
        },
        "role": {
          "enum": ["super_admin", "project_admin", "employee", "viewer"],
          "title": "Role",
          "type": "string"
        },
        "sub": {
          "format": "uuid",
          "title": "Sub",
          "type": "string"
        }
      },
      "required": ["sub", "role", "exp", "jti", "gen", "iss"],
      "title": "SessionClaims",
      "type": "object"
    }
  },
  "$id": "aap-identity-recovery/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "discriminator": {
        "mapping": {
          "consume_email_verification": "#/$defs/ConsumeEmailVerificationRequest",
          "consume_password_reset": "#/$defs/ConsumePasswordResetRequest",
          "register_open": "#/$defs/RegisterOpenRequest",
          "request_password_reset": "#/$defs/RequestPasswordResetRequest",
          "resend_email_verification": "#/$defs/ResendEmailVerificationRequest"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RegisterOpenRequest"
        },
        {
          "$ref": "#/$defs/RequestPasswordResetRequest"
        },
        {
          "$ref": "#/$defs/ResendEmailVerificationRequest"
        },
        {
          "$ref": "#/$defs/ConsumePasswordResetRequest"
        },
        {
          "$ref": "#/$defs/ConsumeEmailVerificationRequest"
        }
      ]
    },
    {
      "$ref": "#/$defs/RecoverySuccess"
    },
    {
      "$ref": "#/$defs/RecoveryFailureReply"
    }
  ]
}
