        },
        "expected_key_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Key Hash"
        },
        "new_key": {
          "title": "New Key",
          "type": "null"
        },
        "operation": {
          "const": "update_api_key",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
