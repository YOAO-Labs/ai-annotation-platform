{
  "$defs": {
    "CreateKeyPayload": {
      "additionalProperties": false,
      "properties": {
        "expires_in_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires In Days"
        },
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": ["name"],
      "title": "CreateKeyPayload",
      "type": "object"
    },
    "EmptyPayload": {
      "additionalProperties": false,
      "properties": {},
      "title": "EmptyPayload",
      "type": "object"
    },
    "KeyFailureDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "enum": [
                "invalid_request",
                "credential_invalid",
                "credential_revoked",
                "generation_outdated",
                "token_expired",
                "user_inactive",
                "invalid_account_role",
                "credential_busy"
              ],
              "type": "string"
            },
            {
              "enum": ["key_not_found", "key_busy", "operation_conflict"],
              "type": "string"
            }
          ],
          "title": "Code"
        }
      },
      "required": ["code"],
      "title": "KeyFailureDetail",
      "type": "object"
    },
    "KeyPatch": {
      "additionalProperties": false,
      "properties": {
        "expires_in_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires In Days"
        },
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "title": "KeyPatch",
      "type": "object"
    },
    "KeyRecord": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "key_prefix": {
          "pattern": "^ak_[A-Za-z0-9_-]{9}$",
          "title": "Key Prefix",
          "type": "string"
        },
        "last_used_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Used At"
        },
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revoked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revoked At"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "key_prefix",
        "scopes",
        "expires_at",
        "last_used_at",
        "revoked_at",
        "created_at"
      ],
      "title": "KeyRecord",
      "type": "object"
    },
    "NativeCreateCommand": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Principal"
        },
        "expected_key_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Key Hash"
        },
        "new_key": {
          "$ref": "#/$defs/NewKey"
        },
        "operation": {
          "const": "create_api_key",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/CreateKeyPayload"
        },
        "schema": {
          "const": "aap-identity-keys-native/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "operation_id",
        "actor",
        "expected_key_hash",
        "operation",
        "payload",
        "new_key"
      ],
      "title": "NativeCreateCommand",
      "type": "object"
    },
    "NativeCreateReply": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/NativeKeyRecordData"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "operation": {
          "const": "create_api_key",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "schema": {
          "const": "aap-identity-keys-native/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "operation_id", "principal", "operation", "data"],
      "title": "NativeCreateReply",
      "type": "object"
    },
    "NativeKeyFailureReply": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/KeyFailureDetail"
        },
        "ok": {
          "const": false,
          "title": "Ok",
          "type": "boolean"
        },
        "schema": {
          "const": "aap-identity-keys-native/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "error"],
      "title": "NativeKeyFailureReply",
      "type": "object"
    },
    "NativeKeyListData": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/KeyRecord"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": ["items"],
      "title": "NativeKeyListData",
      "type": "object"
    },
    "NativeKeyRecordData": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/KeyRecord"
        }
      },
      "required": ["key"],
      "title": "NativeKeyRecordData",
      "type": "object"
    },
    "NativeKeyRevokedData": {
      "additionalProperties": false,
      "properties": {
        "key_id": {
          "format": "uuid",
          "title": "Key Id",
          "type": "string"
        },
        "revoked": {
          "const": true,
          "title": "Revoked",
          "type": "boolean"
        }
      },
      "required": ["key_id", "revoked"],
      "title": "NativeKeyRevokedData",
      "type": "object"
    },
    "NativeListCommand": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Principal"
        },
        "expected_key_hash": {
