      },
      "required": ["schema", "ok", "operation_id", "principal", "operation", "data"],
      "title": "NativeUpdateReply",
      "type": "object"
    },
    "NewKey": {
      "additionalProperties": false,
      "properties": {
        "derivation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Derivation Id",
          "type": "string"
        },
        "key_hash": {
          "pattern": "^\\$2[aby]\\$12\\$[./A-Za-z0-9]{53}$",
          "title": "Key Hash",
          "type": "string"
        },
        "key_id": {
          "format": "uuid",
          "title": "Key Id",
          "type": "string"
        },
        "key_prefix": {
          "pattern": "^ak_[A-Za-z0-9_-]{9}$",
          "title": "Key Prefix",
          "type": "string"
        }
      },
      "required": ["key_id", "key_prefix", "key_hash", "derivation_id"],
      "title": "NewKey",
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "credential_type": {
                  "const": "jwt"
                },
                "expires_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "generation": {
                  "exclusiveMaximum": 9223372036854775808,
                  "minimum": 0,
                  "type": "integer"
                },
                "scopes": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "credential_type": {
                  "const": "api_key"
                },
                "generation": {
                  "type": "null"
                },
                "scopes": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            }
          ]
        }
      ],
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "credential_id": {
          "format": "uuid",
          "title": "Credential Id",
          "type": "string"
        },
        "credential_type": {
          "enum": ["jwt", "api_key"],
          "title": "Credential Type",
          "type": "string"
        },
        "email": {
          "title": "Email",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "generation": {
          "anyOf": [
            {
              "exclusiveMaximum": 9223372036854775808,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generation"
        },
        "is_active": {
          "const": true,
          "title": "Is Active",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "enum": ["super_admin", "project_admin", "employee", "viewer"],
          "title": "Role",
          "type": "string"
        },
        "scopes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scopes"
        }
      },
      "required": [
        "actor_id",
        "name",
        "email",
        "role",
        "is_active",
        "credential_type",
        "credential_id",
        "generation",
        "scopes",
        "expires_at"
      ],
      "title": "Principal",
      "type": "object"
    },
    "TargetKeyPayload": {
      "additionalProperties": false,
      "properties": {
        "key_id": {
          "format": "uuid",
          "title": "Key Id",
          "type": "string"
        }
      },
      "required": ["key_id"],
      "title": "TargetKeyPayload",
      "type": "object"
    },
    "UpdateKeyPayload": {
      "additionalProperties": false,
      "properties": {
        "key_id": {
          "format": "uuid",
          "title": "Key Id",
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/KeyPatch"
        }
      },
      "required": ["key_id", "patch"],
      "title": "UpdateKeyPayload",
      "type": "object"
    }
  },
  "$id": "aap-identity-keys-native/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "discriminator": {
        "mapping": {
          "create_api_key": "#/$defs/NativeCreateCommand",
          "list_api_keys": "#/$defs/NativeListCommand",
          "revoke_api_key": "#/$defs/NativeRevokeCommand",
          "rotate_api_key": "#/$defs/NativeRotateCommand",
          "update_api_key": "#/$defs/NativeUpdateCommand"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NativeListCommand"
        },
        {
          "$ref": "#/$defs/NativeCreateCommand"
        },
        {
          "$ref": "#/$defs/NativeUpdateCommand"
        },
        {
          "$ref": "#/$defs/NativeRotateCommand"
        },
        {
          "$ref": "#/$defs/NativeRevokeCommand"
        }
      ]
    },
    {
      "discriminator": {
        "mapping": {
          "create_api_key": "#/$defs/NativeCreateReply",
          "list_api_keys": "#/$defs/NativeListReply",
          "revoke_api_key": "#/$defs/NativeRevokeReply",
          "rotate_api_key": "#/$defs/NativeRotateReply",
          "update_api_key": "#/$defs/NativeUpdateReply"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NativeListReply"
        },
        {
          "$ref": "#/$defs/NativeCreateReply"
        },
        {
          "$ref": "#/$defs/NativeUpdateReply"
        },
        {
          "$ref": "#/$defs/NativeRotateReply"
        },
        {
          "$ref": "#/$defs/NativeRevokeReply"
        }
      ]
    },
    {
      "$ref": "#/$defs/NativeKeyFailureReply"
    }
  ]
}
