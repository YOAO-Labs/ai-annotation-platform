    },
    "NativeUpdateReply": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/NativeKeyRecordData"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "operation": {
          "const": "update_api_key",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "schema": {
          "const": "aap-identity-keys-native/v1",
          "title": "Schema",
