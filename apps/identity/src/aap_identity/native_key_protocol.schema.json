        },
        "operation": {
          "const": "list_api_keys",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/EmptyPayload"
        },
        "schema": {
          "const": "aap-identity-keys-native/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "operation_id",
        "actor",
        "expected_key_hash",
        "operation",
        "payload",
        "new_key"
      ],
      "title": "NativeListCommand",
      "type": "object"
    },
    "NativeListReply": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/NativeKeyListData"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "operation": {
          "const": "list_api_keys",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "schema": {
          "const": "aap-identity-keys-native/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "operation_id", "principal", "operation", "data"],
      "title": "NativeListReply",
      "type": "object"
    },
    "NativeRevokeCommand": {
