        },
        "expected_key_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Key Hash"
        },
        "new_key": {
          "$ref": "#/$defs/NewKey"
        },
        "operation": {
          "const": "rotate_api_key",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
