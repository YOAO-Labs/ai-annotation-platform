{
  "$defs": {
    "DeleteAccountRequest": {
      "additionalProperties": false,
      "properties": {
        "audit_context": {
          "$ref": "#/$defs/SessionAuditContext"
        },
        "operation": {
          "const": "delete_account",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/DeletionPayload"
        },
        "schema": {
          "const": "aap-identity-deletions/v1",
          "title": "Schema",
          "type": "string"
        },
        "token": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Token",
          "type": "string"
        }
      },
      "required": ["schema", "operation_id", "token", "audit_context", "operation", "payload"],
      "title": "DeleteAccountRequest",
      "type": "object"
    },
    "DeletionData": {
      "additionalProperties": false,
      "properties": {
        "user": {
          "$ref": "#/$defs/DirectoryUserRecord"
        }
      },
      "required": ["user"],
      "title": "DeletionData",
      "type": "object"
    },
    "DeletionFailureDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "enum": [
                "invalid_request",
                "credential_invalid",
                "credential_revoked",
                "generation_outdated",
                "token_expired",
                "user_inactive",
                "invalid_account_role",
                "credential_busy"
              ],
              "type": "string"
            },
            {
              "enum": [
                "manager_required",
                "target_not_found",
                "self_delete",
                "delete_role_forbidden",
                "delete_scope_forbidden",
                "last_super_admin",
                "has_pending_tasks",
                "receiver_unavailable",
                "receiver_is_target",
                "receiver_role_invalid",
                "receiver_scope_forbidden",
                "account_busy",
                "project_busy",
                "operation_conflict",
                "unavailable"
              ],
              "type": "string"
            }
          ],
          "title": "Code"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ProjectBusyDetail"
            },
            {
              "$ref": "#/$defs/PendingTasksDetail"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        },
        "status_code": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 400,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status Code"
        }
      },
      "required": ["code", "status_code", "detail"],
      "title": "DeletionFailureDetail",
      "type": "object"
    },
    "DeletionFailureReply": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/DeletionFailureDetail"
        },
        "ok": {
          "const": false,
          "title": "Ok",
          "type": "boolean"
        },
        "schema": {
          "const": "aap-identity-deletions/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "error"],
      "title": "DeletionFailureReply",
      "type": "object"
    },
    "DeletionPayload": {
      "additionalProperties": false,
      "properties": {
        "target_user_id": {
          "format": "uuid",
          "title": "Target User Id",
          "type": "string"
        },
        "transfer_to_user_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transfer To User Id"
        }
      },
      "required": ["target_user_id", "transfer_to_user_id"],
      "title": "DeletionPayload",
      "type": "object"
    },
    "DirectoryUserRecord": {
      "additionalProperties": false,
      "description": "The exact public UserOut projection, with historical role/status strings.",
      "properties": {
        "avatar_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Avatar Ref"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deactivation_requested_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deactivation Requested At"
        },
        "deactivation_scheduled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deactivation Scheduled At"
        },
        "disabled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disabled At"
        },
        "disabled_by": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disabled By"
        },
        "disabled_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disabled Kind"
        },
        "disabled_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disabled Reason"
        },
        "email": {
          "title": "Email",
          "type": "string"
        },
        "email_verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Email Verified At"
        },
        "group_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Group Id"
        },
        "group_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Group Name"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "is_active": {
          "title": "Is Active",
          "type": "boolean"
        },
        "last_login_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Login At"
        },
        "last_seen_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Seen At"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "password_admin_reset_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Password Admin Reset At"
        },
        "preferences": {
          "additionalProperties": true,
          "title": "Preferences",
          "type": "object"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "email",
        "name",
        "role",
        "group_name",
        "group_id",
        "status",
        "is_active",
        "disabled_kind",
        "disabled_at",
        "disabled_by",
        "disabled_reason",
        "email_verified_at",
        "last_login_at",
        "last_seen_at",
        "password_admin_reset_at",
        "deactivation_requested_at",
        "deactivation_scheduled_at",
        "preferences",
        "avatar_ref",
        "created_at"
      ],
      "title": "DirectoryUserRecord",
      "type": "object"
    },
    "PendingTasksDetail": {
      "additionalProperties": false,
      "properties": {
        "locked_task_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Locked Task Count",
          "type": "integer"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "pending_task_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Pending Task Count",
          "type": "integer"
        },
        "reason": {
          "const": "has_pending_tasks",
          "title": "Reason",
          "type": "string"
        },
        "sample_task_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 5,
          "title": "Sample Task Ids",
          "type": "array"
        }
      },
      "required": [
        "reason",
        "pending_task_count",
        "locked_task_count",
        "sample_task_ids",
        "message"
      ],
      "title": "PendingTasksDetail",
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "credential_type": {
                  "const": "jwt"
                },
                "expires_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "generation": {
                  "exclusiveMaximum": 9223372036854775808,
                  "minimum": 0,
                  "type": "integer"
                },
                "scopes": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "credential_type": {
                  "const": "api_key"
                },
                "generation": {
                  "type": "null"
                },
                "scopes": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            }
          ]
        }
      ],
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "credential_id": {
          "format": "uuid",
          "title": "Credential Id",
          "type": "string"
        },
        "credential_type": {
          "enum": ["jwt", "api_key"],
          "title": "Credential Type",
          "type": "string"
        },
        "email": {
          "title": "Email",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "generation": {
          "anyOf": [
            {
              "exclusiveMaximum": 9223372036854775808,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generation"
        },
        "is_active": {
          "const": true,
          "title": "Is Active",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "enum": ["super_admin", "project_admin", "employee", "viewer"],
          "title": "Role",
          "type": "string"
        },
        "scopes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scopes"
        }
      },
      "required": [
        "actor_id",
        "name",
        "email",
        "role",
        "is_active",
        "credential_type",
        "credential_id",
        "generation",
        "scopes",
        "expires_at"
      ],
      "title": "Principal",
      "type": "object"
    },
    "ProjectBusyDetail": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "const": "project_busy",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": ["reason"],
      "title": "ProjectBusyDetail",
      "type": "object"
    },
    "SessionAuditContext": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ip"
        },
        "method": {
          "anyOf": [
            {
              "maxLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Method"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 36,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Request Id"
        }
      },
      "required": ["method", "path", "ip", "request_id"],
      "title": "SessionAuditContext",
      "type": "object"
    },
    "_WireSuccess": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/DeletionData"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "operation": {
          "const": "delete_account",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "schema": {
          "const": "aap-identity-deletions/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "operation", "operation_id", "principal", "data"],
      "title": "_WireSuccess",
      "type": "object"
    }
  },
  "$id": "aap-identity-deletions/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/DeleteAccountRequest"
    },
    {
      "$ref": "#/$defs/_WireSuccess"
    },
    {
      "$ref": "#/$defs/DeletionFailureReply"
    }
  ]
}
