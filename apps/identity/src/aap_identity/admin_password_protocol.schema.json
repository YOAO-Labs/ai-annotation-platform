    "_WireReplyBase": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/AdminPasswordSuccessData"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "operation": {
          "const": "admin_reset_password",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "schema": {
          "const": "aap-identity-admin-passwords/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "operation", "operation_id", "principal", "data"],
      "title": "_WireReplyBase",
      "type": "object"
    },
    "_WireRequestBase": {
      "additionalProperties": false,
      "properties": {
        "audit_context": {
          "$ref": "#/$defs/SessionAuditContext"
        },
        "operation": {
          "const": "admin_reset_password",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/AdminPasswordPayload"
        },
        "schema": {
          "const": "aap-identity-admin-passwords/v1",
          "title": "Schema",
          "type": "string"
        },
        "token": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Token",
          "type": "string"
        }
      },
      "required": ["schema", "operation", "operation_id", "token", "audit_context", "payload"],
      "title": "_WireRequestBase",
      "type": "object"
    }
  },
  "$id": "aap-identity-admin-passwords/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/_WireRequestBase"
    },
    {
      "$ref": "#/$defs/_WireReplyBase"
    },
    {
      "$ref": "#/$defs/AdminPasswordFailureReply"
    }
  ]
}
