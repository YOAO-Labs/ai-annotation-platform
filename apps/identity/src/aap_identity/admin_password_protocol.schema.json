{
  "$defs": {
    "AdminPasswordFailureDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "enum": [
                "invalid_request",
                "credential_invalid",
                "credential_revoked",
                "generation_outdated",
                "token_expired",
                "user_inactive",
                "invalid_account_role",
                "credential_busy"
              ],
              "type": "string"
            },
            {
              "enum": [
                "manager_required",
                "target_not_found",
                "self_reset",
                "role_forbidden",
                "target_out_of_scope",
                "account_busy",
                "operation_conflict",
                "unavailable"
              ],
              "type": "string"
            }
          ],
          "title": "Code"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        },
        "status_code": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 400,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status Code"
        }
      },
      "required": ["code", "status_code", "detail"],
      "title": "AdminPasswordFailureDetail",
      "type": "object"
    },
    "AdminPasswordFailureReply": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/AdminPasswordFailureDetail"
        },
        "ok": {
          "const": false,
          "title": "Ok",
          "type": "boolean"
        },
        "schema": {
          "const": "aap-identity-admin-passwords/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "error"],
      "title": "AdminPasswordFailureReply",
      "type": "object"
    },
    "AdminPasswordPayload": {
      "additionalProperties": false,
      "properties": {
        "target_user_id": {
          "format": "uuid",
          "title": "Target User Id",
          "type": "string"
        }
      },
      "required": ["target_user_id"],
      "title": "AdminPasswordPayload",
      "type": "object"
    },
    "AdminPasswordSuccessData": {
      "additionalProperties": false,
      "properties": {
        "password_admin_reset_at": {
          "format": "date-time",
          "title": "Password Admin Reset At",
          "type": "string"
        },
        "target_email": {
          "title": "Target Email",
          "type": "string"
        },
        "target_user_id": {
          "format": "uuid",
          "title": "Target User Id",
          "type": "string"
        },
        "temp_password": {
          "maxLength": 16,
          "minLength": 16,
          "title": "Temp Password",
          "type": "string"
        }
      },
      "required": ["target_user_id", "target_email", "temp_password", "password_admin_reset_at"],
      "title": "AdminPasswordSuccessData",
      "type": "object"
    },
    "Principal": {
