                "generation": {
                  "exclusiveMaximum": 9223372036854775808,
                  "minimum": 0,
                  "type": "integer"
                },
                "scopes": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "credential_type": {
                  "const": "api_key"
                },
                "generation": {
                  "type": "null"
                },
                "scopes": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            }
          ]
        }
      ],
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "credential_id": {
          "format": "uuid",
          "title": "Credential Id",
          "type": "string"
        },
        "credential_type": {
          "enum": ["jwt", "api_key"],
          "title": "Credential Type",
          "type": "string"
        },
        "email": {
          "title": "Email",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "generation": {
          "anyOf": [
            {
              "exclusiveMaximum": 9223372036854775808,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generation"
        },
        "is_active": {
          "const": true,
          "title": "Is Active",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "enum": ["super_admin", "project_admin", "employee", "viewer"],
          "title": "Role",
          "type": "string"
        },
        "scopes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scopes"
        }
      },
      "required": [
        "actor_id",
        "name",
        "email",
        "role",
        "is_active",
        "credential_type",
        "credential_id",
        "generation",
        "scopes",
        "expires_at"
      ],
      "title": "Principal",
      "type": "object"
    },
    "SessionAuditContext": {
      "additionalProperties": false,
      "properties": {
