{
  "$defs": {
    "AccountRecord": {
      "additionalProperties": false,
      "properties": {
        "avatar_ref": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Avatar Ref"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deactivation_requested_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deactivation Requested At"
        },
        "deactivation_scheduled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deactivation Scheduled At"
        },
        "disabled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disabled At"
        },
        "disabled_by": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disabled By"
        },
        "disabled_kind": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disabled Kind"
        },
        "disabled_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disabled Reason"
        },
        "email": {
          "maxLength": 255,
          "title": "Email",
          "type": "string"
        },
        "email_verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Email Verified At"
        },
        "group_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Group Id"
        },
        "group_name": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Group Name"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "is_active": {
          "title": "Is Active",
          "type": "boolean"
        },
        "last_login_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Login At"
        },
        "last_seen_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Seen At"
        },
        "name": {
          "maxLength": 100,
          "title": "Name",
          "type": "string"
        },
        "password_admin_reset_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Password Admin Reset At"
        },
        "preferences": {
          "additionalProperties": true,
          "title": "Preferences",
          "type": "object"
        },
        "role": {
          "enum": ["super_admin", "project_admin", "employee", "viewer"],
          "title": "Role",
          "type": "string"
        },
        "status": {
          "maxLength": 20,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "email",
        "name",
        "role",
        "group_name",
        "group_id",
        "status",
        "is_active",
        "disabled_kind",
        "disabled_at",
        "disabled_by",
        "disabled_reason",
        "email_verified_at",
        "last_login_at",
        "last_seen_at",
        "password_admin_reset_at",
        "deactivation_requested_at",
        "deactivation_scheduled_at",
        "preferences",
        "avatar_ref",
        "created_at"
      ],
      "title": "AccountRecord",
      "type": "object"
    },
    "CancelDeactivationPayload": {
      "additionalProperties": false,
      "properties": {},
      "title": "CancelDeactivationPayload",
      "type": "object"
    },
    "CancelDeactivationReply": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/DeactivationResultData"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "operation": {
          "const": "cancel_self_deactivation",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "schema": {
          "const": "aap-identity-deactivation/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "operation_id", "principal", "operation", "data"],
      "title": "CancelDeactivationReply",
      "type": "object"
    },
    "CancelDeactivationRequest": {
      "additionalProperties": false,
      "properties": {
        "audit_context": {
          "$ref": "#/$defs/SessionAuditContext"
        },
        "operation": {
          "const": "cancel_self_deactivation",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/CancelDeactivationPayload"
        },
        "schema": {
          "const": "aap-identity-deactivation/v1",
          "title": "Schema",
          "type": "string"
        },
        "token": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Token",
          "type": "string"
        }
      },
      "required": ["schema", "operation_id", "token", "audit_context", "operation", "payload"],
      "title": "CancelDeactivationRequest",
      "type": "object"
    },
    "DeactivationFailureDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "enum": [
                "invalid_request",
                "credential_invalid",
                "credential_revoked",
                "generation_outdated",
                "token_expired",
                "user_inactive",
                "invalid_account_role",
                "credential_busy"
              ],
              "type": "string"
            },
            {
              "enum": ["account_busy", "invariant_busy", "operation_conflict", "policy_rejected"],
              "type": "string"
            }
          ],
          "title": "Code"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        },
        "status_code": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 400,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status Code"
        }
      },
      "required": ["code", "status_code", "detail"],
      "title": "DeactivationFailureDetail",
      "type": "object"
    },
    "DeactivationFailureReply": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/DeactivationFailureDetail"
        },
        "ok": {
          "const": false,
          "title": "Ok",
          "type": "boolean"
        },
        "schema": {
          "const": "aap-identity-deactivation/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "error"],
      "title": "DeactivationFailureReply",
      "type": "object"
    },
    "DeactivationResultData": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountRecord"
        }
      },
      "required": ["account"],
      "title": "DeactivationResultData",
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "credential_type": {
                  "const": "jwt"
                },
                "expires_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "generation": {
                  "exclusiveMaximum": 9223372036854775808,
                  "minimum": 0,
                  "type": "integer"
                },
                "scopes": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "credential_type": {
                  "const": "api_key"
                },
                "generation": {
                  "type": "null"
                },
                "scopes": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            }
          ]
        }
      ],
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "credential_id": {
          "format": "uuid",
          "title": "Credential Id",
          "type": "string"
        },
        "credential_type": {
          "enum": ["jwt", "api_key"],
          "title": "Credential Type",
          "type": "string"
        },
        "email": {
          "title": "Email",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "generation": {
          "anyOf": [
            {
              "exclusiveMaximum": 9223372036854775808,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generation"
        },
        "is_active": {
          "const": true,
          "title": "Is Active",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "enum": ["super_admin", "project_admin", "employee", "viewer"],
          "title": "Role",
          "type": "string"
        },
        "scopes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scopes"
        }
      },
      "required": [
        "actor_id",
        "name",
        "email",
        "role",
        "is_active",
        "credential_type",
        "credential_id",
        "generation",
        "scopes",
        "expires_at"
      ],
      "title": "Principal",
      "type": "object"
    },
    "RequestDeactivationPayload": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        }
      },
      "required": ["reason"],
      "title": "RequestDeactivationPayload",
      "type": "object"
    },
    "RequestDeactivationReply": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/DeactivationResultData"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "operation": {
          "const": "request_self_deactivation",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "schema": {
          "const": "aap-identity-deactivation/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "operation_id", "principal", "operation", "data"],
      "title": "RequestDeactivationReply",
      "type": "object"
    },
    "RequestDeactivationRequest": {
      "additionalProperties": false,
      "properties": {
        "audit_context": {
          "$ref": "#/$defs/SessionAuditContext"
        },
        "operation": {
          "const": "request_self_deactivation",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/RequestDeactivationPayload"
        },
        "schema": {
          "const": "aap-identity-deactivation/v1",
          "title": "Schema",
          "type": "string"
        },
        "token": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Token",
          "type": "string"
        }
      },
      "required": ["schema", "operation_id", "token", "audit_context", "operation", "payload"],
      "title": "RequestDeactivationRequest",
      "type": "object"
    },
    "SessionAuditContext": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ip"
        },
        "method": {
          "anyOf": [
            {
              "maxLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Method"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 36,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Request Id"
        }
      },
      "required": ["method", "path", "ip", "request_id"],
      "title": "SessionAuditContext",
      "type": "object"
    }
  },
  "$id": "aap-identity-deactivation/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "discriminator": {
        "mapping": {
          "cancel_self_deactivation": "#/$defs/CancelDeactivationRequest",
          "request_self_deactivation": "#/$defs/RequestDeactivationRequest"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RequestDeactivationRequest"
        },
        {
          "$ref": "#/$defs/CancelDeactivationRequest"
        }
      ]
    },
    {
      "discriminator": {
        "mapping": {
          "cancel_self_deactivation": "#/$defs/CancelDeactivationReply",
          "request_self_deactivation": "#/$defs/RequestDeactivationReply"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RequestDeactivationReply"
        },
        {
          "$ref": "#/$defs/CancelDeactivationReply"
        }
      ]
    },
    {
      "$ref": "#/$defs/DeactivationFailureReply"
    }
  ]
}
