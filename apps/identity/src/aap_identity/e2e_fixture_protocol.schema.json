{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aap-identity-e2e-fixtures/v1",
  "$comment": "Fixed capabilities for existing guarded E2E fixture routes. These functions accept no arbitrary SQL, table, or predicate selectors.",
  "$defs": {
    "FixtureAccountProfile": {
      "additionalProperties": false,
      "properties": {
        "id": { "format": "uuid", "title": "Id", "type": "string" },
        "email": { "title": "Email", "type": "string" },
        "name": { "title": "Name", "type": "string" },
        "role": { "title": "Role", "type": "string" },
        "group_name": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "title": "Group Name"
        },
        "group_id": {
          "anyOf": [
            { "format": "uuid", "type": "string" },
            { "type": "null" }
          ],
          "title": "Group Id"
        },
        "status": { "title": "Status", "type": "string" },
        "is_active": { "title": "Is Active", "type": "boolean" },
        "disabled_kind": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "title": "Disabled Kind"
        },
        "disabled_at": {
          "anyOf": [
            { "format": "date-time", "type": "string" },
            { "type": "null" }
          ],
          "title": "Disabled At"
        },
        "disabled_by": {
          "anyOf": [
            { "format": "uuid", "type": "string" },
            { "type": "null" }
          ],
          "title": "Disabled By"
        },
        "disabled_reason": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "title": "Disabled Reason"
        },
        "email_verified_at": {
          "anyOf": [
            { "format": "date-time", "type": "string" },
            { "type": "null" }
          ],
          "title": "Email Verified At"
        },
        "last_login_at": {
          "anyOf": [
            { "format": "date-time", "type": "string" },
            { "type": "null" }
          ],
          "title": "Last Login At"
        },
        "last_seen_at": {
          "anyOf": [
            { "format": "date-time", "type": "string" },
            { "type": "null" }
          ],
          "title": "Last Seen At"
        },
        "password_admin_reset_at": {
          "anyOf": [
            { "format": "date-time", "type": "string" },
            { "type": "null" }
          ],
          "title": "Password Admin Reset At"
        },
        "deactivation_requested_at": {
          "anyOf": [
            { "format": "date-time", "type": "string" },
            { "type": "null" }
          ],
          "title": "Deactivation Requested At"
        },
        "deactivation_scheduled_at": {
          "anyOf": [
            { "format": "date-time", "type": "string" },
            { "type": "null" }
          ],
          "title": "Deactivation Scheduled At"
        },
        "preferences": {
          "additionalProperties": true,
          "title": "Preferences",
          "type": "object"
        },
        "avatar_ref": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "title": "Avatar Ref"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "email",
        "name",
        "role",
        "group_name",
        "group_id",
        "status",
        "is_active",
        "disabled_kind",
        "disabled_at",
        "disabled_by",
        "disabled_reason",
        "email_verified_at",
        "last_login_at",
        "last_seen_at",
        "password_admin_reset_at",
        "deactivation_requested_at",
        "deactivation_scheduled_at",
        "preferences",
        "avatar_ref",
        "created_at"
      ],
      "title": "FixtureAccountProfile",
      "type": "object"
    },
    "FixtureInvitation": {
      "additionalProperties": false,
      "properties": {
        "id": { "format": "uuid", "title": "Id", "type": "string" },
        "email": { "title": "Email", "type": "string" },
        "role": { "title": "Role", "type": "string" },
        "project_role": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Project Role"
        },
        "group_name": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Group Name"
        },
        "project_id": {
          "anyOf": [
            { "format": "uuid", "type": "string" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Project Id"
        },
        "token": { "title": "Token", "type": "string" },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "invited_by": {
          "format": "uuid",
          "title": "Invited By",
          "type": "string"
        },
        "accepted_at": {
          "anyOf": [
            { "format": "date-time", "type": "string" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Accepted At"
        },
        "accepted_user_id": {
          "anyOf": [
            { "format": "uuid", "type": "string" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Accepted User Id"
        },
        "revoked_at": {
          "anyOf": [
            { "format": "date-time", "type": "string" },
            { "type": "null" }
          ],
          "default": null,
          "title": "Revoked At"
        }
      },
      "required": ["id", "email", "role", "token", "expires_at", "invited_by"],
      "title": "FixtureInvitation",
      "type": "object"
    }
  },
  "anyOf": [
    { "$ref": "#/$defs/FixtureAccountProfile" },
    { "$ref": "#/$defs/FixtureInvitation" }
  ],
  "x-native-capabilities": {
    "protocol": "aap-identity-e2e-fixtures/v1",
    "postgres_schema": "aap_identity_fixture_v1",
    "functions": [
      {
        "name": "create_account",
        "signature": "aap_identity_fixture_v1.create_account(uuid, text, text, text, text)",
        "arguments": [
          {
            "name": "p_id",
            "postgres_type": "uuid",
            "json_schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "p_email",
            "postgres_type": "text",
            "json_schema": { "type": "string" }
          },
          {
            "name": "p_name",
            "postgres_type": "text",
            "json_schema": { "type": "string" }
          },
          {
            "name": "p_password_hash",
            "postgres_type": "text",
            "json_schema": { "type": "string" }
          },
          {
            "name": "p_role",
            "postgres_type": "text",
            "json_schema": { "type": "string" }
          }
        ],
        "result_postgres_type": "uuid",
        "result_json_schema": { "type": "string", "format": "uuid" },
        "volatility": "VOLATILE",
        "transaction_semantics": "Insert one User with the exact fixture factory defaults: credential_generation 0, active true, offline status, empty preferences, and NULL for other nullable fields. Role and supplied values are not normalized or subject to account policy. Duplicate and native constraint errors propagate. created_at uses the database default. The caller owns the transaction."
      },
      {
        "name": "mark_manual_inactive",
        "signature": "aap_identity_fixture_v1.mark_manual_inactive(uuid, timestamptz, uuid)",
        "arguments": [
          {
            "name": "p_id",
            "postgres_type": "uuid",
            "json_schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "p_disabled_at",
            "postgres_type": "timestamptz",
            "json_schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "p_disabled_by",
            "postgres_type": "uuid",
            "json_schema": { "type": "string", "format": "uuid" }
          }
        ],
        "result_postgres_type": "integer",
        "result_json_schema": { "type": "integer", "minimum": 0 },
        "volatility": "VOLATILE",
        "transaction_semantics": "Set only is_active=false, status=offline, disabled_kind=manual, disabled_at, and disabled_by for the exact ID. A matching row counts as one even when values are unchanged; a missing ID counts as zero. The UPDATE waits for the normal row lock. No actor policy or other User fields are changed. The caller owns the transaction."
      },
      {
        "name": "create_invitations",
        "signature": "aap_identity_fixture_v1.create_invitations(jsonb)",
        "arguments": [
          {
            "name": "p_invitations",
            "postgres_type": "jsonb",
            "json_schema": {
              "type": "array",
              "items": { "$ref": "#/$defs/FixtureInvitation" }
            }
          }
        ],
        "result_postgres_type": "integer",
        "result_json_schema": { "type": "integer", "minimum": 0 },
        "volatility": "VOLATILE",
        "transaction_semantics": "Insert the supplied closed Invitation records without normalizing roles or checking account/project authority. created_at uses the database default. Invitation field, foreign-key, uniqueness, and cast errors propagate. The caller owns the transaction."
      },
      {
        "name": "delete_accounts",
        "signature": "aap_identity_fixture_v1.delete_accounts(boolean, text[])",
        "arguments": [
          {
            "name": "p_shared",
            "postgres_type": "boolean",
            "json_schema": { "type": "boolean" }
          },
          {
            "name": "p_emails",
            "postgres_type": "text[]",
            "json_schema": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        ],
        "result_postgres_type": "integer",
        "result_json_schema": { "type": "integer", "minimum": 0 },
        "volatility": "VOLATILE",
        "transaction_semantics": "When shared is true, delete Users matching the fixed email LIKE '%@e2e.test' predicate. Otherwise delete only the exact supplied email array. This function adds no generic predicate or dependent-row cleanup. Native FK errors propagate; the caller owns deletion ordering and the transaction."
      },
      {
        "name": "delete_reset_tokens",
        "signature": "aap_identity_fixture_v1.delete_reset_tokens(uuid[])",
        "arguments": [
          {
            "name": "p_user_ids",
            "postgres_type": "uuid[]",
            "json_schema": {
              "type": "array",
              "items": { "type": "string", "format": "uuid" }
            }
          }
        ],
        "result_postgres_type": "integer",
        "result_json_schema": { "type": "integer", "minimum": 0 },
        "volatility": "VOLATILE",
        "transaction_semantics": "Delete only PasswordResetToken rows whose user_id is in the exact supplied UUID array. Return the matched row count; the caller owns the transaction."
      },
      {
        "name": "delete_invitations",
        "signature": "aap_identity_fixture_v1.delete_invitations(uuid[])",
        "arguments": [
          {
            "name": "p_inviter_ids",
            "postgres_type": "uuid[]",
            "json_schema": {
              "type": "array",
              "items": { "type": "string", "format": "uuid" }
            }
          }
        ],
        "result_postgres_type": "integer",
        "result_json_schema": { "type": "integer", "minimum": 0 },
        "volatility": "VOLATILE",
        "transaction_semantics": "Delete only UserInvitation rows whose invited_by is in the exact supplied UUID array. Return the matched row count; the caller owns the transaction."
      },
      {
        "name": "delete_organization_members",
        "signature": "aap_identity_fixture_v1.delete_organization_members(uuid[])",
        "arguments": [
          {
            "name": "p_user_ids",
            "postgres_type": "uuid[]",
            "json_schema": {
              "type": "array",
              "items": { "type": "string", "format": "uuid" }
            }
          }
        ],
        "result_postgres_type": "integer",
        "result_json_schema": { "type": "integer", "minimum": 0 },
        "volatility": "VOLATILE",
        "transaction_semantics": "Delete only organization_members rows whose user_id is in the exact supplied UUID array. Return the matched row count; the caller owns the transaction and cleanup order."
      }
    ],
    "authorization_boundary": "These fixed fixture capabilities check only that the actual database name ends in _test or _e2e. They add no actor, account, project, role, activity, or email authorization policy.",
    "transaction_boundary": "The caller owns the active transaction, commit, rollback, and fixture cleanup ordering. These functions never commit or retry."
  },
  "x-postgresql-relations": {
    "aap_identity_fixture_v1.account_profiles": {
      "columns": [
        "id",
        "email",
        "name",
        "role",
        "group_name",
        "group_id",
        "status",
        "is_active",
        "disabled_kind",
        "disabled_at",
        "disabled_by",
        "disabled_reason",
        "email_verified_at",
        "last_login_at",
        "last_seen_at",
        "password_admin_reset_at",
        "deactivation_requested_at",
        "deactivation_scheduled_at",
        "preferences",
        "avatar_ref",
        "created_at"
      ],
      "row": { "$ref": "#/$defs/FixtureAccountProfile" },
      "row_key": ["id"],
      "read_only": true,
      "security_barrier": true
    }
  }
}
