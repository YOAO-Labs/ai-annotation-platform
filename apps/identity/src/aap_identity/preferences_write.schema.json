    "UIPreferences": {
      "additionalProperties": false,
      "description": "\u5168\u5c40 UI \u504f\u597d\uff08\u5de5\u4f5c\u53f0\u4e4b\u5916\uff09\uff1b\u8ddf\u968f\u8d26\u53f7\u8de8\u8bbe\u5907\u3002\n\n\u4e3b\u9898\u539f\u5148\u53ea\u5b58 localStorage\uff08\u4ec5\u672c\u673a\uff09\uff0c\u5347\u7ea7\u5230\u670d\u52a1\u7aef\u504f\u597d\u540e\u6362\u8bbe\u5907\u767b\u5f55\u5373\u4fdd\u6301\u3002\n'system' = \u8ddf\u968f\u64cd\u4f5c\u7cfb\u7edf prefers-color-scheme\u3002",
      "properties": {
        "changelog_seen_version": {
          "default": "",
          "title": "Changelog Seen Version",
          "type": "string"
        },
        "secondary_bar_hidden": {
          "default": false,
          "title": "Secondary Bar Hidden",
          "type": "boolean"
        },
        "theme": {
          "default": "system",
          "enum": ["light", "dark", "system"],
          "title": "Theme",
          "type": "string"
        }
      },
      "title": "UIPreferences",
      "type": "object"
    },
    "WorkbenchCommonPreferences": {
      "additionalProperties": false,
      "description": "\u8de8\u6a21\u6001\u901a\u7528\u504f\u597d\uff08\u6027\u80fd\u89c2\u6d4b\u7b49\uff09\u3002",
