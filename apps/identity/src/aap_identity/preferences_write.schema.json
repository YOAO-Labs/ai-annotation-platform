    "WorkbenchImagePreferences": {
      "additionalProperties": false,
      "description": "\u56fe\u50cf\u6a21\u6001\u504f\u597d\uff082D \u753b\u5e03\u6e32\u67d3 / \u9876\u70b9\u624b\u67c4\uff09\u3002",
