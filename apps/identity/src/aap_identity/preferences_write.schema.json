        },
        "confirmDelete": {
          "default": "never",
          "enum": ["never", "multi_only", "always"],
          "title": "Confirmdelete",
          "type": "string"
        },
        "crossFrameOverlayEnabled": {
          "default": false,
          "title": "Crossframeoverlayenabled",
          "type": "boolean"
        },
        "crossFrameOverlayK": {
          "default": 1,
          "enum": [0, 1, 3, 5, 7],
          "title": "Crossframeoverlayk",
