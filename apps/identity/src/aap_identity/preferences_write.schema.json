            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "W"
        },
        "x": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "title": "FloatingSelectionState",
      "type": "object"
    },
    "LabelContentByType": {
      "additionalProperties": false,
      "description": "\u6807\u7b7e\u5185\u5bb9\u6309\u6807\u6ce8\u7c7b\u578b\u5206\u6bb5\uff1bclass \u4e09\u6bb5\u6052\u663e\uff0c\u4e0d\u5165\u8868\u3002\n\nsingle=\u56fe\u7247\u624b\u5de5\u6846 / track=\u89c6\u9891\u8f68\u8ff9\u6846 / ai=\u56fe\u7247\u9884\u6d4b\u6846\uff0c\u5404\u6bb5\u53ea\u5217\u8be5\u7c7b\u578b\u6709\u610f\u4e49\u7684\u5b57\u6bb5\u3002\n\u65e7\u6241\u5e73 list \u7531 WorkbenchCommonPreferences \u7684 before validator \u8fc1\u79fb\u4e3a\u672c\u7ed3\u6784\u3002",
      "properties": {
        "ai": {
          "items": {
            "enum": ["source", "score", "id", "attrs"],
            "type": "string"
          },
          "title": "Ai",
          "type": "array"
        },
        "single": {
          "items": {
            "enum": ["id", "attrs"],
            "type": "string"
          },
          "title": "Single",
          "type": "array"
        },
        "track": {
          "items": {
            "enum": ["id", "state", "attrs"],
            "type": "string"
          },
          "title": "Track",
          "type": "array"
        }
      },
      "title": "LabelContentByType",
      "type": "object"
    },
    "NamedWorkspacePreset": {
      "additionalProperties": false,
      "description": "A layout the user explicitly saved, alongside the live per-context snapshot.\n\nSaving is a personal shortcut: the entry records the context it was captured\nin so the client only offers it for the matching work type. The snapshot\nitself reuses the live envelope grammar, so a preset can never describe a\nlayout the workspace could not restore.",
      "properties": {
        "context": {
          "enum": [
            "annotate:image",
            "annotate:video",
            "annotate:3d",
            "review:image",
            "review:video",
            "review:3d"
          ],
          "title": "Context",
          "type": "string"
        },
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schemaVersion": {
          "enum": [1, 2, 3, 4, 5],
          "title": "Schemaversion",
          "type": "integer"
        },
        "snapshot": {
          "$ref": "#/$defs/WorkspaceSnapshot"
        }
      },
      "required": ["schemaVersion", "snapshot", "name", "context"],
      "title": "NamedWorkspacePreset",
      "type": "object"
    },
    "OnboardingPreferences": {
      "additionalProperties": false,
      "description": "Cross-device state for the employee/project start checklist.",
      "properties": {
        "projects": {
          "additionalProperties": {
            "$ref": "#/$defs/OnboardingProjectState"
          },
          "title": "Projects",
          "type": "object"
        }
      },
      "title": "OnboardingPreferences",
      "type": "object"
    },
    "OnboardingProjectState": {
      "additionalProperties": false,
      "description": "Per-user onboarding state for one project's current guide revision.\n\nThis lives in the existing user preferences JSONB so guide dismissal and\nreading progress follows the employee across devices without introducing a\nsecond onboarding table.  ``guide_version`` is supplied by the client from\nthe persisted project guide; a changed guide naturally starts a new state.",
      "properties": {
        "dismissed": {
          "default": false,
          "title": "Dismissed",
          "type": "boolean"
        },
        "guide_read": {
          "default": false,
          "title": "Guide Read",
          "type": "boolean"
        },
        "guide_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Guide Version",
          "type": "string"
        }
      },
      "required": ["guide_version"],
      "title": "OnboardingProjectState",
      "type": "object"
    },
    "PointcloudCameraState": {
      "additionalProperties": false,
      "description": "\u70b9\u4e91\u4e3b\u89c6\u89d2\u5feb\u7167\u3002\u7531\u524d\u7aef OrbitControls \u5199\u5165/\u6062\u590d\u3002",
      "properties": {
        "mode": {
          "default": "orbit",
          "enum": ["orbit", "bev"],
          "title": "Mode",
          "type": "string"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "target": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Target",
          "type": "array"
        },
        "up": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Up",
          "type": "array"
        }
      },
      "required": ["position", "target", "up"],
      "title": "PointcloudCameraState",
      "type": "object"
    },
    "ShortcutBinding": {
      "additionalProperties": false,
      "description": "\u5355\u6761\u7ed3\u6784\u5316\u5feb\u6377\u952e\u7ed1\u5b9a\u3002\n\n``key`` \u662f\u89c4\u8303\u5316\u7684 ``KeyboardEvent.key``\uff1a\u5355\u4e2a\u5b57\u7b26\uff08\u4efb\u610f\u5b57\u7b26\uff0c\u5982 ``/``\uff09\u6216\n\u5c0f\u5199\u547d\u540d\u952e\uff08\u5982 ``arrowright``\uff09\u3002``modifiers`` \u662f\u663e\u5f0f\u4fee\u9970\u952e\u96c6\u5408\uff0c\u5339\u914d\u65f6\u8981\u6c42\n\u5b8c\u5168\u4e00\u81f4\uff08``mod`` = \u5e73\u53f0\u4e3b\u4fee\u9970\u952e\uff0cCtrl/\u2318\uff09\u3002",
      "properties": {
        "key": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^(?:.{1}|[a-z][a-z0-9]{0,31})$",
          "title": "Key",
          "type": "string"
        },
        "modifiers": {
          "items": {
            "enum": ["mod", "alt", "shift"],
            "type": "string"
          },
          "title": "Modifiers",
          "type": "array"
        }
      },
      "required": ["key"],
      "title": "ShortcutBinding",
      "type": "object"
    },
