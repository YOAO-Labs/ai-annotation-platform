        },
        "snapToGrid": {
          "default": false,
          "title": "Snaptogrid",
          "type": "boolean"
        },
        "zoomStepFactor": {
          "default": 1.1,
          "enum": [1.05, 1.1, 1.15, 1.2],
          "title": "Zoomstepfactor",
          "type": "number"
        }
      },
      "title": "WorkbenchImagePreferences",
      "type": "object"
    },
    "WorkbenchLayoutPreferences": {
      "additionalProperties": false,
      "description": "\u5de5\u4f5c\u53f0\u5e03\u5c40\u504f\u597d\u3002\n\n\u540e\u7aef\u53ea\u6821\u9a8c\u7ed3\u6784\uff1b\u9ed8\u8ba4\u503c\u548c PATCH \u5168\u91cf workbench \u5951\u7ea6\u7531\u524d\u7aef\u7ef4\u62a4\u3002",
      "properties": {
        "aiSectionCollapsed": {
          "anyOf": [
            {
              "type": "boolean"
            },
