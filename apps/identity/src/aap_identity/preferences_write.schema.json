        "autoFitOnResize": {
          "default": true,
          "title": "Autofitonresize",
          "type": "boolean"
        },
        "controlPointsSize": {
          "default": 6,
          "maximum": 20,
          "minimum": 2,
          "title": "Controlpointssize",
          "type": "integer"
        },
        "cssImageFilter": {
          "default": "",
          "maxLength": 255,
          "title": "Cssimagefilter",
          "type": "string"
        },
        "fadedOpacity": {
          "default": 0.35,
          "maximum": 0.8,
          "minimum": 0.1,
          "title": "Fadedopacity",
          "type": "number"
        },
        "maskOverlayOpacity": {
          "default": 0.45,
          "maximum": 0.8,
          "minimum": 0.2,
          "title": "Maskoverlayopacity",
          "type": "number"
        },
        "smoothImage": {
          "default": true,
          "title": "Smoothimage",
          "type": "boolean"
        },
        "snapThresholdPx": {
          "default": 8,
          "maximum": 16,
          "minimum": 4,
          "title": "Snapthresholdpx",
