          },
          "maxProperties": 8,
          "propertyNames": {
            "enum": [
              "canvas",
              "task-queue",
              "class-palette",
              "inspector",
              "discussion",
              "ai-task",
              "video-tracker",
              "tri-view",
              "camera-view"
            ]
          },
          "title": "Returns",
          "type": "object"
        },
        "visibilityIntent": {
          "anyOf": [
            {
              "additionalProperties": {
                "enum": ["shown", "hidden"],
                "type": "string"
              },
              "propertyNames": {
                "enum": ["ai-task", "video-tracker", "tri-view", "camera-view"]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visibilityintent"
        }
      },
      "required": ["layout", "returns"],
      "title": "WorkspaceSnapshot",
      "type": "object"
    }
  },
