    "FloatingSelectionState": {
      "additionalProperties": false,
      "description": "\u9009\u4e2d\u6807\u6ce8\u6d6e\u52a8\u4fe1\u606f\u5361\u7684\u4f4d\u7f6e\u3001\u5c3a\u5bf8\u4e0e\u6298\u53e0\u6001(\u8de8\u8bbe\u5907)\u3002\n\n\u4e0e\u8fb9\u680f\u6d6e\u7a97\u4e0d\u540c,\u9009\u4e2d\u5361\u65e0\u300c\u5408\u5e76\u56de\u8fb9\u680f\u300d\u8bed\u4e49,\u6545\u53ea\u6709 collapsed(\u65e0 detached);\n\u663e\u9690\u7531\u9009\u4e2d\u72b6\u6001\u9a71\u52a8,\u8fd9\u91cc\u53ea\u6301\u4e45\u5316\u51e0\u4f55\u4e0e\u6298\u53e0\u3002\u5c3a\u5bf8\u754c\u4e0e FloatingPanelState \u4e00\u81f4\u3002",
      "properties": {
        "collapsed": {
          "default": false,
          "title": "Collapsed",
          "type": "boolean"
        },
        "h": {
          "anyOf": [
            {
              "maximum": 900,
              "minimum": 120,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "H"
        },
        "w": {
          "anyOf": [
            {
              "maximum": 720,
              "minimum": 48,
