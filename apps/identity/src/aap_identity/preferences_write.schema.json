          "type": "integer"
        },
        "rightWidthPct": {
          "default": 15.0,
          "maximum": 35,
          "minimum": 10,
          "title": "Rightwidthpct",
          "type": "number"
        },
        "showAnnotationComments": {
          "default": true,
          "title": "Showannotationcomments",
          "type": "boolean"
