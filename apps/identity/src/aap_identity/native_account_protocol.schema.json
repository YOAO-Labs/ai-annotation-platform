        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "schema": {
          "const": "aap-identity-accounts-native/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "operation", "operation_id", "principal", "data"],
      "title": "NativeAccountReply",
      "type": "object"
    },
    "NativeChangePasswordApplyCommand": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Principal"
        },
        "audit_context": {
          "$ref": "#/$defs/SessionAuditContext"
        },
        "base_value": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Base Value",
          "type": "string"
        },
        "derivation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Derivation Id",
          "type": "string"
        },
        "expected_key_hash": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Key Hash"
        },
        "new_value": {
          "pattern": "^\\$2[aby]\\$12\\$[./A-Za-z0-9]{53}$",
          "title": "New Value",
          "type": "string"
        },
        "operation": {
          "const": "change_password",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "request_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Fingerprint",
          "type": "string"
        },
        "response_preferences": {
          "title": "Response Preferences",
          "type": "null"
        },
        "schema": {
          "const": "aap-identity-accounts-native/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "operation_id",
        "actor",
        "expected_key_hash",
        "request_fingerprint",
        "derivation_id",
        "audit_context",
        "operation",
        "base_value",
        "new_value",
        "response_preferences"
      ],
      "title": "NativeChangePasswordApplyCommand",
      "type": "object"
    },
