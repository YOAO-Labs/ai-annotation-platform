{
  "$defs": {
    "InvitationMailV2Lease": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "exclusiveMaximum": 9223372036854775808,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "email": {
          "maxLength": 255,
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "encryption_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Encryption Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "frontend_base_url": {
          "minLength": 1,
          "title": "Frontend Base Url",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "invitation_id": {
          "format": "uuid",
          "title": "Invitation Id",
          "type": "string"
        },
        "issuer_id": {
          "format": "uuid",
          "title": "Issuer Id",
          "type": "string"
        },
        "lease_expires_at": {
          "format": "date-time",
          "title": "Lease Expires At",
          "type": "string"
        },
        "lease_token": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Lease Token",
          "type": "string"
        },
        "project_member_role": {
          "anyOf": [
            {
              "enum": ["annotator", "reviewer", "viewer"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Project Member Role"
        },
        "project_name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Project Name"
        },
        "purpose": {
          "const": "invitation",
          "title": "Purpose",
          "type": "string"
        },
        "token_ciphertext": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Token Ciphertext",
          "type": "string"
        },
        "token_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Token Hash",
          "type": "string"
        },
        "worker_id": {
          "format": "uuid",
          "title": "Worker Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "email",
        "frontend_base_url",
        "token_hash",
        "token_ciphertext",
        "encryption_id",
        "expires_at",
        "attempt",
        "worker_id",
        "lease_token",
        "lease_expires_at",
        "purpose",
        "issuer_id",
        "invitation_id",
        "project_name",
        "project_member_role"
      ],
      "title": "InvitationMailV2Lease",
      "type": "object"
    },
    "MailV2AcceptedData": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        }
      },
      "required": ["accepted"],
      "title": "MailV2AcceptedData",
      "type": "object"
    },
    "MailV2AcceptedReply": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/MailV2AcceptedData"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "schema": {
          "const": "aap-identity-mail-native/v2",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "data"],
      "title": "MailV2AcceptedReply",
      "type": "object"
    },
    "MailV2ClaimData": {
      "additionalProperties": false,
      "properties": {
        "delivery": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "email_verification": "#/$defs/RecoveryMailV2Lease",
                  "invitation": "#/$defs/InvitationMailV2Lease",
                  "password_reset": "#/$defs/RecoveryMailV2Lease"
                },
                "propertyName": "purpose"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/RecoveryMailV2Lease"
                },
                {
                  "$ref": "#/$defs/InvitationMailV2Lease"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Delivery"
        }
      },
      "required": ["delivery"],
      "title": "MailV2ClaimData",
      "type": "object"
    },
    "MailV2ClaimReply": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/MailV2ClaimData"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "schema": {
          "const": "aap-identity-mail-native/v2",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "data"],
      "title": "MailV2ClaimReply",
      "type": "object"
    },
    "MailV2ClaimRequest": {
      "additionalProperties": false,
      "properties": {
        "delivery_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delivery Id"
        },
        "lease_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Lease Seconds",
          "type": "integer"
        },
        "schema": {
          "const": "aap-identity-mail-native/v2",
          "title": "Schema",
          "type": "string"
        },
        "worker_id": {
          "format": "uuid",
          "title": "Worker Id",
          "type": "string"
        }
      },
      "required": ["schema", "worker_id", "lease_seconds", "delivery_id"],
      "title": "MailV2ClaimRequest",
      "type": "object"
    },
    "MailV2FinishRequest": {
      "additionalProperties": false,
      "properties": {
        "delivery_id": {
          "format": "uuid",
          "title": "Delivery Id",
          "type": "string"
        },
        "lease_token": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Lease Token",
          "type": "string"
        },
        "outcome": {
          "enum": ["delivered", "rejected", "retry", "unknown", "invalid_key"],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "enum": [
            "sent",
            "not_configured",
            "message_invalid",
            "tls_failed",
            "auth_failed",
            "recipient_rejected",
            "sender_rejected",
            "data_rejected",
            "connect_failed",
            "transport_failed",
            "derivation_unavailable"
          ],
          "title": "Reason",
          "type": "string"
        },
        "retry_delay_seconds": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Delay Seconds"
        },
        "schema": {
          "const": "aap-identity-mail-native/v2",
          "title": "Schema",
          "type": "string"
        },
        "worker_id": {
          "format": "uuid",
          "title": "Worker Id",
          "type": "string"
        }
      },
      "required": ["schema", "delivery_id", "worker_id", "lease_token", "outcome", "reason"],
      "title": "MailV2FinishRequest",
      "type": "object"
    },
    "MailV2PolicyReply": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "const": "aap-identity-mail/v2",
          "title": "Policy",
          "type": "string"
        },
        "schema": {
          "const": "aap-identity-mail-policy/v2",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "policy"],
      "title": "MailV2PolicyReply",
      "type": "object"
    },
    "MailV2RenewRequest": {
      "additionalProperties": false,
      "properties": {
        "delivery_id": {
          "format": "uuid",
          "title": "Delivery Id",
          "type": "string"
        },
        "lease_token": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Lease Token",
          "type": "string"
        },
        "schema": {
          "const": "aap-identity-mail-native/v2",
          "title": "Schema",
          "type": "string"
        },
        "worker_id": {
          "format": "uuid",
          "title": "Worker Id",
          "type": "string"
        }
      },
      "required": ["schema", "delivery_id", "worker_id", "lease_token"],
      "title": "MailV2RenewRequest",
      "type": "object"
    },
    "RecoveryMailV2Lease": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "attempt": {
          "exclusiveMaximum": 9223372036854775808,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "email": {
          "maxLength": 255,
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "encryption_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Encryption Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "frontend_base_url": {
          "minLength": 1,
          "title": "Frontend Base Url",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "lease_expires_at": {
          "format": "date-time",
          "title": "Lease Expires At",
          "type": "string"
        },
        "lease_token": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Lease Token",
          "type": "string"
        },
        "purpose": {
          "enum": ["password_reset", "email_verification"],
          "title": "Purpose",
          "type": "string"
        },
        "token_ciphertext": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Token Ciphertext",
          "type": "string"
        },
        "token_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Token Hash",
          "type": "string"
        },
        "worker_id": {
          "format": "uuid",
          "title": "Worker Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "email",
        "frontend_base_url",
        "token_hash",
        "token_ciphertext",
        "encryption_id",
        "expires_at",
        "attempt",
        "worker_id",
        "lease_token",
        "lease_expires_at",
        "purpose",
        "actor_id"
      ],
      "title": "RecoveryMailV2Lease",
      "type": "object"
    }
  },
  "$id": "aap-identity-mail-native/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/MailV2ClaimRequest"
    },
    {
      "$ref": "#/$defs/MailV2RenewRequest"
    },
    {
      "$ref": "#/$defs/MailV2FinishRequest"
    },
    {
      "$ref": "#/$defs/MailV2ClaimReply"
    },
    {
      "$ref": "#/$defs/MailV2AcceptedReply"
    },
    {
      "$ref": "#/$defs/MailV2PolicyReply"
    }
  ]
}
