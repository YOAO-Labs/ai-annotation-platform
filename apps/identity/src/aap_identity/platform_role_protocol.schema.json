      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "enum": [
              "\u4e0d\u80fd\u4fee\u6539\u81ea\u5df1\u7684\u89d2\u8272",
              "\u76ee\u6807\u89d2\u8272\u4e0e\u5f53\u524d\u89d2\u8272\u76f8\u540c",
              "\u4e0d\u80fd\u964d\u7ea7\u6700\u540e\u4e00\u540d\u8d85\u7ea7\u7ba1\u7406\u5458",
              "\u8d26\u53f7\u4ecd\u6301\u6709\u6807\u6ce8/\u8d28\u68c0\u9879\u76ee\u804c\u8d23\uff0c\u8bf7\u5148\u5728\u9879\u76ee\u4e2d\u53d8\u66f4\u804c\u8d23",
