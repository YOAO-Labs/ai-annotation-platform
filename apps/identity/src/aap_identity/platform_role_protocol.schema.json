            ],
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "reason": {
          "const": "platform_role_change_blocked",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": ["reason", "blockers"],
      "title": "PlatformRoleBlockedDetail",
      "type": "object"
