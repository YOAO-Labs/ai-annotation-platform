    "PlatformRoleFailureDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "enum": [
                "invalid_request",
                "credential_invalid",
                "credential_revoked",
                "generation_outdated",
                "token_expired",
                "user_inactive",
                "invalid_account_role",
                "credential_busy"
              ],
              "type": "string"
            },
            {
              "enum": [
                "super_admin_required",
                "target_not_found",
                "invalid_platform_role",
                "self_change",
                "last_super_admin",
                "account_busy",
                "project_busy",
                "platform_role_change_blocked",
                "operation_conflict",
                "unavailable"
              ],
              "type": "string"
