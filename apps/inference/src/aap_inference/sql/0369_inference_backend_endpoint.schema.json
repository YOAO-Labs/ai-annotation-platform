      ],
      "returns": { "kind": "text", "format": "aap-inference-backend-endpoint-snapshot/v1 JSON" },
      "semantics": "Open only catalog-fallback subjects with no route authority; require origin transaction in progress and preserve exact pending endpoint snapshot without comparing committed registry state."
    },
