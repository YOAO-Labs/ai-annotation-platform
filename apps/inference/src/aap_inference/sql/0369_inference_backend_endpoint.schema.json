      "signature": "aap_inference_backend_endpoint_v1.open_stats_endpoint(text,uuid,uuid,text)",
      "language": "sql",
      "volatility": "VOLATILE",
      "arguments": [
        { "name": "p_subject", "type": "text", "nullable": false },
        { "name": "p_registry_id", "type": "uuid", "nullable": false },
        { "name": "p_request_id", "type": "uuid", "nullable": false },
        { "name": "p_authority_json", "type": "text", "nullable": true }
      ],
      "returns": { "kind": "text", "format": "aap-inference-backend-endpoint-snapshot/v1 JSON" },
      "semantics": "Open only stats subjects with no route authority; require origin transaction in progress and preserve exact pending endpoint snapshot without comparing committed registry state."
    },
    {
      "signature": "aap_inference_backend_endpoint_v1.open_backend_read_endpoint(text,uuid,uuid,text)",
      "language": "sql",
      "volatility": "VOLATILE",
      "arguments": [
        { "name": "p_subject", "type": "text", "nullable": false },
        { "name": "p_registry_id", "type": "uuid", "nullable": false },
        { "name": "p_request_id", "type": "uuid", "nullable": false },
        { "name": "p_authority_json", "type": "text", "nullable": true }
      ],
      "returns": { "kind": "text", "format": "aap-inference-backend-endpoint-snapshot/v1 JSON" },
      "semantics": "Open only backend_read subjects with no route authority; require origin transaction in progress and preserve exact pending endpoint snapshot without comparing committed registry state."
    },
    {
      "signature": "aap_inference_backend_endpoint_v1.open_lifecycle_endpoint(text,uuid,uuid,text)",
      "language": "sql",
      "volatility": "VOLATILE",
      "arguments": [
        { "name": "p_subject", "type": "text", "nullable": false },
        { "name": "p_registry_id", "type": "uuid", "nullable": false },
        { "name": "p_request_id", "type": "uuid", "nullable": false },
        { "name": "p_authority_json", "type": "text", "nullable": true }
      ],
      "returns": { "kind": "text", "format": "aap-inference-backend-endpoint-snapshot/v1 JSON" },
      "semantics": "Open lifecycle subjects only with the exact live unload/reload control, current endpoint, and unused request attempt before owner begin; preserve the API caller's pre-I/O commit boundary."
    },
    {
      "signature": "aap_inference_backend_endpoint_v1.open_execution_endpoint(text,uuid,uuid,text)",
      "language": "sql",
      "volatility": "VOLATILE",
      "arguments": [
        { "name": "p_subject", "type": "text", "nullable": false },
        { "name": "p_registry_id", "type": "uuid", "nullable": false },
        { "name": "p_request_id", "type": "uuid", "nullable": false },
        { "name": "p_authority_json", "type": "text", "nullable": true }
      ],
      "returns": { "kind": "text", "format": "aap-inference-backend-endpoint-snapshot/v1 JSON" },
      "semantics": "Open execution subjects only with the exact live route scope, current endpoint, and unused request attempt before owner begin."
    },
    {
      "signature": "aap_inference_backend_endpoint_v1.open_gpu_control_endpoint(text,uuid,uuid,text)",
      "language": "sql",
      "volatility": "VOLATILE",
      "arguments": [
        { "name": "p_subject", "type": "text", "nullable": false },
        { "name": "p_registry_id", "type": "uuid", "nullable": false },
        { "name": "p_request_id", "type": "uuid", "nullable": false },
        { "name": "p_authority_json", "type": "text", "nullable": true }
      ],
      "returns": { "kind": "text", "format": "aap-inference-backend-endpoint-snapshot/v1 JSON" },
      "semantics": "Open GPU-control subjects only with the exact live control, current endpoint, and unused request attempt before owner begin."
    },
    {
      "signature": "aap_inference_backend_endpoint_v1.open_installation_terminal_endpoint(uuid,uuid,text,text,text)",
      "language": "plpgsql",
      "volatility": "VOLATILE",
      "arguments": [
        { "name": "p_registry_id", "type": "uuid", "nullable": false },
        { "name": "p_request_id", "type": "uuid", "nullable": false },
        { "name": "p_request", "type": "text", "nullable": false },
        { "name": "p_preparation", "type": "text", "nullable": false },
        { "name": "p_endpoint_sha256", "type": "text", "nullable": false }
      ],
      "returns": { "kind": "text", "format": "aap-inference-backend-endpoint-snapshot/v1 JSON" },
      "semantics": "Open only the exact authorized, unsettled GPU terminal intent and unchanged endpoint under the current membership and fence."
    },
    {
      "signature": "aap_inference_backend_endpoint_v1.health_backend_row(uuid,boolean)",
      "language": "plpgsql",
      "volatility": "VOLATILE",
      "arguments": [
        { "name": "p_registry_id", "type": "uuid", "nullable": false },
        { "name": "p_for_update", "type": "boolean", "nullable": false }
      ],
      "returns": {
        "kind": "jsonb",
        "properties": [
          "id",
          "state",
          "is_interactive",
          "gpu_resource_id",
          "last_checked_at",
          "health_meta",
          "endpoint_sha256"
        ]
      },
      "semantics": "Caller-UOW read/lock for existing health reconciliation. It returns only a digest of the exact endpoint record, never auth_token."
    },
    {
      "signature": "aap_inference_backend_endpoint_v1.stats_endpoint_rows()",
      "language": "sql",
      "volatility": "STABLE",
      "returns": {
        "kind": "setof jsonb",
        "properties": [
          "registry_id",
          "name",
          "url",
          "state",
          "source",
          "is_interactive",
          "health_meta",
          "created_at"
        ]
      },
      "semantics": "Connected and non-disconnected health/stat selection in created order; no endpoint configuration, credential, or auth grouping key is returned."
    },
    {
      "signature": "aap_inference_backend_endpoint_v1.catalog_endpoint_rows()",
      "language": "sql",
      "volatility": "STABLE",
      "returns": {
        "kind": "setof jsonb",
        "properties": [
          "registry_id",
          "name",
          "url",
          "state",
          "source",
          "is_interactive",
          "health_meta"
        ]
      },
      "semantics": "Non-disconnected catalog selection in created order; no endpoint configuration or credential is returned."
    },
    {
      "signature": "aap_inference_backend_endpoint_v1.observation_registration_labels(text[])",
      "language": "sql",
      "volatility": "STABLE",
      "arguments": [{ "name": "p_urls", "type": "text[]", "nullable": true }],
      "returns": {
        "kind": "table",
        "columns": [
          { "name": "url", "type": "text", "nullable": false },
          { "name": "source", "type": "text", "nullable": false }
        ]
      },
      "semantics": "Return only registered observation labels matching caller-provided exact URLs; never materialize credentials."
    }
