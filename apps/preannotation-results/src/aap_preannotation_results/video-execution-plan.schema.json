        "effective_discovery_max_frames": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective Discovery Max Frames"
        },
        "effective_track_max_frames": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Effective Track Max Frames",
          "type": "integer"
        },
        "platform_default_frames": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Platform Default Frames",
          "type": "integer"
        },
        "platform_sam3_frames": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Platform Sam3 Frames",
          "type": "integer"
        },
        "track_backend_max_frames": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Track Backend Max Frames"
        }
      },
      "required": [
        "platform_default_frames",
        "platform_sam3_frames",
        "track_backend_max_frames",
        "effective_track_max_frames",
        "combo_discovery_window_frames",
        "discovery_backend_max_frames",
        "effective_discovery_max_frames"
      ],
      "title": "FrozenWindowSettings",
      "type": "object"
    },
