{
  "$defs": {
    "BackendCompatibilityIdentity": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "builtin_implementation_digest": {
                "type": "null"
              },
              "builtin_implementation_id": {
                "type": "null"
              },
              "registry_id": {
                "format": "uuid",
                "type": "string"
              }
            }
          },
          "if": {
            "properties": {
              "provider_kind": {
                "const": "builtin"
              }
            },
            "required": ["provider_kind"]
          },
          "then": {
            "properties": {
              "backend_incarnation": {
                "type": "null"
              },
              "builtin_implementation_id": {
                "const": "aap-mock-bbox/v1"
              },
              "model_id": {
                "const": "mock_bbox"
              },
              "model_key": {
                "const": "mock_bbox"
              },
              "registry_id": {
                "type": "null"
              },
              "role": {
                "const": "track"
              },
              "tracker_context_mode": {
                "const": "none"
              },
              "weights_release_id": {
                "type": "null"
              },
              "weights_sha256": {
                "type": "null"
              }
            },
            "required": ["builtin_implementation_id"]
          }
        }
      ],
      "description": "Non-secret model/backend identity required before checkpoint reuse.",
      "properties": {
        "backend_incarnation": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Backend Incarnation"
        },
        "builtin_implementation_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Builtin Implementation Digest"
        },
        "builtin_implementation_id": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Builtin Implementation Id"
        },
        "capability_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capability Digest"
        },
        "max_context_frames": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Max Context Frames",
          "type": "integer"
        },
        "max_window_frames": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Window Frames"
        },
        "model_id": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Id"
        },
        "model_key": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Model Key",
          "type": "string"
        },
        "provider_kind": {
          "default": "registry",
          "enum": ["registry", "builtin"],
          "title": "Provider Kind",
          "type": "string"
        },
        "registry_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Registry Id"
        },
        "role": {
          "enum": ["track", "discovery"],
          "title": "Role",
          "type": "string"
        },
        "tracker_context_mode": {
          "enum": ["none", "session"],
          "title": "Tracker Context Mode",
          "type": "string"
        },
        "weights_release_id": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Weights Release Id"
        },
        "weights_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Weights Sha256"
        }
      },
      "required": [
        "role",
        "registry_id",
        "backend_incarnation",
        "model_key",
        "model_id",
        "weights_release_id",
        "weights_sha256",
        "tracker_context_mode",
        "max_context_frames",
        "max_window_frames",
        "capability_digest"
      ],
      "title": "BackendCompatibilityIdentity",
      "type": "object"
    },
    "FrozenWindowSettings": {
      "additionalProperties": false,
