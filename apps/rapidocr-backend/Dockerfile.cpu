# CPU-only RapidOCR image. Build context: apps/.
FROM ubuntu:22.04@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip curl ca-certificates libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# RapidOCR and supervision declare GUI OpenCV; only its headless provider is
# installed. pip check reports that upstream metadata mismatch explicitly.
ARG PIP_FIND_LINKS
ARG PIP_TRUSTED_HOST
COPY rapidocr-backend/requirements-build.txt rapidocr-backend/requirements-cpu.txt /build/
RUN python3 -m pip install --require-hashes --no-deps -r /build/requirements-build.txt \
    && python3 -m pip install --require-hashes --no-deps --no-build-isolation -r /build/requirements-cpu.txt

COPY _shared/task_contract/ /build/task_contract/
COPY _shared/protocol_v2/ /build/protocol_v2/
COPY _shared/lifecycle_contract/ /build/lifecycle_contract/
COPY _shared/backend_runtime/ /build/backend_runtime/
COPY rapidocr-backend/pyproject.toml rapidocr-backend/main.py rapidocr-backend/predictor.py \
     rapidocr-backend/schemas.py rapidocr-backend/catalog.py rapidocr-backend/engine_pool.py \
     rapidocr-backend/gpu_lifecycle.py rapidocr-backend/download_models.py \
     rapidocr-backend/plugin_assets.py /build/rapidocr-backend/
RUN python3 -m pip install --no-build-isolation --no-deps \
        /build/task_contract /build/protocol_v2 /build/lifecycle_contract /build/backend_runtime /build/rapidocr-backend \
    && rm -rf /build \
    && mkdir -p /app/models
ENV RAPIDOCR_MODEL_DIR=/var/lib/aap-plugin/models \
    RAPIDOCR_DEVICE=cpu
EXPOSE 8005
ENTRYPOINT ["python3", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8005", "--workers", "1"]
