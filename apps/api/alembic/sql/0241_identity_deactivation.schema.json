{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aap-identity-deactivation-native-v1.schema.json",
  "title": "Identity self-deactivation and due-processing native capabilities",
  "oneOf": [
    { "$ref": "#/$defs/policy" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" },
    { "$ref": "#/$defs/duePolicy" },
    { "$ref": "#/$defs/dueSuccess" },
    { "$ref": "#/$defs/dueFailure" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableTimestamp": {
      "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "policy"],
      "properties": {
        "schema": { "const": "aap-identity-deactivation-policy/v1" },
        "policy": { "const": "aap-identity-deactivation/v1" }
      }
    },
    "duePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "policy"],
      "properties": {
        "schema": { "const": "aap-identity-deactivation-due-policy/v1" },
        "policy": { "const": "aap-identity-deactivation-due/v1" }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "name",
        "email",
        "role",
        "is_active",
        "credential_type",
        "credential_id",
        "generation",
        "scopes",
        "expires_at"
      ],
      "properties": {
        "actor_id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 255 },
        "role": { "enum": ["super_admin", "project_admin", "employee", "viewer"] },
        "is_active": { "const": true },
        "credential_type": { "enum": ["jwt", "api_key"] },
        "credential_id": { "$ref": "#/$defs/uuid" },
        "generation": { "type": ["integer", "null"], "minimum": 0 },
        "scopes": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "expires_at": { "$ref": "#/$defs/nullableTimestamp" }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "email",
        "name",
        "role",
        "group_name",
        "group_id",
        "status",
        "is_active",
        "disabled_kind",
        "disabled_at",
        "disabled_by",
        "disabled_reason",
        "email_verified_at",
        "last_login_at",
        "last_seen_at",
        "password_admin_reset_at",
        "deactivation_requested_at",
        "deactivation_scheduled_at",
        "preferences",
        "avatar_ref",
        "created_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "email": { "type": "string", "maxLength": 255 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "enum": ["super_admin", "project_admin", "employee", "viewer"] },
        "group_name": { "type": ["string", "null"], "maxLength": 100 },
        "group_id": {
          "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "status": { "type": "string", "maxLength": 20 },
        "is_active": { "type": "boolean" },
        "disabled_kind": { "type": ["string", "null"], "maxLength": 32 },
        "disabled_at": { "$ref": "#/$defs/nullableTimestamp" },
        "disabled_by": {
          "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "disabled_reason": { "type": ["string", "null"], "maxLength": 500 },
        "email_verified_at": { "$ref": "#/$defs/nullableTimestamp" },
        "last_login_at": { "$ref": "#/$defs/nullableTimestamp" },
        "last_seen_at": { "$ref": "#/$defs/nullableTimestamp" },
        "password_admin_reset_at": { "$ref": "#/$defs/nullableTimestamp" },
        "deactivation_requested_at": { "$ref": "#/$defs/nullableTimestamp" },
        "deactivation_scheduled_at": { "$ref": "#/$defs/nullableTimestamp" },
        "preferences": { "type": "object" },
        "avatar_ref": { "type": ["string", "null"], "maxLength": 80 },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "operation", "operation_id", "principal", "data"],
      "properties": {
        "schema": { "const": "aap-identity-deactivation-native/v1" },
        "ok": { "const": true },
        "operation": {
          "enum": ["request_self_deactivation", "cancel_self_deactivation"]
        },
        "operation_id": { "$ref": "#/$defs/uuid" },
        "principal": { "$ref": "#/$defs/principal" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["account"],
          "properties": { "account": { "$ref": "#/$defs/account" } }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "error"],
      "properties": {
        "schema": { "const": "aap-identity-deactivation-native/v1" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "status_code", "detail"],
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "credential_invalid",
                "credential_revoked",
                "generation_outdated",
                "token_expired",
                "user_inactive",
                "invalid_account_role",
                "credential_busy",
                "account_busy",
                "invariant_busy",
                "operation_conflict",
                "policy_rejected"
              ]
            },
            "status_code": { "type": ["integer", "null"], "minimum": 400, "maximum": 599 },
            "detail": { "type": ["string", "null"] }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "error": { "properties": { "code": { "const": "policy_rejected" } } } }
          },
          "then": {
            "properties": {
              "error": {
                "properties": {
                  "status_code": { "const": 400 },
                  "detail": {
                    "enum": [
                      "已有进行中的注销申请",
                      "当前无待生效的注销申请",
                      "您是最后一名超级管理员，请先指定继任者再申请注销",
                      "其余超级管理员均已申请注销，请先让其他管理员撤销申请或指定继任者"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "properties": { "status_code": { "type": "null" }, "detail": { "type": "null" } }
              }
            }
          }
        }
      ]
    },
    "dueSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "operation_id",
        "processed",
        "examined",
        "blocked_last_super_admin",
        "has_more"
      ],
      "properties": {
        "schema": { "const": "aap-identity-deactivation-due-native/v1" },
        "ok": { "const": true },
        "operation_id": { "$ref": "#/$defs/uuid" },
        "processed": { "type": "integer", "minimum": 0, "maximum": 500 },
        "examined": { "type": "integer", "minimum": 0, "maximum": 500 },
        "blocked_last_super_admin": { "type": "integer", "minimum": 0, "maximum": 500 },
        "has_more": { "type": "boolean" }
      },
      "description": "processed + blocked_last_super_admin = examined, bounded by the requested page limit."
    },
    "dueFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "error"],
      "properties": {
        "schema": { "const": "aap-identity-deactivation-due-native/v1" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": { "enum": ["invalid_request", "invariant_busy", "operation_conflict"] }
          }
        }
      }
    }
  },
  "x-postgresql-functions": [
    "aap_identity_deactivation_v1.deactivation_policy()",
    "aap_identity_deactivation_v1.execute_deactivation_command(jsonb)",
    "aap_identity_deactivation_v1.due_policy()",
    "aap_identity_deactivation_v1.process_due_deactivations(jsonb)"
  ],
  "x-private-functions": [
    "aap_identity_deactivation_v1._failure(text, smallint, jsonb)",
    "aap_identity_deactivation_v1._due_failure(text)",
    "aap_identity_deactivation_v1._strip_unicode_space(text)",
    "aap_identity_deactivation_v1._account_record(uuid)",
    "aap_identity_deactivation_v1._actor(jsonb, text)",
    "aap_identity_deactivation_v1._reconcile_request(uuid, timestamptz, timestamptz)"
  ],
  "x-super-admin-invariant-functions": [
    "aap_identity_v1.lock_super_admin_invariant()",
    "aap_identity_v1.super_admin_status(uuid)"
  ],
  "x-notification-functions": [
    "aap_notifications_v1.create_identity_deactivation_notifications(uuid, text, jsonb, uuid[])",
    "aap_notifications_v1.identity_delivery_policy()",
    "aap_notifications_v1.claim_identity_deliveries(jsonb)",
    "aap_notifications_v1.finish_identity_delivery(jsonb)"
  ],
  "x-audit-function": "aap_audit_v1.record_identity_deactivation_event(text, jsonb, jsonb, jsonb)",
  "x-login-role-capabilities": {
    "identity_deactivation_client": [
      "aap_identity_deactivation_v1.deactivation_policy()",
      "aap_identity_deactivation_v1.execute_deactivation_command(jsonb)"
    ],
    "identity_deactivation_operator": [
      "aap_identity_deactivation_v1.due_policy()",
      "aap_identity_deactivation_v1.process_due_deactivations(jsonb)"
    ],
    "notification_publish_client": [
      "aap_notifications_v1.identity_delivery_policy()",
      "aap_notifications_v1.claim_identity_deliveries(jsonb)",
      "aap_notifications_v1.finish_identity_delivery(jsonb)"
    ]
  },
  "x-native-errors": [
    "invalid_request",
    "credential_invalid",
    "credential_revoked",
    "generation_outdated",
    "token_expired",
    "user_inactive",
    "invalid_account_role",
    "credential_busy",
    "account_busy",
    "invariant_busy",
    "operation_conflict",
    "policy_rejected"
  ],
  "x-due-errors": ["invalid_request", "invariant_busy", "operation_conflict"],
  "x-receipts": "User receipts bind operation ID, actor ID, operation, request fingerprint, derivation ID, and frozen account result. Due receipts freeze every bounded page, including empty and blocked pages; neither receipt type has a User foreign key.",
  "x-correlation-ledger": "The request ledger stores request ID, User ID, requested/scheduled times, state, and native/legacy origin without a User foreign key or reason copy. Existing User lifecycle fields remain authoritative and pending requests survive administrative suspension/reactivation.",
  "x-lock-order": "Try the shared versioned super-admin invariant transaction lock before any User row lock. Self commands lock User FOR UPDATE NOWAIT before JWT/JTI or API-key fencing. Due batches hold the same guard, lock due Users in UUID order with SKIP LOCKED, and recheck another actually active super-admin before each completion."
}
