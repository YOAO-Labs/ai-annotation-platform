            "type": "text"
          },
          {
            "name": "auth_token",
            "type": "text"
          },
          {
            "name": "extra_params",
            "type": "jsonb"
          },
          {
            "name": "gpu_resource_id",
            "type": "text"
          },
          {
            "name": "vram_budget_mb",
            "type": "integer"
          },
          {
            "name": "eviction_priority",
            "type": "integer"
          },
          {
            "name": "health_meta",
            "type": "jsonb"
          },
          {
            "name": "source",
            "type": "text"
          },
          {
            "name": "error_message",
            "type": "text"
          },
          {
            "name": "last_checked_at",
            "type": "timestamptz"
          },
          {
            "name": "created_at",
            "type": "timestamptz"
          },
          {
            "name": "updated_at",
            "type": "timestamptz"
          }
        ]
      },
      "semantics": "Inserts a disconnected Registry with auth_method=none, null token/GPU/health/error/check time and eviction_priority=0. Does not create the singleton Pool or Member."
    },
