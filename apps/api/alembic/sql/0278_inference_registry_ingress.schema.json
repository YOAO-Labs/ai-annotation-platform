          "type": "uuid",
          "nullable": false
        },
        {
          "name": "p_name",
          "type": "text",
          "nullable": true,
          "description": "Passed through to the Registry NOT NULL constraint without early normalization."
        },
        {
          "name": "p_url",
          "type": "text",
          "nullable": false
        },
        {
          "name": "p_source",
          "type": "text",
          "nullable": false,
          "enum": ["env", "seed"]
        },
        {
          "name": "p_is_interactive",
          "type": "boolean",
          "nullable": false
        },
        {
          "name": "p_extra_params_json",
          "type": "text",
          "nullable": false,
          "description": "JSON object cast only in the Registry INSERT."
        }
      ],
      "returns": {
        "kind": "table",
        "columns": [
          {
            "name": "id",
            "type": "uuid"
          },
          {
            "name": "name",
            "type": "text"
          },
          {
            "name": "url",
            "type": "text"
          },
          {
