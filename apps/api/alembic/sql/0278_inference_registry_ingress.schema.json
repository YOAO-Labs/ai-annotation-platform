            "type": "timestamptz"
          },
          {
            "name": "updated_at",
            "type": "timestamptz"
          }
        ]
      },
      "semantics": "Unordered plain Member-to-Pool lookup, returning the first matching existing Pool as the legacy ORM lookup did."
    },
    {
      "signature": "aap_inference_registry_ingress_v1.create_singleton_pool(uuid,uuid,uuid,text,text,text)",
      "language": "plpgsql",
      "volatility": "VOLATILE",
      "arguments": [
        {
          "name": "p_registry_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "p_pool_id",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "p_member_id",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "p_name",
          "type": "text",
          "nullable": true
        },
        {
          "name": "p_snapshot_json",
          "type": "text",
          "nullable": true,
          "description": "SQL NULL and the JSON text null remain distinct capability_snapshot values."
        },
        {
          "name": "p_fingerprint",
          "type": "text",
          "nullable": true,
          "pattern": "^[0-9a-f]{64}$"
        }
      ],
      "returns": {
        "kind": "table",
        "columns": [
          {
            "name": "id",
            "type": "uuid"
          },
          {
            "name": "name",
            "type": "text"
          },
          {
            "name": "enabled",
            "type": "boolean"
          },
          {
            "name": "routing_policy",
            "type": "text"
          },
          {
            "name": "legacy_instance_id",
            "type": "uuid"
          },
          {
            "name": "routing_generation",
            "type": "bigint"
          },
          {
            "name": "capability_fingerprint",
            "type": "text"
          },
          {
            "name": "capability_snapshot",
            "type": "jsonb"
          },
          {
            "name": "created_at",
            "type": "timestamptz"
          },
          {
            "name": "updated_at",
            "type": "timestamptz"
          }
        ]
      },
      "semantics": "Locks Registry KEY SHARE first. If a Member already exists, returns its actual Pool before validating or parsing create-only inputs. Otherwise inserts a disabled smooth_weighted_round_robin Pool and active weight-one Member with generation one. It performs no health reconciliation."
    },
    {
      "signature": "aap_inference_registry_ingress_v1.apply_observation(uuid,text,text,text,boolean,text,timestamptz,text,boolean,text)",
      "language": "plpgsql",
      "volatility": "VOLATILE",
      "arguments": [
        {
          "name": "p_registry_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "p_profile",
          "type": "text",
          "nullable": false,
          "enum": ["env", "seed"]
        },
        {
          "name": "p_state",
          "type": "text",
          "nullable": false,
          "enum": ["connected", "error"]
        },
        {
          "name": "p_name",
          "type": "text",
          "nullable": true
        },
        {
          "name": "p_is_interactive",
          "type": "boolean",
          "nullable": true
        },
        {
          "name": "p_health_meta_json",
          "type": "text",
          "nullable": true,
          "description": "Cast to JSONB only in the selected apply branch."
        },
        {
          "name": "p_checked_at",
          "type": "timestamptz",
          "nullable": false
        },
        {
          "name": "p_error_message",
          "type": "text",
          "nullable": true
        },
        {
          "name": "p_usable_caps",
          "type": "boolean",
          "nullable": false
        },
        {
          "name": "p_expected_snapshot_json",
          "type": "text",
          "nullable": false,
          "description": "Exact five-key URL/auth/GPU/source snapshot captured before observation."
        }
      ],
      "returns": {
        "kind": "scalar",
        "type": "timestamptz"
      },
      "semantics": "Locks Registry FOR UPDATE, compares the exact current five-key endpoint/source snapshot, and raises sanitized 40001 on missing or changed ownership/snapshot. env always updates name/state/interactivity/health/check time but preserves error_message. seed success updates those fields and clears error_message; seed failure updates only state/error/check time, retaining name/interactivity/health. updated_at uses now()."
    },
    {
      "signature": "aap_inference_registry_ingress_v1.disconnect_env_registry(uuid,text)",
      "language": "plpgsql",
      "volatility": "VOLATILE",
      "arguments": [
        {
          "name": "p_registry_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "p_expected_url",
          "type": "text",
          "nullable": false
        }
      ],
      "returns": {
        "kind": "scalar",
        "type": "timestamptz"
      },
      "semantics": "Locks Registry FOR UPDATE and requires the exact env source and URL, otherwise raises sanitized 40001. Changes only state=disconnected and updated_at when state actually changes."
    },
    {
      "signature": "aap_inference_registry_ingress_v1.tag_seed_registry(uuid,text)",
      "language": "plpgsql",
      "volatility": "VOLATILE",
      "arguments": [
        {
          "name": "p_registry_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "p_marker_json",
          "type": "text",
          "nullable": false,
          "description": "Exact screenshots ownership marker object."
        }
      ],
      "returns": {
        "kind": "table",
        "columns": [
          {
            "name": "extra_params",
            "type": "jsonb"
          },
          {
            "name": "updated_at",
            "type": "timestamptz"
          }
        ]
      },
      "semantics": "Locks Registry FOR UPDATE and merges only the fixed seed marker, preserving other object keys. SQL NULL, JSON null, false, numeric zero including 0.0, empty string and empty array follow the old Python value-or-empty mapping behavior; truthy nonobjects fail. An unchanged mapping does not synthesize an updated_at write."
    },
    {
      "signature": "aap_inference_registry_ingress_v1.sync_result(uuid,text)",
      "language": "plpgsql",
      "volatility": "VOLATILE",
      "arguments": [
        {
          "name": "p_request_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "p_command_sha256",
          "type": "text",
          "nullable": false,
          "pattern": "^[0-9a-f]{64}$"
        }
      ],
      "returns": {
        "kind": "scalar",
        "type": "jsonb",
        "nullable": true,
        "shape": {
          "schema": "aap-inference-registry-env-sync-result/v1",
          "request_id": "uuid-string",
          "command_sha256": "64-lowercase-hex",
          "state": ["caller_pending", "committed"],
          "observed_urls": "nonnegative integer"
        }
      },
      "semantics": "Takes the transaction advisory lock in the fixed env-sync namespace. Returns SQL NULL when no receipt exists. Matching receipt state is caller_pending only for the creating current xid, otherwise committed; digest reuse mismatch raises 22023."
    },
    {
      "signature": "aap_inference_registry_ingress_v1.record_sync_result(uuid,text,integer)",
      "language": "plpgsql",
      "volatility": "VOLATILE",
      "arguments": [
        {
          "name": "p_request_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "p_command_sha256",
          "type": "text",
          "nullable": false,
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "name": "p_observed_urls",
          "type": "integer",
          "nullable": false,
          "minimum": 0
        }
      ],
      "returns": {
        "kind": "scalar",
        "type": "jsonb",
        "shape": {
          "schema": "aap-inference-registry-env-sync-result/v1",
          "request_id": "uuid-string",
          "command_sha256": "64-lowercase-hex",
          "state": ["caller_pending", "committed"],
          "observed_urls": "nonnegative integer"
        }
      },
      "semantics": "Takes the same transaction advisory lock. Inserts one immutable request/hash/count receipt in the caller transaction or returns an identical existing receipt. Reusing an id with different digest or count raises 22023."
    }
  ],
