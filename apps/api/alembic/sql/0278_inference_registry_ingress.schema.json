{
  "$id": "aap-inference-registry-ingress-native/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inference Registry ingress data and environment-sync receipts",
  "$comment": "Fixed caller-transaction Native functions for environment Registry sync and screenshot seed ingress. No HTTP, probe, capability or project-binding policy is accepted as a write boolean.",
  "$defs": {},
  "type": "object",
  "function_defaults": {
    "parallel": "UNSAFE",
    "security_definer": true,
    "search_path": ["pg_catalog", "pg_temp"],
    "time_zone": "UTC",
    "date_style": "ISO, YMD",
    "extra_float_digits": 3
  },
  "tables": [
    {
      "name": "aap_inference_registry_ingress_v1.env_sync_receipts",
      "columns": [
        {
          "name": "request_id",
          "type": "uuid",
          "nullable": false,
          "primary_key": true
        },
        {
          "name": "command_sha256",
          "type": "text",
          "nullable": false,
          "check": "^[0-9a-f]{64}$"
        },
        {
          "name": "observed_urls",
          "type": "integer",
          "nullable": false,
          "check": "observed_urls >= 0"
        },
        {
          "name": "created_xid",
          "type": "xid8",
          "nullable": false
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "clock_timestamp()"
        }
      ],
      "semantics": "Immutable id/hash/count receipt. It stores no request body, URL, endpoint credential, or backend result."
    }
  ],
  "functions": [
    {
      "signature": "aap_inference_registry_ingress_v1.registry_ingress_policy()",
      "language": "sql",
      "volatility": "STABLE",
      "arguments": [],
      "returns": {
        "kind": "jsonb",
        "shape": {
          "schema": "aap-inference-registry-ingress-native/v1",
          "data_protocol": "aap-inference-registry-ingress/v1",
          "transaction": "caller_owned",
          "functions": [
            "aap_inference_registry_ingress_v1.registry_ingress_policy()",
            "aap_inference_registry_ingress_v1.registry_by_url(text)",
            "aap_inference_registry_ingress_v1.registry_candidates(text)",
            "aap_inference_registry_ingress_v1.create_registry(uuid,text,text,text,boolean,text)",
            "aap_inference_registry_ingress_v1.singleton_pool(uuid)",
            "aap_inference_registry_ingress_v1.create_singleton_pool(uuid,uuid,uuid,text,text,text)",
            "aap_inference_registry_ingress_v1.apply_observation(uuid,text,text,text,boolean,text,timestamptz,text,boolean,text)",
            "aap_inference_registry_ingress_v1.disconnect_env_registry(uuid,text)",
            "aap_inference_registry_ingress_v1.tag_seed_registry(uuid,text)",
            "aap_inference_registry_ingress_v1.sync_result(uuid,text)",
            "aap_inference_registry_ingress_v1.record_sync_result(uuid,text,integer)"
          ],
          "ready": true
        }
      },
      "semantics": "Secret-free metadata for exactly eleven fixed functions."
    },
