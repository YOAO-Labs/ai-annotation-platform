      "arguments": ["operation_id", "dataset_id"],
      "request": "RecountOperatorItemsRequest",
      "result": "OperatorCountResult"
    },
    "read_operator_items": {
      "signature": "aap_assets_v1.read_operator_items(uuid,uuid,integer)",
      "arguments": ["dataset_id", "after_item_id", "page_size"],
      "request": "ReadOperatorItemsRequest",
      "result": "OperatorItemsPage"
    }
  }
