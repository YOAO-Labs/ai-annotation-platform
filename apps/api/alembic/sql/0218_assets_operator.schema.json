  "x-trust": "Dedicated operator SQL credentials authorize these operations; owner IDs are attribution, not caller permission flags.",
  "x-budgets": {
    "request_bytes": 8388608,
    "reply_bytes": 16777216,
    "page_record_bytes": 15728640,
    "batch_entries": 500
  },
  "x-failure-codes": [
    "account_busy",
    "account_not_active",
    "axis_conflict",
    "dataset_missing",
    "invalid_request",
    "invalid_response",
    "item_missing",
    "operation_busy",
    "operation_conflict",
    "resource_budget_exceeded",
    "source_changed",
    "storage_root_conflict",
    "storage_unavailable",
    "user_missing"
  ],
  "x-native": {
    "create_operator_image_dataset": {
      "signature": "aap_assets_v1.create_operator_image_dataset(uuid,uuid,text,text)",
      "arguments": ["operation_id", "created_by", "name", "description"],
      "request": "CreateOperatorImageDatasetRequest",
      "result": "OperatorDatasetMutation"
    },
    "ensure_operator_nuscenes_dataset": {
      "signature": "aap_assets_v1.ensure_operator_nuscenes_dataset(uuid,uuid,jsonb)",
      "arguments": ["operation_id", "owner_id", "spec"],
      "request": "EnsureOperatorNuScenesDatasetRequest",
      "result": "OperatorDatasetMutation"
    },
    "append_operator_items": {
      "signature": "aap_assets_v1.append_operator_items(uuid,uuid,jsonb)",
      "arguments": ["operation_id", "dataset_id", "entries"],
      "request": "AppendOperatorItemsRequest",
      "result": "OperatorItemsMutation"
    },
    "patch_operator_items": {
      "signature": "aap_assets_v1.patch_operator_items(uuid,uuid,jsonb)",
      "arguments": ["operation_id", "dataset_id", "entries"],
      "request": "PatchOperatorItemsRequest",
