  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aap-workspace-e2e-fixtures/v1",
  "$comment": "Fixed capabilities for existing guarded E2E fixtures. These functions accept no arbitrary SQL, table, or predicate selectors.",
  "x-native-capabilities": {
    "protocol": "aap-workspace-e2e-fixtures/v1",
    "postgres_schema": "aap_workspace_fixture_v1",
    "functions": [
      {
        "name": "create_project",
        "signature": "aap_workspace_fixture_v1.create_project(jsonb)",
        "arguments": [
          {
            "name": "p_project",
            "postgres_type": "jsonb",
            "json_schema": {
              "$defs": {
                "JsonValue": {}
              },
              "additionalProperties": false,
              "description": "Exact input fields passed to the fixed E2E Project creator.",
              "properties": {
