                "type_label",
                "type_key",
                "data_type",
                "owner_id",
                "tool_bindings",
                "scene_mode",
                "ai_enabled"
              ],
              "title": "E2EProjectRecord",
              "type": "object"
            }
          }
        ],
        "result_postgres_type": "uuid",
        "result_json_schema": {
          "type": "string",
          "format": "uuid"
        },
        "transaction_semantics": "Insert one Project with the exact supplied closed fields and the API ORM's remaining defaults. The caller owns fixture scoping, authorization, the transaction, and commit; native constraints propagate."
      },
      {
        "name": "create_templates",
        "signature": "aap_workspace_fixture_v1.create_templates(jsonb)",
        "arguments": [
          {
            "name": "p_templates",
            "postgres_type": "jsonb",
            "json_schema": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/E2ETemplateRecord"
              }
            }
          }
        ],
        "result_postgres_type": "integer",
        "result_json_schema": {
          "type": "integer",
          "minimum": 0
        },
        "transaction_semantics": "Insert only the supplied closed ProjectTemplate records with the API ORM's remaining defaults. The caller owns fixture scoping, authorization, the transaction, and commit; native constraints propagate."
      },
      {
        "name": "guard_project_cleanup",
        "signature": "aap_workspace_fixture_v1.guard_project_cleanup(uuid[])",
        "arguments": [
          {
            "name": "p_project_ids",
            "postgres_type": "uuid[]",
            "json_schema": {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array"
            }
          }
        ],
        "result_postgres_type": "jsonb",
        "result_model": "E2EProjectCleanupGuard",
        "result_schema_ref": "#/$defs/E2EProjectCleanupGuard",
        "transaction_semantics": "Lock existing Projects in UUID order with NOWAIT, then call the existing video-deletion guard for each before the caller removes any child rows. Return only the closed video_execution_not_retired denial. Never manufacture retirement proof. The caller owns rollback and commit; lock and serialization errors propagate."
      },
      {
        "name": "delete_projects",
        "signature": "aap_workspace_fixture_v1.delete_projects(uuid[])",
        "arguments": [
          {
            "name": "p_project_ids",
            "postgres_type": "uuid[]",
            "json_schema": {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array"
            }
          }
        ],
        "result_postgres_type": "integer",
        "result_json_schema": {
          "type": "integer",
          "minimum": 0
        },
        "transaction_semantics": "Recheck the existing video-deletion guard before deleting only the exact supplied Project IDs. Raise SQLSTATE 23514 when video execution is not retired. The caller owns child cleanup, rollback, and commit."
      },
      {
        "name": "delete_templates",
        "signature": "aap_workspace_fixture_v1.delete_templates(boolean, text[])",
        "arguments": [
          {
            "name": "p_shared",
            "postgres_type": "boolean",
            "json_schema": {
              "type": "boolean"
            }
          },
          {
            "name": "p_display_ids",
            "postgres_type": "text[]",
            "json_schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          }
        ],
        "result_postgres_type": "integer",
        "result_json_schema": {
          "type": "integer",
          "minimum": 0
        },
        "transaction_semantics": "Delete either the fixed shared E2E template prefix or the exact supplied display IDs. No arbitrary predicate is accepted. The caller owns cleanup ordering, rollback, and commit."
      }
    ],
    "authorization_boundary": "The fixed fixture capabilities require a database name ending in _test or _e2e and add no actor or role authorization.",
    "transaction_boundary": "The caller owns the active transaction, fixture cleanup ordering, commit, and rollback. These functions never commit or retry."
  },
