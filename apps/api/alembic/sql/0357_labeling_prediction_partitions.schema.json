      "$ref": "#/$defs/EnsurePredictionPartitionData"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "request": {
      "$ref": "#/$defs/EnsurePredictionPartition"
    },
    "schema": {
      "const": "aap-labeling-prediction-partitions/v1",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": ["schema", "ok", "request", "data"],
  "title": "PredictionPartitionReply",
