          "type": "string"
        },
        "operation": {
          "const": "ensure",
          "title": "Operation",
          "type": "string"
        },
        "schema": {
          "const": "aap-labeling-prediction-partitions/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "operation", "month"],
