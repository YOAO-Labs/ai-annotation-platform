{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aap-jobs-filter-fixtures/v1",
  "$defs": {
    "FilterFixtureJobsRequest": {
      "additionalProperties": false,
      "properties": {
        "completed_job_id": {
          "format": "uuid",
          "title": "Completed Job Id",
          "type": "string"
        },
        "failed_job_id": {
          "format": "uuid",
          "title": "Failed Job Id",
          "type": "string"
        }
      },
      "required": ["completed_job_id", "failed_job_id"],
      "title": "FilterFixtureJobsRequest",
      "type": "object"
    },
    "FilterFixtureJobsCount": {
      "maximum": 2,
      "minimum": 2,
      "type": "integer"
    }
  },
  "x-postgresql-functions": {
    "aap_jobs_v1.set_filter_fixture_job_outcomes": {
      "arguments": "uuid, uuid",
      "returns": "bigint",
      "volatility": "volatile",
      "parallel": "unsafe"
    }
  },
  "x-projections": {
    "completed": {
      "status": "completed",
      "progress_pct": 100,
      "result": {
        "success_count": 2
      }
    },
    "failed": {
      "status": "failed",
      "progress_pct": 40,
      "error_message": "fixture failure"
    }
  },
  "x-security": {
    "database": "actual database name must end in _test or _e2e",
    "owner": "Jobs definer; PUBLIC execute revoked",
    "search_path": "pg_catalog,pg_temp"
  },
  "x-errors": {
    "42501": "non-test database or missing capability",
    "22023": "NULL or duplicate job IDs",
    "P0002": "a selected job row does not exist"
  },
  "x-transactions": {
    "commit": false,
    "rollback": false,
    "ordering": "ascending UUID, same as the original mapper updates",
    "masks": "only the listed projection fields plus updated_at=now(); original UPDATE OF triggers retained",
    "preserved": "all other fields, including started_at/completed_at and failed result",
    "atomic": "missing second row rolls back the entire function statement"
  }
}
