{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aap:contract:task-creation:v1",
  "title": "Initial dataset task creation v1",
  "oneOf": [
    { "$ref": "#/$defs/acceptRequest" },
    { "$ref": "#/$defs/prepareRequest" },
    { "$ref": "#/$defs/readRequest" },
    { "$ref": "#/$defs/advanceRequest" },
    { "$ref": "#/$defs/taskCreationResponse" },
    { "$ref": "#/$defs/taskCreationChunkResponse" },
    { "$ref": "#/$defs/taskCreationItemsResponse" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "operation_missing",
            "operation_conflict",
            "authority_contract_mismatch",
            "account_not_active",
            "account_busy",
            "project_missing",
            "project_busy",
            "invalid_account_role",
            "membership_busy",
            "invalid_project_role",
            "membership_incompatible",
            "project_manager_required",
            "association_stale",
            "mode_mismatch",
            "job_missing",
            "job_scope_mismatch",
            "legacy_job_scope",
            "job_cancelled",
            "job_not_active",
            "jobs_contract_mismatch",
            "assets_contract_mismatch",
            "dataset_missing",
            "source_changed",
            "cursor_conflict",
            "plan_not_prepared",
            "plan_complete"
          ]
        }
      }
    },
    "operationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "actor_id",
        "dataset_id",
        "project_id",
        "association_id",
        "job_id",
        "mode",
        "chunk_size",
        "state",
        "total",
        "next_chunk",
        "processed",
        "created"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/uuid" },
        "actor_id": { "$ref": "#/$defs/uuid" },
        "dataset_id": { "$ref": "#/$defs/uuid" },
        "project_id": { "$ref": "#/$defs/uuid" },
        "association_id": { "$ref": "#/$defs/uuid" },
        "job_id": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "mode": { "enum": ["generic", "pointcloud"] },
        "chunk_size": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "state": { "enum": ["accepted", "running", "completed"] },
        "total": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "next_chunk": { "type": "integer", "minimum": 0 },
        "processed": { "type": "integer", "minimum": 0 },
        "created": { "type": "integer", "minimum": 0 }
      }
    },
    "taskCreationResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "ok", "data"],
          "properties": {
            "schema": { "const": "aap-task-creation/v1" },
            "ok": { "const": true },
            "data": { "$ref": "#/$defs/operationSummary" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "ok", "error"],
          "properties": {
            "schema": { "const": "aap-task-creation/v1" },
            "ok": { "const": false },
            "error": { "$ref": "#/$defs/error" }
          }
        }
      ]
    },
    "cameraProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "sensor_name"],
      "properties": {
        "item_id": { "$ref": "#/$defs/uuid" },
        "sensor_name": { "type": "string", "minLength": 1, "maxLength": 43 }
      }
    },
    "pointcloudFrameProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_item_id", "cameras"],
      "properties": {
        "primary_item_id": { "$ref": "#/$defs/uuid" },
        "cameras": {
          "type": "array",
          "items": { "$ref": "#/$defs/cameraProposal" }
        }
      }
    },
    "acceptRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "actor_id",
        "dataset_id",
        "project_id",
        "association_id",
        "job_id",
        "mode",
        "chunk_size"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/uuid" },
        "actor_id": { "$ref": "#/$defs/uuid" },
        "dataset_id": { "$ref": "#/$defs/uuid" },
        "project_id": { "$ref": "#/$defs/uuid" },
        "association_id": { "$ref": "#/$defs/uuid" },
        "job_id": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "mode": { "enum": ["generic", "pointcloud"] },
        "chunk_size": { "type": "integer", "minimum": 1, "maximum": 5000 }
      }
    },
    "prepareRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "frames"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/uuid" },
        "frames": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/pointcloudFrameProposal" }
            }
          ]
        }
      }
    },
    "readRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "advanceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "chunk_index"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/uuid" },
        "chunk_index": { "type": "integer", "minimum": 0 }
      }
    },
    "taskCreationChunkData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "project_id",
        "chunk_index",
        "created",
        "processed",
        "cumulative_created",
        "cumulative_processed",
        "total",
        "next_chunk",
        "complete",
        "project_total"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/uuid" },
        "project_id": { "$ref": "#/$defs/uuid" },
        "chunk_index": { "type": "integer", "minimum": 0 },
        "created": { "type": "integer", "minimum": 0 },
        "processed": { "type": "integer", "minimum": 0 },
        "cumulative_created": { "type": "integer", "minimum": 0 },
        "cumulative_processed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "next_chunk": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" },
        "project_total": { "type": "integer", "minimum": 0 }
      }
    },
    "taskCreationChunkResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "ok", "data"],
          "properties": {
            "schema": { "const": "aap-task-creation-chunk/v1" },
            "ok": { "const": true },
            "data": { "$ref": "#/$defs/taskCreationChunkData" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "ok", "error"],
          "properties": {
            "schema": { "const": "aap-task-creation-chunk/v1" },
            "ok": { "const": false },
            "error": { "$ref": "#/$defs/error" }
          }
        }
      ]
    },
    "taskCreationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file_name", "file_path", "file_type"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "file_name": { "type": "string" },
        "file_path": { "type": "string" },
        "file_type": { "type": "string" }
      }
    },
    "taskCreationItemsResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "ok", "data"],
          "properties": {
            "schema": { "const": "aap-task-creation-items/v1" },
            "ok": { "const": true },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["items"],
              "properties": {
                "items": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/taskCreationItem" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "ok", "error"],
          "properties": {
            "schema": { "const": "aap-task-creation-items/v1" },
            "ok": { "const": false },
            "error": { "$ref": "#/$defs/error" }
          }
        }
      ]
    }
  },
  "x-postgresql-functions": [
    "aap_assets_v1.lock_task_creation_items(uuid, uuid[])",
    "aap_labeling_v1.accept_dataset_task_creation(uuid, uuid, uuid, uuid, uuid, uuid, text, integer)",
    "aap_labeling_v1.prepare_dataset_task_creation(uuid, jsonb)",
    "aap_labeling_v1.read_dataset_task_creation(uuid)",
    "aap_labeling_v1.advance_dataset_task_creation(uuid, integer)"
  ]
}
