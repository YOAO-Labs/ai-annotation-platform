  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aap-workspace-configuration/v1",
  "$comment": "Workspace stateless project class rename extends the existing Configuration policy/step transport. Legacy six configuration writes retain their original receipt-backed branch; rename uses four lock/read/apply actions and no receipts. New helpers are private owner functions.",
  "x-postgresql-functions": [
    "aap_workspace_configuration_v1._class_rename_project_row(uuid,text)",
    "aap_workspace_configuration_v1._class_rename_member_rows(uuid,uuid)",
    "aap_workspace_configuration_v1.configuration_step(jsonb,text,jsonb,text[],text[])"
  ],
  "x-class-rename-actions": {
    "class_rename_prepare": {
      "actor": ["actor_id", "platform_role", "is_active"],
      "row_json": "full lossless Project row or null"
    },
    "class_rename_member": {
      "rows_json": "full nine-column ProjectMember array"
    },
    "class_rename_lock": {
      "row_json": "full lossless Project row or null"
    },
    "class_rename_apply": {
      "facts": {},
      "arguments": ["old_name", "new_name", "tool_bindings_ascii"]
    }
  },
