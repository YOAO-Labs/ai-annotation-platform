{
  "$defs": {
    "AppendData": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/AppendReceipt"
          },
          "title": "Events",
          "type": "array"
        }
      },
      "required": ["events"],
      "title": "AppendData",
      "type": "object"
    },
    "AppendEvent": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actor Id"
        },
        "actor_email": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actor Email"
        },
        "actor_role": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actor Role"
        },
        "action": {
          "maxLength": 64,
          "title": "Action",
          "type": "string"
        },
        "target_type": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Type"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Id"
        },
        "method": {
          "anyOf": [
            {
              "maxLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Method"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "status_code": {
          "anyOf": [
            {
              "maximum": 32767,
              "minimum": -32768,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status Code"
        },
        "ip": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ip"
        },
        "detail_json": {
          "$ref": "#/$defs/JSONValue"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 36,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Request Id"
        }
      },
      "required": [
        "actor_id",
        "actor_email",
        "actor_role",
        "action",
        "target_type",
        "target_id",
        "method",
        "path",
        "status_code",
        "ip",
        "detail_json",
        "request_id"
      ],
      "title": "AppendEvent",
      "type": "object"
    },
    "AppendReceipt": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 19,
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[01][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$",
          "title": "Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": ["id", "created_at"],
      "title": "AppendReceipt",
      "type": "object"
    },
    "AppendReply": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "aap-audit-append/v1",
          "title": "Schema",
          "type": "string"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "data": {
          "$ref": "#/$defs/AppendData"
        }
      },
      "required": ["schema", "ok", "data"],
      "title": "AppendReply",
      "type": "object"
    },
    "AppendRequest": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "aap-audit-append/v1",
          "title": "Schema",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/AppendEvent"
          },
          "minItems": 1,
          "title": "Events",
          "type": "array"
        }
      },
      "required": ["schema", "events"],
      "title": "AppendRequest",
      "type": "object"
    },
    "JSONValue": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "object"
        },
        {
          "items": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "array"
        },
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/AppendRequest"
    },
    {
      "$ref": "#/$defs/AppendReply"
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aap-audit-append/v1",
  "title": "AAP audit append protocol"
}
