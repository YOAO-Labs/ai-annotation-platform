{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aap:identity-sessions-native:v1",
  "title": "Identity native session command and receipt protocol",
  "oneOf": [
    { "$ref": "#/$defs/SessionPolicy" },
    { "$ref": "#/$defs/LoginCandidate" },
    { "$ref": "#/$defs/NativeCommand" },
    { "$ref": "#/$defs/SuccessReply" },
    { "$ref": "#/$defs/FailureReply" }
  ],
  "$defs": {
    "Principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "name",
        "email",
        "role",
        "is_active",
        "credential_type",
        "credential_id",
        "generation",
        "scopes",
        "expires_at"
      ],
      "properties": {
        "actor_id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "enum": ["super_admin", "project_admin", "employee", "viewer"] },
        "is_active": { "const": true },
        "credential_type": { "enum": ["jwt", "api_key"] },
        "credential_id": { "type": "string", "format": "uuid" },
        "generation": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
            { "type": "null" }
          ]
        },
        "scopes": {
          "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }]
        },
        "expires_at": {
          "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "credential_type": { "const": "jwt" } } },
          "then": {
            "properties": {
              "generation": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
              "scopes": { "type": "null" },
              "expires_at": { "type": "string", "format": "date-time" }
            }
          },
          "else": {
            "properties": {
              "generation": { "type": "null" },
              "scopes": { "type": "array", "items": { "type": "string" } },
              "expires_at": {
                "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
              }
            }
          }
        }
      ]
    },
    "SessionClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sub", "role", "exp", "jti", "gen", "iss"],
      "properties": {
        "sub": { "type": "string", "format": "uuid" },
        "role": { "enum": ["super_admin", "project_admin", "employee", "viewer"] },
        "exp": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "jti": { "type": "string", "format": "uuid" },
        "gen": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "iss": { "const": "aap-identity/v1" }
      }
    },
    "PolicyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expire_minutes", "email_verification_required", "derivation_id"],
      "properties": {
        "expire_minutes": { "type": "integer", "minimum": 1, "maximum": 525600 },
        "email_verification_required": { "type": "boolean" },
        "derivation_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "LoginInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email",
        "actor_id",
        "expected_password_hash",
        "password_matches",
        "failed_count"
      ],
      "properties": {
        "email": { "type": "string", "minLength": 0, "maxLength": 16384 },
        "actor_id": {
          "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
        },
        "expected_password_hash": {
          "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 255 }, { "type": "null" }]
        },
        "password_matches": { "type": "boolean" },
        "failed_count": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
      },
      "allOf": [
        {
          "if": { "properties": { "actor_id": { "const": null } } },
          "then": {
            "properties": {
              "expected_password_hash": { "type": "null" },
              "password_matches": { "const": false }
            }
          },
          "else": {
            "properties": {
              "actor_id": { "type": "string", "format": "uuid" },
              "expected_password_hash": { "type": "string", "minLength": 1, "maxLength": 255 }
            }
          }
        }
      ]
    },
    "AuditContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "ip", "request_id"],
      "properties": {
        "method": { "anyOf": [{ "type": "string", "maxLength": 8 }, { "type": "null" }] },
        "path": { "anyOf": [{ "type": "string", "maxLength": 256 }, { "type": "null" }] },
        "ip": { "anyOf": [{ "type": "string", "maxLength": 64 }, { "type": "null" }] },
        "request_id": { "anyOf": [{ "type": "string", "maxLength": 36 }, { "type": "null" }] }
      }
    },
    "NativeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "operation_id",
        "actor",
        "expected_key_hash",
        "login",
        "policy",
        "request_fingerprint",
        "audit_context",
        "user_agent"
      ],
      "properties": {
        "schema": { "const": "aap-identity-sessions-native/v1" },
        "operation": { "enum": ["login", "refresh", "logout", "logout_all"] },
        "operation_id": { "type": "string", "format": "uuid" },
        "actor": {
          "anyOf": [{ "$ref": "#/$defs/Principal" }, { "type": "null" }]
        },
        "expected_key_hash": {
          "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 255 }, { "type": "null" }]
        },
        "login": {
          "anyOf": [{ "$ref": "#/$defs/LoginInput" }, { "type": "null" }]
        },
        "policy": { "$ref": "#/$defs/PolicyInput" },
        "request_fingerprint": {
          "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }]
        },
        "audit_context": { "$ref": "#/$defs/AuditContext" },
        "user_agent": { "type": "string", "minLength": 0, "maxLength": 256 }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "login" } } },
          "then": {
            "properties": {
              "actor": { "type": "null" },
              "expected_key_hash": { "type": "null" },
              "login": { "$ref": "#/$defs/LoginInput" },
              "request_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "else": {
            "properties": {
              "actor": { "$ref": "#/$defs/Principal" },
              "login": { "type": "null" },
              "request_fingerprint": { "type": "null" }
            }
          }
        }
      ]
    },
    "SessionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "issuer", "algorithm", "refresh_grace_seconds"],
      "properties": {
        "schema": { "const": "aap-identity-sessions-policy/v1" },
        "issuer": { "const": "aap-identity/v1" },
        "algorithm": { "const": "HS256" },
        "refresh_grace_seconds": { "const": 604800 }
      }
    },
    "LoginCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "item"],
      "properties": {
        "schema": { "const": "aap-identity-login-candidate/v1" },
        "item": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["actor_id", "password_hash"],
              "properties": {
                "actor_id": { "type": "string", "format": "uuid" },
                "password_hash": { "type": "string", "minLength": 1, "maxLength": 255 }
              }
            }
          ]
        }
      }
    },
    "SuccessReply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "operation", "operation_id", "principal", "data"],
      "properties": {
        "schema": { "const": "aap-identity-sessions-native/v1" },
        "ok": { "const": true },
        "operation": { "enum": ["login", "refresh", "logout", "logout_all"] },
        "operation_id": { "type": "string", "format": "uuid" },
        "principal": { "$ref": "#/$defs/Principal" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claims"],
          "properties": {
            "claims": {
              "anyOf": [{ "$ref": "#/$defs/SessionClaims" }, { "type": "null" }]
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "logout" } } },
          "then": {
            "properties": {
              "data": { "properties": { "claims": { "type": "null" } } }
            }
          },
          "else": {
            "properties": {
              "data": { "properties": { "claims": { "$ref": "#/$defs/SessionClaims" } } }
            }
          }
        }
      ]
    },
    "FailureReply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "error"],
      "properties": {
        "schema": { "const": "aap-identity-sessions-native/v1" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "failed_count"],
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "credential_invalid",
                "credential_revoked",
                "generation_outdated",
                "token_expired",
                "user_inactive",
                "invalid_account_role",
                "account_busy",
                "credential_busy",
                "invalid_credentials",
                "email_not_verified",
                "captcha_required",
                "invalid_token",
                "malformed_token",
                "operation_conflict"
              ]
            },
            "failed_count": {
              "anyOf": [
                { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
                { "type": "null" }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "code": { "enum": ["invalid_credentials", "captcha_required"] }
                }
              },
              "then": {
                "properties": {
                  "failed_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  }
                }
              },
              "else": { "properties": { "failed_count": { "type": "null" } } }
            }
          ]
        }
      }
    }
  },
  "x-postgresql-functions": [
    "aap_identity_sessions_v1.session_policy()",
    "aap_identity_sessions_v1.read_login_candidate(text)",
    "aap_identity_sessions_v1.execute_session_command(jsonb)"
  ],
  "x-cross-owner-function": "aap_audit_v1.record_identity_session_event(text, jsonb, jsonb, jsonb)",
  "x-native-errors": [
    "invalid_request",
    "credential_invalid",
    "credential_revoked",
    "generation_outdated",
    "token_expired",
    "user_inactive",
    "invalid_account_role",
    "account_busy",
    "credential_busy",
    "invalid_credentials",
    "email_not_verified",
    "captcha_required",
    "invalid_token",
    "malformed_token",
    "operation_conflict"
  ],
  "x-native-retention": "Success receipts freeze only issuance claims and cascade with their actor account.",
  "x-native-lock-order": "Lock the current User row FOR UPDATE NOWAIT, then lock the presented JTI or API key through aap_identity_v1, then take the operation advisory lock before receipt replay or mutation."
}
