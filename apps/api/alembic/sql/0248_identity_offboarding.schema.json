        },
        "derivation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Derivation Id",
          "type": "string"
        },
        "expected_key_hash": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
