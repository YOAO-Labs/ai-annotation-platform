    "NativeOffboardingApplyCommand": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Principal"
        },
        "audit_context": {
          "$ref": "#/$defs/SessionAuditContext"
        },
        "derivation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Derivation Id",
          "type": "string"
        },
        "expected_key_hash": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Key Hash"
        },
        "operation": {
          "const": "commit_offboarding",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/OffboardingApplyPayload"
        },
        "phase": {
          "const": "apply",
          "title": "Phase",
          "type": "string"
        },
        "request_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Fingerprint",
          "type": "string"
        },
        "schema": {
          "const": "aap-identity-offboarding-native/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "operation_id",
        "operation",
        "actor",
        "expected_key_hash",
        "request_fingerprint",
        "derivation_id",
        "audit_context",
        "phase",
        "payload"
      ],
      "title": "NativeOffboardingApplyCommand",
      "type": "object"
    },
    "NativeOffboardingApplyData": {
      "additionalProperties": false,
      "properties": {
        "result": {
          "$ref": "#/$defs/OffboardingResultRecord"
        }
      },
      "required": ["result"],
      "title": "NativeOffboardingApplyData",
      "type": "object"
    },
    "NativeOffboardingApplySuccess": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/NativeOffboardingApplyData"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "operation": {
          "const": "commit_offboarding",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "phase": {
          "const": "apply",
          "title": "Phase",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "replayed": {
          "title": "Replayed",
          "type": "boolean"
        },
        "schema": {
          "const": "aap-identity-offboarding-native/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "ok",
        "operation",
        "operation_id",
        "principal",
        "phase",
        "data",
        "replayed"
      ],
      "title": "NativeOffboardingApplySuccess",
      "type": "object"
    },
    "NativeOffboardingFailureReply": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/OffboardingFailureDetail"
