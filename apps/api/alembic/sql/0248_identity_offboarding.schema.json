    "OffboardingFailureDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "enum": [
                "invalid_request",
                "credential_invalid",
                "credential_revoked",
                "generation_outdated",
                "token_expired",
                "user_inactive",
                "invalid_account_role",
                "credential_busy"
              ],
              "type": "string"
            },
            {
              "enum": [
                "manager_required",
                "target_not_found",
                "self_offboard",
                "last_super_admin",
                "target_role_forbidden",
                "inactive_unmanaged",
                "scope_forbidden",
                "offboarding_preview_stale",
                "historical_target",
                "state_forbidden",
                "duplicate_project",
                "receiver_required",
                "receiver_ineligible",
                "offboarding_blocked",
                "account_busy",
                "offboarding_busy",
                "operation_conflict",
                "unavailable"
              ],
              "type": "string"
            }
          ],
          "title": "Code"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/PreviewStaleDetail"
            },
            {
              "$ref": "#/$defs/ReceiverRequiredDetail"
            },
            {
              "$ref": "#/$defs/ReceiverIneligibleDetail"
            },
            {
              "$ref": "#/$defs/OffboardingBlockedDetail"
            },
            {
              "$ref": "#/$defs/OffboardingTaskBusyDetail"
