            {
              "type": "null"
            }
          ],
          "title": "Expected Key Hash"
        },
        "operation": {
          "enum": ["preview_offboarding", "commit_offboarding"],
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/NativeOffboardingPreparePayload"
        },
        "phase": {
          "const": "prepare",
          "title": "Phase",
          "type": "string"
        },
        "request_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Fingerprint",
          "type": "string"
        },
        "schema": {
          "const": "aap-identity-offboarding-native/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "operation_id",
        "operation",
        "actor",
        "expected_key_hash",
        "request_fingerprint",
        "derivation_id",
        "audit_context",
        "phase",
        "payload"
      ],
      "title": "NativeOffboardingPrepareCommand",
      "type": "object"
    },
    "NativeOffboardingPreparePayload": {
      "additionalProperties": false,
      "properties": {
        "payload_project_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Payload Project Ids",
          "type": "array"
        },
        "receiver_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Receiver Ids",
          "type": "array"
        },
        "target_user_id": {
          "format": "uuid",
          "title": "Target User Id",
          "type": "string"
        }
      },
      "required": ["target_user_id", "receiver_ids", "payload_project_ids"],
      "title": "NativeOffboardingPreparePayload",
      "type": "object"
    },
    "NativeOffboardingPrepareSuccess": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "discriminator": {
            "mapping": {
              "replay": "#/$defs/OffboardingPrepareReplayData",
              "snapshot": "#/$defs/OffboardingPrepareSnapshotData"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/OffboardingPrepareSnapshotData"
            },
            {
              "$ref": "#/$defs/OffboardingPrepareReplayData"
            }
          ],
          "title": "Data"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "operation": {
          "enum": ["preview_offboarding", "commit_offboarding"],
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "phase": {
          "const": "prepare",
          "title": "Phase",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "schema": {
          "const": "aap-identity-offboarding-native/v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": ["schema", "ok", "operation", "operation_id", "principal", "phase", "data"],
      "title": "NativeOffboardingPrepareSuccess",
      "type": "object"
    },
