    "OffboardingApplyPayload": {
      "additionalProperties": false,
      "properties": {
        "expected_target_generation": {
          "exclusiveMaximum": 9223372036854775808,
          "minimum": 0,
          "title": "Expected Target Generation",
          "type": "integer"
        },
        "expected_target_is_active": {
          "title": "Expected Target Is Active",
          "type": "boolean"
        },
        "labeling_plan": {
          "items": {
            "$ref": "#/$defs/OffboardingLabelingPlan"
          },
          "title": "Labeling Plan",
          "type": "array"
        },
        "mode": {
          "enum": ["handoff", "emergency_suspend"],
          "title": "Mode",
          "type": "string"
        },
        "normalized_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Normalized Reason"
        },
        "owner_plan": {
          "items": {
            "$ref": "#/$defs/OffboardingOwnerPlan"
          },
          "title": "Owner Plan",
          "type": "array"
        },
        "reason_present": {
          "title": "Reason Present",
          "type": "boolean"
        },
        "scope_basis": {
          "$ref": "#/$defs/OffboardingScopeBasis"
        },
        "target_user_id": {
          "format": "uuid",
          "title": "Target User Id",
          "type": "string"
        },
        "transaction_id": {
          "minLength": 1,
          "title": "Transaction Id",
          "type": "string"
        },
        "transfers": {
          "items": {
            "$ref": "#/$defs/OffboardingTransfer"
          },
          "title": "Transfers",
          "type": "array"
        },
        "unresolved": {
          "items": {
            "$ref": "#/$defs/OffboardingUnresolved"
          },
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "transaction_id",
        "target_user_id",
        "expected_target_generation",
        "expected_target_is_active",
        "mode",
        "normalized_reason",
        "reason_present",
        "owner_plan",
        "labeling_plan",
        "transfers",
        "unresolved",
        "scope_basis"
      ],
      "title": "OffboardingApplyPayload",
      "type": "object"
    },
