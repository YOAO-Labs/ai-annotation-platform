{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aap-identity-groups-native-v1.schema.json",
  "title": "Identity group catalog and assignment native capability",
  "oneOf": [
    { "$ref": "#/$defs/policy" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "policy"],
      "properties": {
        "schema": { "const": "aap-identity-groups-policy/v1" },
        "policy": { "const": "aap-identity-groups/v1" }
      }
    },
    "groupRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "member_count", "created_at"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": ["string", "null"], "maxLength": 500 },
        "member_count": { "type": "integer", "minimum": 0 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "name",
        "email",
        "role",
        "is_active",
        "credential_type",
        "credential_id",
        "generation",
        "scopes",
        "expires_at"
      ],
      "properties": {
        "actor_id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 255 },
        "role": { "enum": ["super_admin", "project_admin", "employee", "viewer"] },
        "is_active": { "const": true },
        "credential_type": { "enum": ["jwt", "api_key"] },
        "credential_id": { "$ref": "#/$defs/uuid" },
        "generation": { "type": ["integer", "null"], "minimum": 0 },
        "scopes": { "type": ["array", "null"], "items": { "type": "string" } },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "operation", "operation_id", "principal", "data"],
      "properties": {
        "schema": { "const": "aap-identity-groups-native/v1" },
        "ok": { "const": true },
        "operation": {
          "enum": [
            "list_groups",
            "query_groups",
            "create_group",
            "update_group",
            "delete_group",
            "preview_group_assignments",
            "apply_group_assignments",
            "assign_user_group"
          ]
        },
        "operation_id": { "$ref": "#/$defs/uuid" },
        "principal": { "$ref": "#/$defs/principal" },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/listGroupsData" },
            { "$ref": "#/$defs/queryGroupsData" },
            { "$ref": "#/$defs/groupData" },
            { "$ref": "#/$defs/deletedGroupData" },
            { "$ref": "#/$defs/previewAssignmentsData" },
            { "$ref": "#/$defs/applyAssignmentsData" },
            { "$ref": "#/$defs/assignedAccountData" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "list_groups" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/listGroupsData" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "query_groups" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/queryGroupsData" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "create_group" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/groupData" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "update_group" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/groupData" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "delete_group" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/deletedGroupData" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "preview_group_assignments" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/previewAssignmentsData" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "apply_group_assignments" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/applyAssignmentsData" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "assign_user_group" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/assignedAccountData" } } }
        }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "error"],
      "properties": {
        "schema": { "const": "aap-identity-groups-native/v1" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "status_code", "detail"],
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "credential_invalid",
                "credential_revoked",
                "generation_outdated",
                "token_expired",
                "user_inactive",
                "invalid_account_role",
                "credential_busy",
                "group_not_found",
                "target_not_found",
                "group_busy",
                "account_busy",
                "operation_conflict",
                "policy_rejected"
              ]
            },
            "status_code": { "type": ["integer", "null"], "minimum": 400, "maximum": 599 },
            "detail": { "type": ["string", "null"] }
          }
        }
      }
    },
    "invitationGroup": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name"],
          "properties": {
            "id": { "$ref": "#/$defs/uuid" },
            "name": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["error"],
          "properties": {
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code"],
              "properties": {
                "code": { "enum": ["invitation_invalid", "invalid_group_name"] }
              }
            }
          }
        }
      ]
    },
    "listGroupsData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/groupRecord" } }
      }
    },
    "queryGroupsData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "total", "page", "page_size", "pages"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/groupRecord" } },
        "total": { "type": "integer", "minimum": 0 },
        "page": { "type": "integer", "minimum": 1 },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 500 },
        "pages": { "type": "integer", "minimum": 0 }
      }
    },
    "groupData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group"],
      "properties": { "group": { "$ref": "#/$defs/groupRecord" } }
    },
    "deletedGroupData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "deleted"],
      "properties": {
        "group_id": { "$ref": "#/$defs/uuid" },
        "deleted": { "const": true }
      }
    },
    "previewAssignmentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "email",
        "name",
        "ok",
        "current_group_id",
        "current_group_name",
        "next_group_id",
        "next_group_name",
        "error"
      ],
      "properties": {
        "user_id": { "$ref": "#/$defs/uuid" },
        "email": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "ok": { "type": "boolean" },
        "current_group_id": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "current_group_name": { "type": ["string", "null"] },
        "next_group_id": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "next_group_name": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "previewAssignmentsData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "group_name", "items", "applicable", "blocked"],
      "properties": {
        "group_id": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "group_name": { "type": ["string", "null"] },
        "items": { "type": "array", "items": { "$ref": "#/$defs/previewAssignmentItem" } },
        "applicable": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      }
    },
    "assignmentResultItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "ok", "retryable", "error"],
      "properties": {
        "user_id": { "$ref": "#/$defs/uuid" },
        "ok": { "type": "boolean" },
        "retryable": { "type": "boolean" },
        "error": { "type": ["string", "null"] }
      }
    },
    "applyAssignmentsData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "succeeded", "failed"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/assignmentResultItem" } },
        "succeeded": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "accountRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "email",
        "name",
        "role",
        "group_name",
        "group_id",
        "status",
        "is_active",
        "disabled_kind",
        "disabled_at",
        "disabled_by",
        "disabled_reason",
        "email_verified_at",
        "last_login_at",
        "last_seen_at",
        "password_admin_reset_at",
        "deactivation_requested_at",
        "deactivation_scheduled_at",
        "preferences",
        "avatar_ref",
        "created_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "email": { "type": "string", "maxLength": 255 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "enum": ["super_admin", "project_admin", "employee", "viewer"] },
        "group_name": { "type": ["string", "null"], "maxLength": 100 },
        "group_id": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "status": { "type": "string", "maxLength": 20 },
        "is_active": { "type": "boolean" },
        "disabled_kind": { "type": ["string", "null"], "maxLength": 32 },
        "disabled_at": { "type": ["string", "null"], "format": "date-time" },
        "disabled_by": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "disabled_reason": { "type": ["string", "null"], "maxLength": 500 },
        "email_verified_at": { "type": ["string", "null"], "format": "date-time" },
        "last_login_at": { "type": ["string", "null"], "format": "date-time" },
        "last_seen_at": { "type": ["string", "null"], "format": "date-time" },
        "password_admin_reset_at": { "type": ["string", "null"], "format": "date-time" },
        "deactivation_requested_at": { "type": ["string", "null"], "format": "date-time" },
        "deactivation_scheduled_at": { "type": ["string", "null"], "format": "date-time" },
        "preferences": { "type": "object" },
        "avatar_ref": { "type": ["string", "null"], "maxLength": 80 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "assignedAccountData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account"],
      "properties": { "account": { "$ref": "#/$defs/accountRecord" } }
    }
  },
  "x-postgresql-functions": [
    "aap_identity_groups_v1.group_policy()",
    "aap_identity_groups_v1.execute_group_command(jsonb)"
  ],
  "x-private-functions": [
    "aap_identity_groups_v1.resolve_invitation_group(uuid, text)",
    "aap_identity_groups_v1._group_actor(jsonb, text)",
    "aap_identity_groups_v1._group_scope(uuid, uuid[], boolean)",
    "aap_identity_groups_v1._group_record(uuid)",
    "aap_identity_groups_v1._account_record(uuid)",
    "aap_identity_groups_v1._strip_unicode_space(text)",
    "aap_identity_groups_v1._failure(text, smallint, jsonb)"
  ],
  "x-workspace-function": "aap_workspace_v1.lock_group_assignment_scope(uuid, uuid[], boolean)",
  "x-audit-function": "aap_audit_v1.record_identity_group_event(text, jsonb, jsonb, jsonb)",
  "x-login-role": "identity_group_client",
  "x-invitation-helper": "aap_identity_groups_v1.resolve_invitation_group(uuid, text)",
  "x-receipt": "Receipts bind operation id, current actor id, operation, request fingerprint, derivation id and frozen data result; no raw bearer or audit metadata is stored.",
  "x-lock-order": "Try-lock operation id, inspect retained receipt, lock requested Group, key-share actor, no-key-update target Users, then Workspace Project and ProjectMember scope rows; replay never repeats Audit or rewinds state."
}
