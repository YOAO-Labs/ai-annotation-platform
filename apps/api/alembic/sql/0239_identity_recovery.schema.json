{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aap:identity-recovery-native:v1",
  "title": "Identity recovery, open registration and credential mail protocols",
  "oneOf": [
    { "$ref": "#/$defs/RecoveryPolicy" },
    { "$ref": "#/$defs/MailPolicy" },
    { "$ref": "#/$defs/PrepareCommand" },
    { "$ref": "#/$defs/ApplyCommand" },
    { "$ref": "#/$defs/PrepareReply" },
    { "$ref": "#/$defs/ApplyReply" },
    { "$ref": "#/$defs/RecoveryFailure" },
    { "$ref": "#/$defs/ClaimMailRequest" },
    { "$ref": "#/$defs/RenewMailRequest" },
    { "$ref": "#/$defs/FinishMailRequest" },
    { "$ref": "#/$defs/ClaimMailReply" },
    { "$ref": "#/$defs/MailAcceptedReply" },
    { "$ref": "#/$defs/MailFailure" },
    { "$ref": "#/$defs/MailDeliveryPolicy" }
  ],
  "$defs": {
    "Uuid": { "type": "string", "format": "uuid" },
    "DateTime": { "type": "string", "format": "date-time" },
    "NullableDateTime": {
      "anyOf": [{ "$ref": "#/$defs/DateTime" }, { "type": "null" }]
    },
    "AccountRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "email",
        "name",
        "role",
        "group_name",
        "group_id",
        "status",
        "is_active",
        "disabled_kind",
        "disabled_at",
        "disabled_by",
        "disabled_reason",
        "email_verified_at",
        "last_login_at",
        "last_seen_at",
        "password_admin_reset_at",
        "deactivation_requested_at",
        "deactivation_scheduled_at",
        "preferences",
        "avatar_ref",
        "created_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "email": { "type": "string", "maxLength": 255 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "enum": ["super_admin", "project_admin", "employee", "viewer"] },
        "group_name": { "type": ["string", "null"] },
        "group_id": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
        "status": { "type": "string" },
        "is_active": { "type": "boolean" },
        "disabled_kind": { "type": ["string", "null"] },
        "disabled_at": { "$ref": "#/$defs/NullableDateTime" },
        "disabled_by": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
        "disabled_reason": { "type": ["string", "null"] },
        "email_verified_at": { "$ref": "#/$defs/NullableDateTime" },
        "last_login_at": { "$ref": "#/$defs/NullableDateTime" },
        "last_seen_at": { "$ref": "#/$defs/NullableDateTime" },
        "password_admin_reset_at": { "$ref": "#/$defs/NullableDateTime" },
        "deactivation_requested_at": { "$ref": "#/$defs/NullableDateTime" },
        "deactivation_scheduled_at": { "$ref": "#/$defs/NullableDateTime" },
        "preferences": { "type": "object" },
        "avatar_ref": { "type": ["string", "null"], "maxLength": 80 },
        "created_at": { "$ref": "#/$defs/DateTime" }
      }
    },
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "email",
        "role",
        "is_active",
        "credential_generation",
        "email_verified_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "email": { "type": "string", "maxLength": 255 },
        "role": { "enum": ["super_admin", "project_admin", "employee", "viewer"] },
        "is_active": { "type": "boolean" },
        "credential_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "email_verified_at": { "$ref": "#/$defs/NullableDateTime" }
      }
    },
    "Challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "token_hash", "issued_email", "expires_at", "used_at"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "token_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "issued_email": { "type": "string", "maxLength": 255 },
        "expires_at": { "$ref": "#/$defs/DateTime" },
        "used_at": { "$ref": "#/$defs/NullableDateTime" }
      }
    },
    "RecoveryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "policy"],
      "properties": {
        "schema": { "const": "aap-identity-recovery-policy/v1" },
        "policy": { "const": "aap-identity-recovery/v1" }
      }
    },
    "MailPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "policy"],
      "properties": {
        "schema": { "const": "aap-identity-recovery-mail-policy/v1" },
        "policy": { "const": "aap-identity-recovery-mail/v1" }
      }
    },
    "AuditContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "ip", "request_id"],
      "properties": {
        "method": { "anyOf": [{ "type": "string", "maxLength": 8 }, { "type": "null" }] },
        "path": { "anyOf": [{ "type": "string", "maxLength": 256 }, { "type": "null" }] },
        "ip": { "anyOf": [{ "type": "string", "maxLength": 64 }, { "type": "null" }] },
        "request_id": { "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }] }
      }
    },
    "Config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_open_registration",
        "email_verification_required",
        "frontend_base_url",
        "expire_minutes"
      ],
      "properties": {
        "allow_open_registration": { "type": "boolean" },
        "email_verification_required": { "type": "boolean" },
        "frontend_base_url": { "type": "string", "maxLength": 2048 },
        "expire_minutes": { "type": "integer", "minimum": 1, "maximum": 525600 }
      }
    },
    "RegisterArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "name", "captcha_verified"],
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 255 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "captcha_verified": { "type": "boolean" }
      }
    },
    "RequestPasswordResetArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "captcha_verified"],
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 255 },
        "captcha_verified": { "type": "boolean" }
      }
    },
    "ResendVerificationArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email"],
      "properties": { "email": { "type": "string", "minLength": 3, "maxLength": 255 } }
    },
    "ConsumeChallengeArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_hash"],
      "properties": { "token_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
    },
    "PrepareCommon": {
      "type": "object",
      "required": [
        "schema",
        "operation",
        "operation_id",
        "request_fingerprint",
        "derivation_id",
        "audit_context",
        "config",
        "args"
      ],
      "properties": {
        "schema": { "const": "aap-identity-recovery-native/v1" },
        "operation": {
          "enum": [
            "register_open",
            "request_password_reset",
            "resend_email_verification",
            "consume_password_reset",
            "consume_email_verification"
          ]
        },
        "operation_id": { "$ref": "#/$defs/Uuid" },
        "request_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "derivation_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "audit_context": { "$ref": "#/$defs/AuditContext" },
        "config": { "$ref": "#/$defs/Config" },
        "args": { "type": "object" }
      }
    },
    "PrepareCommand": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/PrepareCommon" },
            {
              "properties": {
                "operation": { "const": "register_open" },
                "args": { "$ref": "#/$defs/RegisterArgs" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/PrepareCommon" },
            {
              "properties": {
                "operation": { "const": "request_password_reset" },
                "args": { "$ref": "#/$defs/RequestPasswordResetArgs" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/PrepareCommon" },
            {
              "properties": {
                "operation": { "const": "resend_email_verification" },
                "args": { "$ref": "#/$defs/ResendVerificationArgs" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/PrepareCommon" },
            {
              "properties": {
                "operation": { "const": "consume_password_reset" },
                "args": { "$ref": "#/$defs/ConsumeChallengeArgs" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/PrepareCommon" },
            {
              "properties": {
                "operation": { "const": "consume_email_verification" },
                "args": { "$ref": "#/$defs/ConsumeChallengeArgs" }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "ApplyCommand": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/PrepareCommon" },
            {
              "properties": {
                "operation": { "const": "register_open" },
                "args": { "$ref": "#/$defs/RegisterArgs" }
              }
            },
            { "$ref": "#/$defs/ApplyFields" }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/PrepareCommon" },
            {
              "properties": {
                "operation": { "const": "request_password_reset" },
                "args": { "$ref": "#/$defs/RequestPasswordResetArgs" }
              }
            },
            { "$ref": "#/$defs/ApplyFields" }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/PrepareCommon" },
            {
              "properties": {
                "operation": { "const": "resend_email_verification" },
                "args": { "$ref": "#/$defs/ResendVerificationArgs" }
              }
            },
            { "$ref": "#/$defs/ApplyFields" }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/PrepareCommon" },
            {
              "properties": {
                "operation": { "const": "consume_password_reset" },
                "args": { "$ref": "#/$defs/ConsumeChallengeArgs" }
              }
            },
            { "$ref": "#/$defs/ApplyFields" }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/PrepareCommon" },
            {
              "properties": {
                "operation": { "const": "consume_email_verification" },
                "args": { "$ref": "#/$defs/ConsumeChallengeArgs" }
              }
            },
            { "$ref": "#/$defs/ApplyFields" }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "ApplyFields": {
      "type": "object",
      "required": ["password_hash", "token_hash", "token_ciphertext", "encryption_id"],
      "properties": {
        "password_hash": {
          "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 255 }, { "type": "null" }]
        },
        "token_hash": {
          "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }]
        },
        "token_ciphertext": {
          "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        },
        "encryption_id": {
          "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }]
        }
      }
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_open_registration",
        "email_verification_required",
        "frontend_base_url",
        "expire_minutes",
        "password_reset_ttl_seconds",
        "email_verification_ttl_seconds"
      ],
      "properties": {
        "allow_open_registration": { "type": "boolean" },
        "email_verification_required": { "type": "boolean" },
        "frontend_base_url": { "type": "string", "maxLength": 2048 },
        "expire_minutes": { "type": "integer", "minimum": 1, "maximum": 525600 },
        "password_reset_ttl_seconds": { "const": 3600 },
        "email_verification_ttl_seconds": { "const": 86400 }
      }
    },
    "RecoveryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "claims", "email_verification_required", "completed"],
      "properties": {
        "account": { "anyOf": [{ "$ref": "#/$defs/AccountRecord" }, { "type": "null" }] },
        "claims": { "anyOf": [{ "$ref": "#/$defs/SessionClaims" }, { "type": "null" }] },
        "email_verification_required": { "type": ["boolean", "null"] },
        "completed": { "type": ["boolean", "null"] }
      }
    },
    "SessionClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sub", "role", "exp", "jti", "gen", "iss"],
      "properties": {
        "sub": { "$ref": "#/$defs/Uuid" },
        "role": { "const": "viewer" },
        "exp": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "jti": { "$ref": "#/$defs/Uuid" },
        "gen": { "const": 0 },
        "iss": { "const": "aap-identity/v1" }
      }
    },
    "PrepareData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "password_hash", "token", "eligible", "replay", "policy"],
      "properties": {
        "actor": { "anyOf": [{ "$ref": "#/$defs/Actor" }, { "type": "null" }] },
        "password_hash": {
          "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 255 }, { "type": "null" }]
        },
        "token": { "anyOf": [{ "$ref": "#/$defs/Challenge" }, { "type": "null" }] },
        "eligible": { "type": "boolean" },
        "replay": { "anyOf": [{ "$ref": "#/$defs/RecoveryResult" }, { "type": "null" }] },
        "policy": { "$ref": "#/$defs/Policy" }
      }
    },
    "PrepareReply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "operation", "operation_id", "data"],
      "properties": {
        "schema": { "const": "aap-identity-recovery-native/v1" },
        "ok": { "const": true },
        "operation": {
          "enum": [
            "register_open",
            "request_password_reset",
            "resend_email_verification",
            "consume_password_reset",
            "consume_email_verification"
          ]
        },
        "operation_id": { "$ref": "#/$defs/Uuid" },
        "data": { "$ref": "#/$defs/PrepareData" }
      }
    },
    "ApplyData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "actor", "replayed", "password_changed", "email_verified_changed"],
      "properties": {
        "result": { "$ref": "#/$defs/RecoveryResult" },
        "actor": { "anyOf": [{ "$ref": "#/$defs/Actor" }, { "type": "null" }] },
        "replayed": { "type": "boolean" },
        "password_changed": { "type": "boolean" },
        "email_verified_changed": { "type": "boolean" }
      }
    },
    "ApplyReply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "operation", "operation_id", "data"],
      "properties": {
        "schema": { "const": "aap-identity-recovery-native/v1" },
        "ok": { "const": true },
        "operation": {
          "enum": [
            "register_open",
            "request_password_reset",
            "resend_email_verification",
            "consume_password_reset",
            "consume_email_verification"
          ]
        },
        "operation_id": { "$ref": "#/$defs/Uuid" },
        "data": { "$ref": "#/$defs/ApplyData" }
      }
    },
    "RecoveryFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "error"],
      "properties": {
        "schema": { "const": "aap-identity-recovery-native/v1" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "registration_disabled",
                "email_exists",
                "captcha_required",
                "operation_conflict"
              ]
            }
          }
        }
      }
    },
    "ClaimMailRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "worker_id", "lease_seconds", "delivery_id"],
      "properties": {
        "schema": { "const": "aap-identity-recovery-mail-native/v1" },
        "worker_id": { "$ref": "#/$defs/Uuid" },
        "lease_seconds": { "type": "integer" },
        "delivery_id": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] }
      }
    },
    "RenewMailRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "delivery_id", "worker_id", "lease_token"],
      "properties": {
        "schema": { "const": "aap-identity-recovery-mail-native/v1" },
        "delivery_id": { "$ref": "#/$defs/Uuid" },
        "worker_id": { "$ref": "#/$defs/Uuid" },
        "lease_token": { "$ref": "#/$defs/Uuid" }
      }
    },
    "FinishMailRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "delivery_id",
        "worker_id",
        "lease_token",
        "outcome",
        "reason",
        "retry_delay_seconds"
      ],
      "properties": {
        "schema": { "const": "aap-identity-recovery-mail-native/v1" },
        "delivery_id": { "$ref": "#/$defs/Uuid" },
        "worker_id": { "$ref": "#/$defs/Uuid" },
        "lease_token": { "$ref": "#/$defs/Uuid" },
        "outcome": { "enum": ["delivered", "rejected", "retry", "unknown", "invalid_key"] },
        "reason": {
          "enum": [
            "sent",
            "not_configured",
            "message_invalid",
            "tls_failed",
            "auth_failed",
            "recipient_rejected",
            "sender_rejected",
            "data_rejected",
            "connect_failed",
            "transport_failed",
            "derivation_unavailable"
          ]
        },
        "retry_delay_seconds": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }
      }
    },
    "MailLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actor_id",
        "purpose",
        "email",
        "frontend_base_url",
        "token_hash",
        "token_ciphertext",
        "encryption_id",
        "expires_at",
        "attempt",
        "worker_id",
        "lease_token",
        "lease_expires_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "actor_id": { "$ref": "#/$defs/Uuid" },
        "purpose": { "enum": ["password_reset", "email_verification"] },
        "email": { "type": "string", "maxLength": 255 },
        "frontend_base_url": { "type": "string", "maxLength": 2048 },
        "token_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "token_ciphertext": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "encryption_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expires_at": { "$ref": "#/$defs/DateTime" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "worker_id": { "$ref": "#/$defs/Uuid" },
        "lease_token": { "$ref": "#/$defs/Uuid" },
        "lease_expires_at": { "$ref": "#/$defs/DateTime" }
      }
    },
    "ClaimMailReply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "data"],
      "properties": {
        "schema": { "const": "aap-identity-recovery-mail-native/v1" },
        "ok": { "const": true },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delivery"],
          "properties": {
            "delivery": { "anyOf": [{ "$ref": "#/$defs/MailLease" }, { "type": "null" }] }
          }
        }
      }
    },
    "MailAcceptedReply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "data"],
      "properties": {
        "schema": { "const": "aap-identity-recovery-mail-native/v1" },
        "ok": { "const": true },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted"],
          "properties": { "accepted": { "type": "boolean" } }
        }
      }
    },
    "MailFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "error"],
      "properties": {
        "schema": { "const": "aap-identity-recovery-mail-native/v1" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": { "code": { "const": "invalid_request" } }
        }
      }
    },
    "MailDeliveryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smtp_host", "smtp_port", "smtp_user", "smtp_password", "smtp_from"],
      "properties": {
        "smtp_host": { "type": "string" },
        "smtp_port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "smtp_user": { "type": "string" },
        "smtp_password": { "type": "string" },
        "smtp_from": { "type": "string" }
      }
    }
  },
  "x-postgresql-functions": [
    "aap_identity_recovery_v1.recovery_policy()",
    "aap_identity_recovery_v1.prepare_recovery_command(jsonb)",
    "aap_identity_recovery_v1.apply_recovery_command(jsonb)",
    "aap_identity_recovery_v1.mail_policy()",
    "aap_identity_recovery_v1.claim_mail(jsonb)",
    "aap_identity_recovery_v1.renew_mail(jsonb)",
    "aap_identity_recovery_v1.finish_mail(jsonb)"
  ],
  "x-settings-functions": [
    "aap_settings_v1.identity_recovery_policy(jsonb)",
    "aap_settings_v1.mail_delivery_policy(jsonb)"
  ],
  "x-audit-function": "aap_audit_v1.record_identity_recovery_event(text, jsonb, jsonb, jsonb)",
  "x-recovery-login-role": "identity_recovery_client",
  "x-mail-login-role": "identity_mail_client",
  "x-mail-settings-login-role": "identity_mail_settings_client",
  "x-native-errors": [
    "invalid_request",
    "registration_disabled",
