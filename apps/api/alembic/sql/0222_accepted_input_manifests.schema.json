        "source_generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Source Generation",
          "type": "integer"
        },
        "source_snapshot": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Snapshot",
          "type": "string"
        },
        "byte_size": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
