{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aap-assets-input-manifest/v1",
  "$defs": {
    "ManifestSelection": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Id"
        },
        "task_ids": {
          "anyOf": [
            {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "maxItems": 200,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Ids"
        },
        "predict_mode": {
          "enum": ["skip_predicted", "overwrite", "append"],
          "title": "Predict Mode",
          "type": "string"
        }
      },
      "required": ["predict_mode"],
      "title": "ManifestSelection",
      "type": "object"
    },
    "CaptureManifestRequest": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/ManifestSelection"
        }
      },
      "required": ["job_id", "actor_id", "project_id", "selection"],
      "title": "CaptureManifestRequest",
      "type": "object"
    },
    "ManifestHeader": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/ManifestSelection"
        },
        "selection_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selection Digest",
          "type": "string"
        },
        "candidate_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "selected_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Selected Count",
          "type": "integer"
        },
        "prepared_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Prepared Count",
          "type": "integer"
        },
        "status": {
          "enum": ["preparing", "sealed"],
          "title": "Status",
          "type": "string"
        },
        "ready_count": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ready Count"
        },
        "failed_count": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failed Count"
        },
        "sealed_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sealed Digest"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "sealed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sealed At"
        }
      },
      "required": [
        "job_id",
        "actor_id",
        "project_id",
        "selection",
        "selection_digest",
        "candidate_count",
        "selected_count",
        "prepared_count",
        "status",
        "ready_count",
        "failed_count",
        "sealed_digest",
        "created_at",
        "sealed_at"
      ],
      "title": "ManifestHeader",
      "type": "object"
    },
    "ManifestScope": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": ["job_id", "actor_id", "project_id"],
      "title": "ManifestScope",
      "type": "object"
    },
    "ManifestPageRequest": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "selection_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selection Digest",
          "type": "string"
        },
        "sealed_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sealed Digest"
        },
        "cursor": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Cursor",
          "type": "integer"
        },
        "page_size": {
          "default": 100,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "required": ["job_id", "actor_id", "project_id", "selection_digest"],
      "title": "ManifestPageRequest",
      "type": "object"
    },
    "ImageOwner": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["dataset_item", "task"],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "title": "ImageOwner",
      "type": "object"
    },
    "ImageSource": {
      "additionalProperties": false,
      "description": "Current source facts plus separate freshness facts for derived media.",
      "properties": {
        "owner": {
          "$ref": "#/$defs/ImageOwner"
        },
        "task_id": {
          "anyOf": [
            {
              "format": "uuid",
