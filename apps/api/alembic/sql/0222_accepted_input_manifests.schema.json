          "type": "integer"
        },
        "task_source_generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Task Source Generation",
          "type": "integer"
        },
        "dataset_item_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
