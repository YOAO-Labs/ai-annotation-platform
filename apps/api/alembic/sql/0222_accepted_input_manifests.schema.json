        },
        "dataset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dataset Id"
        },
        "item_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Item Id"
        },
        "source_generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Source Generation",
          "type": "integer"
        },
        "source_snapshot": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Snapshot",
          "type": "string"
        },
        "object_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_drifted": {
          "title": "Source Drifted",
          "type": "boolean"
        },
        "upload_ready": {
          "title": "Upload Ready",
          "type": "boolean"
        },
        "file_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "File Path",
          "type": "string"
        },
        "file_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "File Name",
          "type": "string"
        },
        "file_type": {
          "const": "image",
          "title": "File Type",
          "type": "string"
        },
        "bucket_kind": {
          "enum": ["datasets", "legacy"],
          "title": "Bucket Kind",
          "type": "string"
        },
        "file_size": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "File Size"
        },
        "content_hash": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content Hash"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 2147483647,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 2147483647,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Height"
        },
        "thumbnail_path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Thumbnail Path"
        },
        "blurhash": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blurhash"
        },
        "thumbnail_source_generation": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Thumbnail Source Generation"
        },
        "thumbnail_error": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Thumbnail Error"
        }
