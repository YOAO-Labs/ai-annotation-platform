        "owner",
        "task_id",
        "project_id",
        "dataset_id",
        "item_id",
        "source_generation",
        "source_snapshot",
        "object_identity",
        "source_drifted",
        "upload_ready",
        "file_path",
        "file_name",
        "file_type",
        "bucket_kind",
        "file_size",
        "content_hash",
        "width",
        "height",
        "thumbnail_path",
        "blurhash",
        "thumbnail_source_generation",
        "thumbnail_error"
