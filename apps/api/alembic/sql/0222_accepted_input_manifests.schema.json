      "required": [
        "input_id",
        "job_id",
        "task_id",
        "project_id",
        "actor_id",
        "status",
        "task_version",
        "task_source_generation",
        "dataset_item_id",
        "task_source_snapshot",
        "source_owner",
        "source_generation",
        "source_snapshot",
        "byte_size",
