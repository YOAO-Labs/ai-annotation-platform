        "error": {
          "anyOf": [
            {
              "enum": [
                "invalid_request",
                "invalid_response",
                "storage_unavailable",
                "account_not_active",
                "account_busy",
                "invalid_account_role",
                "source_missing",
                "source_changed",
                "source_busy",
                "source_not_ready",
                "task_not_visible",
                "task_busy",
                "permission_denied",
                "not_image",
                "asset_missing",
                "already_ready",
                "not_eligible",
                "retry_cooldown",
                "operation_conflict",
                "operation_busy",
                "lease_lost",
                "dependency_changed",
                "resource_budget_exceeded",
                "object_missing",
                "owner_changed",
                "unsupported_dimensions",
                "resource_limit",
                "invalid_coordinate",
                "timeout",
                "source_unavailable",
                "color_profile_unavailable",
                "multi_page_unsupported",
                "dimension_mismatch",
                "generator_unavailable",
                "decode_failed",
                "encode_failed",
                "tile_grid_mismatch",
                "upload_verification_failed",
                "inconsistent_ready",
                "input_missing",
                "input_scope_mismatch",
                "input_not_ready",
                "input_expired",
                "input_corrupt",
                "input_busy",
                "job_not_active",
                "job_busy",
                "reference_busy",
                "versioning_required"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "retire_after": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retire After"
