{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aap:assets-catalog:v1",
  "title": "Assets dataset catalog data contract v1",
  "description": "Snapshot reads and caller-transactional, replayable Dataset catalog writes owned by Assets.",
  "x-postgresql-functions": [
    "aap_assets_v1.list_catalog_datasets(uuid, text, text, boolean, integer, bigint)",
    "aap_assets_v1.get_catalog_dataset(uuid, uuid)",
    "aap_assets_v1.list_catalog_items(uuid, uuid, integer, bigint)",
    "aap_assets_v1.create_catalog_dataset(uuid, uuid, jsonb)",
    "aap_assets_v1.update_catalog_dataset(uuid, uuid, uuid, jsonb)"
  ],
  "oneOf": [
    { "$ref": "#/$defs/listDatasetsCall" },
    { "$ref": "#/$defs/getDatasetCall" },
    { "$ref": "#/$defs/listItemsCall" },
    { "$ref": "#/$defs/createDatasetCall" },
    { "$ref": "#/$defs/updateDatasetCall" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "nullableUuid": { "type": ["string", "null"], "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableAxisConvention": {
      "anyOf": [
        {
          "enum": [
            "iso_8855",
            "ros_rep103",
            "kitti_camera",
            "opencv_camera",
            "apollo",
            "y_forward",
            "sustechpoints_demo",
            "raw"
          ],
          "type": "string"
        },
        { "type": "null" }
      ]
    },
    "datasetSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_id",
        "name",
        "description",
        "data_type",
        "is_temporal",
        "has_scenes",
        "file_count",
        "total_size",
        "created_by",
        "project_count",
        "axis_convention",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "display_id": { "type": "string", "maxLength": 20 },
        "name": { "type": "string", "maxLength": 255 },
        "description": { "type": "string" },
        "data_type": { "type": "string", "maxLength": 30 },
        "is_temporal": { "type": "boolean" },
        "has_scenes": { "type": "boolean" },
        "file_count": { "type": "integer", "minimum": 0 },
        "total_size": { "type": "integer", "minimum": 0 },
        "created_by": { "$ref": "#/$defs/uuid" },
        "project_count": { "type": "integer", "minimum": 0 },
        "axis_convention": { "$ref": "#/$defs/nullableAxisConvention" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "catalogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dataset_id",
        "file_name",
        "file_path",
        "file_type",
        "file_size",
        "content_hash",
        "width",
        "height",
        "metadata",
        "file_url",
        "thumbnail_path",
        "thumbnail_url",
        "blurhash",
        "created_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "dataset_id": { "$ref": "#/$defs/uuid" },
        "file_name": { "type": "string", "maxLength": 500 },
        "file_path": { "type": "string", "maxLength": 1000 },
        "file_type": { "type": "string", "maxLength": 20 },
        "file_size": { "type": ["integer", "null"] },
        "content_hash": { "type": ["string", "null"], "maxLength": 64 },
        "width": { "type": ["integer", "null"] },
        "height": { "type": ["integer", "null"] },
        "metadata": { "type": "object", "additionalProperties": true },
        "file_url": { "type": ["string", "null"] },
        "thumbnail_path": { "type": ["string", "null"], "maxLength": 512 },
        "thumbnail_url": { "type": ["string", "null"] },
        "blurhash": { "type": ["string", "null"], "maxLength": 64 },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "datasetPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "total", "limit", "offset"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/datasetSummary" }
        },
        "total": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
        "offset": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
      }
    },
    "datasetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset"],
      "properties": { "dataset": { "$ref": "#/$defs/datasetSummary" } }
    },
    "itemPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "items", "total", "limit", "offset"],
      "properties": {
        "dataset_id": { "$ref": "#/$defs/uuid" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/catalogItem" }
        },
        "total": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
        "offset": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
      }
    },
    "mutationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "actor_id", "dataset"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/uuid" },
        "actor_id": { "$ref": "#/$defs/uuid" },
        "dataset": { "$ref": "#/$defs/datasetSummary" }
      }
    },
    "successEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "data"],
      "properties": {
        "schema": { "const": "aap-assets-catalog/v1" },
        "ok": { "const": true },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/datasetPage" },
            { "$ref": "#/$defs/datasetResult" },
            { "$ref": "#/$defs/itemPage" },
            { "$ref": "#/$defs/mutationResult" }
          ]
        }
      }
    },
    "reply": {
      "oneOf": [{ "$ref": "#/$defs/successEnvelope" }, { "$ref": "#/$defs/failure" }]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "error"],
      "properties": {
        "schema": { "const": "aap-assets-catalog/v1" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "account_not_active",
                "account_busy",
                "invalid_account_role",
                "catalog_manager_required",
                "dataset_missing",
                "source_busy",
                "operation_conflict",
                "reserved_namespace"
              ],
              "type": "string"
            }
          }
        }
      }
    },
    "listDatasetsCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "arguments", "result"],
      "properties": {
        "function": {
          "const": "aap_assets_v1.list_catalog_datasets(uuid, text, text, boolean, integer, bigint)"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "p_actor_id",
            "p_search",
            "p_data_type",
            "p_has_scenes",
            "p_limit",
            "p_offset"
          ],
          "properties": {
            "p_actor_id": { "$ref": "#/$defs/uuid" },
            "p_search": { "type": ["string", "null"] },
            "p_data_type": { "type": ["string", "null"] },
            "p_has_scenes": { "type": ["boolean", "null"] },
            "p_limit": { "type": "integer", "minimum": 1, "maximum": 200 },
            "p_offset": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
          }
        },
        "result": { "$ref": "#/$defs/reply" }
      }
    },
    "getDatasetCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "arguments", "result"],
      "properties": {
        "function": {
          "const": "aap_assets_v1.get_catalog_dataset(uuid, uuid)"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p_actor_id", "p_dataset_id"],
          "properties": {
            "p_actor_id": { "$ref": "#/$defs/uuid" },
            "p_dataset_id": { "$ref": "#/$defs/uuid" }
          }
        },
        "result": { "$ref": "#/$defs/reply" }
      }
    },
    "listItemsCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "arguments", "result"],
      "properties": {
        "function": {
          "const": "aap_assets_v1.list_catalog_items(uuid, uuid, integer, bigint)"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p_actor_id", "p_dataset_id", "p_limit", "p_offset"],
          "properties": {
            "p_actor_id": { "$ref": "#/$defs/uuid" },
            "p_dataset_id": { "$ref": "#/$defs/uuid" },
            "p_limit": { "type": "integer", "minimum": 1, "maximum": 200 },
            "p_offset": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
          }
        },
        "result": { "$ref": "#/$defs/reply" }
      }
    },
    "createDatasetCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "arguments", "result"],
      "properties": {
        "function": { "const": "aap_assets_v1.create_catalog_dataset(uuid, uuid, jsonb)" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p_operation_id", "p_actor_id", "p_request"],
          "properties": {
            "p_operation_id": { "$ref": "#/$defs/uuid" },
            "p_actor_id": { "$ref": "#/$defs/uuid" },
            "p_request": { "$ref": "#/$defs/createDatasetRequest" }
          }
        },
        "result": { "$ref": "#/$defs/reply" }
      }
    },
    "createDatasetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "data_type", "is_temporal", "axis_convention"],
      "properties": {
        "name": { "type": "string", "maxLength": 255 },
        "description": { "type": "string" },
        "data_type": { "type": "string", "maxLength": 30 },
        "is_temporal": { "type": "boolean" },
        "axis_convention": { "$ref": "#/$defs/nullableAxisConvention" }
      }
    },
    "updateDatasetCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "arguments", "result"],
      "properties": {
        "function": { "const": "aap_assets_v1.update_catalog_dataset(uuid, uuid, uuid, jsonb)" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p_operation_id", "p_actor_id", "p_dataset_id", "p_patch"],
          "properties": {
            "p_operation_id": { "$ref": "#/$defs/uuid" },
            "p_actor_id": { "$ref": "#/$defs/uuid" },
            "p_dataset_id": { "$ref": "#/$defs/uuid" },
            "p_patch": { "$ref": "#/$defs/datasetPatch" }
          }
        },
        "result": { "$ref": "#/$defs/reply" }
      }
    },
    "datasetPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": ["string", "null"], "maxLength": 255 },
        "description": { "type": ["string", "null"] },
        "axis_convention": { "$ref": "#/$defs/nullableAxisConvention" }
      }
    }
  }
}
