{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aap-source-retention-v1.schema.json",
  "title": "Learning dataset source retention capability response",
  "oneOf": [{ "$ref": "#/$defs/success" }, { "$ref": "#/$defs/failure" }],
  "$defs": {
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "data"],
      "properties": {
        "schema": { "const": "aap-source-retention/v1" },
        "ok": { "const": true },
        "data": { "type": "object", "additionalProperties": false }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "error"],
      "properties": {
        "schema": { "const": "aap-source-retention/v1" },
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": ["invalid_request", "active_learning_reference"]
        }
      }
    }
  },
  "x-postgresql-functions": [
    "aap_learning_v1.guard_dataset_item_deletion(uuid, uuid)",
    "aap_learning_v1.guard_dataset_unlink(uuid, uuid)"
  ]
}
